      </div>

      <!-- ── Volume YoY Panel (issue #132) ── -->
      <div id="volume-yoy-panel" class="volume-yoy-panel" style="display:none">
        <div class="volume-yoy-header">
          <h3>📊 成交量年同比<span id="volume-yoy-district-label" class="volume-yoy-district-label"></span></h3>
          <div id="volume-yoy-badge" class="volume-yoy-badge" style="display:none"></div>
        </div>
        <p class="volume-yoy-desc">各季度成交量（本年 vs 去年）</p>
        <div id="volume-yoy-insufficient" class="volume-yoy-insufficient" style="display:none">資料不足</div>
        <div class="volume-yoy-chart-wrap">
          <canvas id="volume-yoy-chart" width="260" height="160" aria-label="季度成交量年同比條形圖"></canvas>

  // Legacy quarterly-trend event: just show the panel — title and chart are set by district-price-trend
  document.addEventListener("district-trend", (e: Event) => {
    const panel = document.getElementById("trend-panel") as HTMLDivElement | null;
    if (panel) panel.style.display = "block";

          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="under-800" checked />
            <span class="wizard-radio-text">💰 800萬以下</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="800-1500" />
            <span class="wizard-radio-text">💰 800萬 ~ 1,500萬</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="1500-2500" />
            <span class="wizard-radio-text">💰 1,500萬 ~ 2,500萬</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="over-2500" />
            <span class="wizard-radio-text">💰 2,500萬以上</span>
          </label>

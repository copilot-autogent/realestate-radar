  // ── Transit panel (MRT Proximity Score, issue #144) ─────────────────────────

  /** Cached last transit detail — used to re-render when toggle is enabled after a click. */
  let _lastTransitDetail: { district: string; city: string; proximity: any } | null = null;

  function renderTransitPanel(district: string, city: string, proximity: any): void {
    const panel = document.getElementById("transit-panel") as HTMLDivElement | null;
    const labelEl = document.getElementById("transit-panel-label") as HTMLSpanElement | null;
    const bodyEl = document.getElementById("transit-panel-body") as HTMLDivElement | null;
    if (!panel || !bodyEl) return;

    panel.style.display = "block";
    if (labelEl) {
      const prefix = city ? `${city} ` : "";
      labelEl.textContent = district ? ` — ${prefix}${district}` : "";
    }

    if (!proximity || proximity.noMrt) {
      bodyEl.innerHTML = `<p class="transit-no-mrt">此地區無捷運站資料（或資料尚未載入）。</p>`;
      return;
    }

    const tierLabels: Record<string, string> = {
      walking: "步行圈",
      nearby:  "生活圈",
      driving: "需搭車",
      remote:  "偏遠",
    };
    const tierEmojis: Record<string, string> = {
      walking: "🟢",
      nearby:  "🟡",
      driving: "🟠",
      remote:  "🔴",
    };

    const tier = proximity.tier;
    const emoji = tierEmojis[tier] ?? "";
    const tierLabel = tierLabels[tier] ?? tier;
    const tierCls = `transit-tier-${tier}`;
    const distM = Math.round(proximity.distanceKm * 1000);
    const distStr = distM >= 1000 ? `${(distM / 1000).toFixed(2)} km` : `${distM} m`;
    const stationName = proximity.nearestStation?.name ?? "—";
    const lineName = proximity.nearestStation?.lineZh ?? "—";
    const walkText = proximity.walkMinutes !== null ? `走路約 ${proximity.walkMinutes} 分鐘` : "—";

    bodyEl.innerHTML = `
      <div class="transit-tier-row">
        <span class="transit-tier-badge ${tierCls}">${emoji} ${tierLabel}</span>
      </div>
      <div class="transit-detail-row">
        <span class="transit-detail-label">最近捷運站</span>
        <span class="transit-detail-value">${stationName}</span>
      </div>
      <div class="transit-detail-row">
        <span class="transit-detail-label">路線</span>
        <span class="transit-detail-value">${lineName}</span>
      </div>
      <div class="transit-detail-row">
        <span class="transit-detail-label">直線距離</span>
        <span class="transit-detail-value">${distStr}</span>
      </div>
      <div class="transit-detail-row">
        <span class="transit-detail-label">步行時間</span>
        <span class="transit-detail-value">${walkText}</span>
      </div>`;
  }

  document.addEventListener("district-transit", (e: Event) => {
    const { district, city, proximity } = (e as CustomEvent).detail as {
      district: string;
      city: string;
      proximity: {
        nearestStation: { name: string; lineZh: string } | null;
        distanceKm: number;
        tier: string;
        walkMinutes: number | null;
        noMrt: boolean;
      } | null;

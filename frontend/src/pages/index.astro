  // ── Similar district recommender panel (issue #141) ─────────────────────────────────────
  let _lastSimilarEventDetail: { district: string; city: string; allProfiles: any[] } | null = null;
  let _similarRenderSeq = 0; // stale-event guard for async re-computes

  /** HTML-escape helper to prevent XSS when interpolating district/city names into innerHTML. */
  function escSimilar(s: string): string {
    return String(s).replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"})[c]!);
  }

  function renderSimilarDistrictsPanel(detail: { district: string; city: string; result: { candidates: any[]; insufficient: boolean } }) {
    const panel       = document.getElementById("similar-districts-panel")  as HTMLDivElement  | null;
    const labelEl     = document.getElementById("similar-districts-label")  as HTMLSpanElement | null;
    const insuffEl    = document.getElementById("similar-districts-insufficient") as HTMLDivElement | null;
    const listEl      = document.getElementById("similar-districts-list")   as HTMLUListElement | null;
    if (!panel || !listEl) return;

    panel.style.display = "block";
    if (labelEl) {
      const cityPrefix = detail.city ? `${detail.city} ` : "";
      labelEl.textContent = detail.district ? ` — ${cityPrefix}${detail.district}` : "";
    }

    const { candidates, insufficient } = detail.result;

    // Show 資料不足 whenever < 3 qualifying candidates were found
    if (insuffEl) insuffEl.style.display = insufficient ? "block" : "none";

    if (!candidates || candidates.length === 0) {
      listEl.innerHTML = "";
      return;
    }

    const tierEmoji = (tier: number) => {
      if (tier === 0) return "🟢";
      if (tier === 1) return "🟡";
      if (tier === 2) return "🔴";
      return "";
    };

    listEl.innerHTML = candidates.map((c: any) => {
      const priceWan = (c.medianPricePing / 10_000).toFixed(1);
      const scoreHtml = c.buyerTimingScore !== null
        ? `<span class="similar-district-score">買時 ${c.buyerTimingScore}</span>`
        : "";
      const tierHtml = c.firstBuyerTier >= 0 ? `<span title="首購族負擔等級">${tierEmoji(c.firstBuyerTier)}</span>` : "";
      const safeDist = escSimilar(c.district);
      const safeCity = escSimilar(c.city);
      return `<li class="similar-district-item">
        <div class="similar-district-header">
          <span>
            <span class="similar-district-name">${safeDist}</span>
            <span class="similar-district-city">${safeCity}</span>
          </span>
          <span class="similar-district-discount">省 ${c.discountPct}%</span>
        </div>
        <div class="similar-district-meta">
          <span class="similar-district-price">${priceWan} 萬/坪</span>
          ${scoreHtml}
          ${tierHtml}
          <button class="similar-district-focus-btn" data-district="${safeDist}" data-city="${safeCity}" aria-label="在地圖上查看 ${safeDist}">查看</button>
        </div>
      </li>`;
    }).join("");

    // Wire "查看" buttons to highlight the alternative district on the map
    listEl.querySelectorAll(".similar-district-focus-btn").forEach((btn) => {
      (btn as HTMLButtonElement).addEventListener("click", () => {
        const d = (btn as HTMLButtonElement).dataset.district ?? "";
        const c = (btn as HTMLButtonElement).dataset.city ?? "";
        document.dispatchEvent(new CustomEvent("district-focus", { detail: { district: d, city: c } }));
      });
    });
  }

  document.addEventListener("district-similar", async (e: Event) => {
    const seq = ++_similarRenderSeq;
    const raw = (e as CustomEvent).detail as {
      district: string;
      city: string;
      result: { candidates: any[]; insufficient: boolean };
      allProfiles: any[];
    };
    // Store profiles so the city-toggle can re-compute without a new click
    _lastSimilarEventDetail = { district: raw.district, city: raw.city, allProfiles: raw.allProfiles };
    // Honour the current sameCityOnly toggle state when re-rendering
    const toggle = document.getElementById("similar-districts-same-city") as HTMLInputElement | null;
    const sameCityOnly = toggle?.checked ?? false;
    if (sameCityOnly && raw.allProfiles?.length) {
      try {
        const { computeSimilarDistricts: csd } = await import("../lib/similarDistrictUtils.js");
        if (seq !== _similarRenderSeq) return; // superseded by newer click
        const result = csd(raw.district, raw.city, raw.allProfiles, { sameCityOnly: true });
        renderSimilarDistrictsPanel({ district: raw.district, city: raw.city, result });
      } catch {
        // Dynamic import failed — render pre-computed cross-city result rather than nothing,
        // but only if this event is still current (seq guard).
        if (seq === _similarRenderSeq) renderSimilarDistrictsPanel(raw);
      }
    } else {
      if (seq === _similarRenderSeq) renderSimilarDistrictsPanel(raw);
    }
  });

  // Re-render panel when same-city toggle changes (re-compute from stored profiles)
  document.getElementById("similar-districts-same-city")?.addEventListener("change", async () => {
    if (!_lastSimilarEventDetail) return;
    const seq = ++_similarRenderSeq;
    const { district, city, allProfiles } = _lastSimilarEventDetail;
    const toggle = document.getElementById("similar-districts-same-city") as HTMLInputElement | null;
    const sameCityOnly = toggle?.checked ?? false;
    try {
      const { computeSimilarDistricts: csd } = await import("../lib/similarDistrictUtils.js");
      if (seq !== _similarRenderSeq) return; // superseded by rapid toggle
      const result = csd(district, city, allProfiles, { sameCityOnly });
      renderSimilarDistrictsPanel({ district, city, result });
    } catch { /* import failure: leave panel as-is */ }
  });

  // ── Smart Alternatives panel (issue #163) ──────────────────────────────────

  /** HTML-escape helper for alternatives panel (prevents XSS). */
  function escAlt(s: string): string {
    return String(s).replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"})[c]!);
  }

  const MRT_TIER_LABELS_ALT: Record<string, string> = {
    walking: "🟢 步行圈",
    nearby:  "🟡 生活圈",
    driving: "🟠 需搭車",
    remote:  "🔴 偏遠",
  };

  /** Stale-event guard: incremented on each district-similar event; async renders check this. */
  let _altRenderSeq = 0;

  async function renderSmartAlternatives(seq: number, district: string, city: string, allProfiles: any[], mrtTierMap: Record<string, { tier: string; noMrt: boolean }>): Promise<void> {
    const emptyEl   = document.getElementById("smart-alt-empty")        as HTMLDivElement | null;
    const contentEl = document.getElementById("smart-alt-content")      as HTMLDivElement | null;
    const labelEl   = document.getElementById("smart-alt-label")        as HTMLSpanElement | null;
    const insuffEl  = document.getElementById("smart-alt-insufficient") as HTMLDivElement | null;
    const listEl    = document.getElementById("smart-alt-list")         as HTMLUListElement | null;
    if (!emptyEl || !contentEl || !listEl) return;

    if (!district) {
      // No district selected — show helpful empty state
      emptyEl.style.display   = "flex";
      contentEl.style.display = "none";
      return;
    }

    emptyEl.style.display   = "none";
    contentEl.style.display = "block";

    if (labelEl) {
      const prefix = city ? `${city} ` : "";
      labelEl.textContent = district ? ` — ${prefix}${district}` : "";
    }
    // Clear stale results immediately so old data never shows under a new label
    if (insuffEl) insuffEl.style.display = "none";
    listEl.innerHTML = "";

    // Use the pure utility (same code path as tests → no drift between tests and production)
    let computeAlternatives: typeof import("../lib/alternativesUtils.js").computeAlternatives;
    try {
      ({ computeAlternatives } = await import("../lib/alternativesUtils.js"));
    } catch {
      // Dynamic import failed — restore empty state
      emptyEl.style.display   = "flex";
      contentEl.style.display = "none";
      return;
    }
    // Guard: a newer district click superseded this one while we awaited the import
    if (seq !== _altRenderSeq) return;

    const { candidates, targetInsufficient } = computeAlternatives(
      district,
      city,
      allProfiles as Parameters<typeof computeAlternatives>[2],
      mrtTierMap as Parameters<typeof computeAlternatives>[3],
    );

    if (insuffEl) {
      if (targetInsufficient) {
        insuffEl.textContent = "目前選定地區缺乏足夠成交資料";
        insuffEl.style.display = "block";
      } else if (candidates.length === 0) {
        insuffEl.textContent = "同縣市無更便宜的替代地區資料";
        insuffEl.style.display = "block";
      } else {
        insuffEl.style.display = "none";
      }
    }

    listEl.innerHTML = candidates.map((c) => {
      const priceWan = (c.medianPricePing / 10_000).toFixed(1);
      const safeDist = escAlt(c.district);
      const safeCity = escAlt(c.city);
      let mrtHtml = "";
      if (c.mrtTier && !c.noMrtCoverage) {
        const mrtLabel = MRT_TIER_LABELS_ALT[c.mrtTier] ?? c.mrtTier;
        const tierCls  = `smart-alt-mrt-${c.mrtTier}`;
        mrtHtml = `<span class="smart-alt-mrt-badge ${tierCls}" title="捷運距離">${escAlt(mrtLabel)}</span>`;
      } else if (c.noMrtCoverage) {
        mrtHtml = `<span class="smart-alt-mrt-badge smart-alt-mrt-none" title="無捷運">無捷運</span>`;
      }
      return `<li class="smart-alt-item">
        <div class="smart-alt-row-top">
          <span class="smart-alt-name">${safeDist}</span>
          <span class="smart-alt-delta">省 ${c.priceDeltaPct.toFixed(1)}%</span>
        </div>
        <div class="smart-alt-row-bottom">
          <span class="smart-alt-price">${priceWan} 萬/坪</span>
          ${mrtHtml}
          <button class="smart-alt-focus-btn" data-district="${safeDist}" data-city="${safeCity}" aria-label="在地圖上查看 ${safeDist}">查看</button>
        </div>
      </li>`;
    }).join("");

    // Wire focus buttons
    listEl.querySelectorAll(".smart-alt-focus-btn").forEach((btn) => {
      (btn as HTMLButtonElement).addEventListener("click", () => {
        const d = (btn as HTMLButtonElement).dataset.district ?? "";
        const c = (btn as HTMLButtonElement).dataset.city ?? "";
        document.dispatchEvent(new CustomEvent("district-focus", { detail: { district: d, city: c } }));
      });
    });
  }


      <!-- Results -->
      <div id="wizard-results" class="wizard-step" hidden aria-label="配對結果">
        <h2 class="wizard-step-title">🏘 配對結果</h2>
        <p id="wizard-results-subtitle" class="wizard-step-subtitle"></p>
        <div id="wizard-relax-hint" class="wizard-relax-hint" hidden>
          😔 符合條件的行政區不足 3 個，建議放寬預算或通勤時間。
        </div>
        <div id="wizard-match-cards" class="wizard-match-cards"></div>
        <div class="wizard-nav" style="margin-top:20px">
          <button id="wizard-restart-btn" class="wizard-back-btn">🔄 重新配對</button>
          <button id="wizard-done-btn" class="wizard-next-btn">完成 ✓</button>
        </div>

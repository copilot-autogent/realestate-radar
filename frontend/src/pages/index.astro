<script>
  import { computeYTDSummary, formatYoYPct } from "../lib/volumeTrendUtils.js";

  // Dynamically load Chart.js when first needed (CDN, no npm dep)
  // jsDelivr +esm transforms the auto entry to a valid ESM module
  let Chart: any = null;
  let trendChartInstance: any = null;
  let volumeYoYRenderSeq = 0;  // stale-event guard for volume-yoy panel
  async function ensureChart() {
    if (Chart) return;
    // @ts-ignore — CDN ESM import, no type declarations needed
    const mod = await import("https://cdn.jsdelivr.net/npm/chart.js@4.4.0/auto/+esm");
    Chart = mod.default;
  }

  // ── Monthly price-per-ping trend chart (issue #131) ───────────────────────
  // Stores latest trend data so the 每坪/總價 toggle can re-render without a new event.
  let _lastPriceTrend: any = null;
  let _priceTrendMode: "perPing" | "total" = "perPing";
  let _priceTrendSeq = 0; // stale-render guard

  async function renderPriceTrendChart(): Promise<void> {
    const seq = ++_priceTrendSeq;
    const trend = _lastPriceTrend;
    const mode = _priceTrendMode; // capture before any await
    if (!trend) return;

    await ensureChart();
    if (seq !== _priceTrendSeq) return; // superseded by a later call

    const canvas      = document.getElementById("trend-chart")      as HTMLCanvasElement | null;
    const insuffEl    = document.getElementById("trend-insufficient") as HTMLElement | null;
    const noteEl      = document.getElementById("trend-note")         as HTMLElement | null;
    const yoyEl       = document.getElementById("trend-yoy")          as HTMLElement | null;

    if (!canvas) return;

    const { points, ma3, ma3Total, yoyPercentage, yoyTotalPercentage, sufficient } = trend;

    if (!sufficient || points.length < 6) {
      canvas.style.display = "none";
      if (insuffEl) insuffEl.style.display = "block";
      if (noteEl)   noteEl.textContent = "";
      if (yoyEl) { yoyEl.style.display = "none"; yoyEl.textContent = ""; }
      if (trendChartInstance) { trendChartInstance.destroy(); trendChartInstance = null; }
      return;
    }

    if (insuffEl) insuffEl.style.display = "none";
    canvas.style.display = "block";

    const isPerPing = mode === "perPing";
    const labels: string[] = points.map((pt: any) => pt.month);

    // Primary series: medianPerPing in 萬/坪 or medianTotalWan in 萬 (null → skip)
    const primaryData: (number | null)[] = points.map((pt: any) => {
      if (isPerPing) return Math.round(pt.medianPerPing / 10000);
      return pt.medianTotalWan !== null ? Math.round(pt.medianTotalWan) : null;
    });

    // MA3 series — use pre-computed ma3/ma3Total from priceTrendUtils (no duplicated logic)
    const ma3Data: (number | null)[] = isPerPing
      ? ma3.map((v: number | null) => (v === null ? null : Math.round(v / 10000)))
      : (ma3Total as (number | null)[]).map((v: number | null) =>
          v === null ? null : Math.round(v)
        );

    const unit = isPerPing ? "萬/坪" : "萬";
    // Active YoY: use the mode-matching field so the annotation is always consistent
    const activeYoY: number | null = isPerPing ? yoyPercentage : yoyTotalPercentage;

    if (trendChartInstance) {
      trendChartInstance.destroy();
      trendChartInstance = null;
    }

    // On mobile, make chart scrollable by using a wider virtual width
    const isMobile = window.innerWidth <= 480;
    if (isMobile) {
      canvas.style.width  = `${Math.max(260, labels.length * 22)}px`;
      canvas.width        = Math.max(260, labels.length * 22);
      canvas.style.height = "140px";
      canvas.height       = 140;
    } else {
      canvas.style.width  = "260px";
      canvas.width        = 260;
      canvas.style.height = "160px";
      canvas.height       = 160;
    }

    // Highlight last non-null point
    const lastNonNullIdx = primaryData.reduceRight((acc: number, v, i) => (acc === -1 && v !== null ? i : acc), -1);
    const pointRadius = primaryData.map((_: any, i: number) => (i === lastNonNullIdx ? 6 : 3));
    const pointBgColor = primaryData.map((_: any, i: number) => (i === lastNonNullIdx ? "#ef4444" : "#2563eb"));

    trendChartInstance = new Chart(canvas, {
      type: "line",
      data: {
        labels,
        datasets: [
          {
            label: `中位數${isPerPing ? "單價" : "總價"} (${unit})`,
            data: primaryData,
            borderColor: "#2563eb",
            backgroundColor: "rgba(37,99,235,0.08)",
            tension: 0.3,
            pointRadius,
            pointBackgroundColor: pointBgColor,
            fill: true,
            order: 1,
            spanGaps: false,
          },
          {
            label: `MA3 (${unit})`,
            data: ma3Data,
            borderColor: "#f59e0b",
            borderWidth: 2,
            borderDash: [4, 4],
            pointRadius: 0,
            fill: false,
            tension: 0.3,
            order: 0,
            spanGaps: false,
          },
        ],
      },
      options: {
        responsive: false,
        plugins: {
          legend: {
            display: true,
            position: "top" as const,
            labels: { font: { size: 10 }, boxWidth: 20, padding: 6 },
          },
          tooltip: {
            callbacks: {
              label: (ctx: any) => {
                if (ctx.parsed.y === null || ctx.parsed.y === undefined) return "";
                return `${ctx.dataset.label}: ${ctx.parsed.y} ${unit}`;
              },
            },
          },
        },
        scales: {
          y: {
            beginAtZero: false,
            ticks: {
              callback: (v: any) => `${v}萬`,
              font: { size: 10 },
            },
          },
          x: {
            ticks: { font: { size: 10 }, maxRotation: 45 },
          },
        },
      },
    });

    if (noteEl) {
      noteEl.textContent = `月均${isPerPing ? "單價" : "總價"}走勢（共 ${points.length} 個月，含 MA3）`;
    }

    // YoY annotation — always reflects the currently-displayed mode
    if (yoyEl && activeYoY !== null) {
      const sign = activeYoY > 0 ? "+" : "";
      yoyEl.textContent = `同期比 ${sign}${activeYoY.toFixed(1)}%`;
      yoyEl.className = `trend-yoy ${activeYoY > 1 ? "positive" : activeYoY < -1 ? "negative" : "neutral"}`;
      yoyEl.style.display = "block";
    } else if (yoyEl) {
      yoyEl.style.display = "none";
    }
  }

  document.addEventListener("district-volume-yoy", async (e: Event) => {
    const seq = ++volumeYoYRenderSeq;
    const { district, referenceYear, volumeYoY } = (e as CustomEvent).detail as {
      district: string;
      referenceYear: number;
      volumeYoY: Array<{
        quarter: string;
        currentYear: number;
        priorYear: number;
        yoyPct: number | null;
        insufficientCurrent: boolean;
        insufficientPrior: boolean;
      }>;

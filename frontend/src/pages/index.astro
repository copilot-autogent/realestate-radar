    // Cache for re-render when toggle is enabled after a click
    _lastTransitDetail = { district, city, proximity };

    // Only show panel when the MRT tier overlay toggle is active
    const tierToggle = document.getElementById("mrt-tier-toggle") as HTMLInputElement | null;

  // ---- 青安貸款換約提醒 banner ----
  (function initQinganBanner(): void {
    // Use local-timezone construction (avoids UTC-parse skew with ISO string)
    const DEADLINE = new Date(2026, 6, 1); // July 1, 2026 local time
    const DISMISS_KEY = "qingan_banner_dismissed";
    const WINDOW_DAYS = 60;

    const banner = document.getElementById("qingan-banner");
    if (!banner) return;

    const now = new Date();
    const msLeft = DEADLINE.getTime() - now.getTime();
    const daysLeft = msLeft / (1000 * 60 * 60 * 24);

    // Show when within the 60-day window (inclusive of day 60); hide on/after July 1 2026
    if (daysLeft <= 0 || daysLeft > WINDOW_DAYS) return;

    let dismissed = false;
    try { dismissed = localStorage.getItem(DISMISS_KEY) === "true"; } catch { /* storage blocked */ }
    if (dismissed) return;

    banner.style.display = "block";

    document.getElementById("qingan-dismiss")?.addEventListener("click", () => {
      banner.style.display = "none";
      try { localStorage.setItem(DISMISS_KEY, "true"); } catch { /* storage blocked */ }
    });

    // Smooth-scroll the mortgage calculator into view when the CTA link is clicked;
    // fall back to default anchor navigation if the target element is missing.
    // Also auto-opens the 青安利率影響試算 panel so the user lands on it directly.
    banner.querySelector<HTMLAnchorElement>(".qingan-cta")?.addEventListener("click", (e) => {
      const target = document.getElementById("mortgage-calculator");
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        // Auto-open the comparison panel if not already open
        const comparePanel = document.getElementById("qingan-compare-panel") as HTMLDivElement | null;
        const compareToggle = document.getElementById("qingan-compare-toggle") as HTMLButtonElement | null;
        if (comparePanel && comparePanel.style.display === "none") {
          comparePanel.style.display = "block";
          comparePanel.setAttribute("aria-hidden", "false");
          compareToggle?.setAttribute("aria-expanded", "true");
          // trigger recalculation
          comparePanel.dispatchEvent(new CustomEvent("qingan-open"));
        }
      }
    });
  })();

  // ── Completion Wave Chart ──────────────────────────────────────────────────
  // Loads frontend/public/data/permits.json and renders a stacked bar chart
  // (quarterly 使照 completions) using Chart.js.  The "📦 完工供給強度" checkbox
  // also dispatches a completion-mode-change event to Map.astro.

  const BASE_URL_CWC = (import.meta as any).env?.BASE_URL ?? "/realestate-radar/";

  const CITY_COLORS: Record<string, string> = {
    "台北市": "#1d4ed8",
    "新北市": "#0891b2",
    "桃園市": "#16a34a",
    "台中市": "#ca8a04",
    "台南市": "#ea580c",
    "高雄市": "#dc2626",
  };

  let permitsData: {
    quarters: string[];
    first_projected_quarter: string;
    cities: Record<string, { building_permits: number[]; occupancy_permits: number[]; starts: number[] }>;
  } | null = null;

  let completionChartInstance: any = null;

  /** In-flight fetch promise to avoid duplicate concurrent requests. */
  let _permitsLoadPromise: Promise<typeof permitsData> | null = null;

  async function loadPermitsData(): Promise<typeof permitsData> {
    if (permitsData) return permitsData;
    if (_permitsLoadPromise) return _permitsLoadPromise;
    _permitsLoadPromise = (async () => {
      try {
        const url = BASE_URL_CWC.replace(/\/$/, "") + "/data/permits.json";
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        permitsData = await res.json();
      } catch (err) {
        console.warn("[completion-wave] failed to load permits.json:", err);
        permitsData = null;
      } finally {
        _permitsLoadPromise = null;
      }
      return permitsData;
    })();
    return _permitsLoadPromise;
  }

  async function renderCompletionWaveChart(selectedCity: string): Promise<void> {
    const data = await loadPermitsData();
    if (!data) return;

    await ensureChart(); // reuse the existing Chart.js loader

    const canvas = document.getElementById("completion-wave-chart") as HTMLCanvasElement | null;
    if (!canvas) return;

    if (completionChartInstance) {
      completionChartInstance.destroy();
      completionChartInstance = null;
    }

    const { quarters, first_projected_quarter, cities } = data;
    // Guard against first_projected_quarter not found in quarters array
    const projIdx = quarters.indexOf(first_projected_quarter);
    const safeProjIdx = projIdx >= 0 ? projIdx : quarters.length; // fallback: no projection

    let datasets: any[];
    const labels = quarters;

    if (selectedCity !== "all") {
      // Single city — single stack, two datasets for color split at projection boundary
      const cityData = cities[selectedCity];
      if (!cityData) return;
      const color = CITY_COLORS[selectedCity] ?? "#6366f1";

      datasets = [
        {
          label: `${selectedCity} 使照（實績）`,
          data: cityData.occupancy_permits.map((v, i) => (i < safeProjIdx ? v : null)),
          backgroundColor: color,
          borderColor: "transparent",
          stack: "op",
        },
        {
          label: `${selectedCity} 使照（預測）`,
          data: cityData.occupancy_permits.map((v, i) => (i >= safeProjIdx ? v : null)),
          backgroundColor: color + "66",
          borderColor: "transparent",
          stack: "op",
        },
      ];
    } else {
      // All cities — single stack per city, two datasets per city for color split
      const cityList = Object.keys(cities);
      datasets = cityList.flatMap((city) => {
        const color = CITY_COLORS[city] ?? "#6366f1";
        const op = cities[city].occupancy_permits;
        return [
          {
            label: `${city}（實績）`,
            data: op.map((v, i) => (i < safeProjIdx ? v : null)),
            backgroundColor: color,
            borderColor: "transparent",
            // All cities share the same stack key so they stack on top of each other
            stack: "all",
          },
          {
            label: `${city}（預測）`,
            data: op.map((v, i) => (i >= safeProjIdx ? v : null)),
            backgroundColor: color + "55",
            borderColor: "transparent",
            stack: "all",
          },
        ];
      });
    }

    // Show one label per year (every 4th quarter)
    const displayLabels = labels.map((q, i) => (i % 4 === 0 ? q : ""));

    completionChartInstance = new Chart(canvas, {
      type: "bar",
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 300 },
        plugins: {
          legend: {
            display: selectedCity === "all",
            position: "bottom" as const,
            labels: {
              font: { size: 9 },
              boxWidth: 10,
              padding: 6,
              // Show only the city name (first dataset per city), not "（預測）" duplicates
              filter: (item: any) => !item.text.includes("（預測）"),
            },
          },
          tooltip: {
            callbacks: {
              label: (ctx: any) => `${ctx.dataset.label}: ${ctx.parsed.y?.toLocaleString() ?? "–"} 宅`,
            },
          },
        },
        scales: {
          x: {
            stacked: true,
            ticks: {
              font: { size: 8 },
              maxRotation: 45,
              callback: (_val: any, i: number) => displayLabels[i],
            },
            grid: { display: false },
          },
          y: {
            stacked: true,
            ticks: {
              font: { size: 8 },
              callback: (v: any) => (v >= 1000 ? `${(v / 1000).toFixed(0)}K` : v),
            },
            title: {
              display: true,
              text: "使照核發數（宅）",
              font: { size: 8 },
              color: "#64748b",
            },
          },
        },
      },
      plugins: [
        {
          id: "projection-shading",
          beforeDraw(chart: any) {
            if (safeProjIdx <= 0 || safeProjIdx >= labels.length) return;
            const { ctx, chartArea, scales } = chart;
            if (!chartArea || !scales.x) return;
            // Use integer tick index to get pixel for left edge of the projection bar
            const x = scales.x.getPixelForValue(safeProjIdx - 0.5);
            ctx.save();
            ctx.fillStyle = "rgba(250,204,21,0.08)";
            ctx.fillRect(x, chartArea.top, chartArea.right - x, chartArea.bottom - chartArea.top);
            ctx.strokeStyle = "#eab308";
            ctx.lineWidth = 1;
            ctx.setLineDash([4, 3]);
            ctx.beginPath();
            ctx.moveTo(x, chartArea.top);
            ctx.lineTo(x, chartArea.bottom);
            ctx.stroke();
            ctx.setLineDash([]);
            ctx.font = "bold 8px sans-serif";
            ctx.fillStyle = "#92400e";
            ctx.fillText("預測 →", x + 3, chartArea.top + 10);
            ctx.restore();
          },
        },
      ],
    });
  }

  // Initial render (all cities)
  (async () => {
    await renderCompletionWaveChart("all");
  })();

  document.getElementById("completion-city-select")?.addEventListener("change", async (e) => {
    const city = (e.target as HTMLSelectElement).value;
    await renderCompletionWaveChart(city);
  });

  // ── Completion overlay toggle → dispatch to Map.astro ──────────────────────
  const completionOverlayToggle = document.getElementById("completion-overlay-toggle") as HTMLInputElement | null;

  async function updateCompletionOverlay(): Promise<void> {
    const enabled = completionOverlayToggle?.checked ?? false;

    if (enabled) {
      // Ensure choropleth districts are visible BEFORE dispatching, so Map.astro's
      // guard on districts-fill layer doesn't bail out on the first click
      const choroplethToggle = document.getElementById("choropleth-toggle") as HTMLInputElement | null;
      if (choroplethToggle && !choroplethToggle.checked) {
        choroplethToggle.checked = true;
        choroplethToggle.dispatchEvent(new Event("change"));
      }

      const data = await loadPermitsData();
      if (!data) {
        // Revert toggle on load failure
        if (completionOverlayToggle) completionOverlayToggle.checked = false;
        return;
      }
      document.dispatchEvent(new CustomEvent("completion-mode-change", {
        detail: { enabled: true, permitsData: data },
      }));
    } else {
      document.dispatchEvent(new CustomEvent("completion-mode-change", {
        detail: { enabled: false, permitsData: null },
      }));
    }
  }

  completionOverlayToggle?.addEventListener("change", updateCompletionOverlay);

  // Re-fire completion overlay when city changes (so district allocation stays fresh)
  document.getElementById("city-select")?.addEventListener("change", async () => {
    if (completionOverlayToggle?.checked) {
      await updateCompletionOverlay();
    }
  });

  // ── Supply pressure overlay toggle → dispatch to Map.astro ─────────────────
  const supplyPressureToggle = document.getElementById("supply-pressure-toggle") as HTMLInputElement | null;

  async function updateSupplyPressureOverlay(): Promise<void> {
    const enabled = supplyPressureToggle?.checked ?? false;
    if (enabled) {
      const choroplethToggle = document.getElementById("choropleth-toggle") as HTMLInputElement | null;
      if (choroplethToggle && !choroplethToggle.checked) {
        choroplethToggle.checked = true;
        choroplethToggle.dispatchEvent(new Event("change"));
      }
      const data = await loadPermitsData();
      // Re-check after await in case user toggled off during fetch, or fetch failed
      if (!data) {
        if (supplyPressureToggle) supplyPressureToggle.checked = false;
        // Dispatch disable to clear any partially active state
        document.dispatchEvent(new CustomEvent("supply-pressure-mode-change", {
          detail: { enabled: false, permitsData: null },
        }));
        return;
      }
      if (!(supplyPressureToggle?.checked ?? false)) {
        // User unchecked while we were fetching — abort silently
        return;
      }
      document.dispatchEvent(new CustomEvent("supply-pressure-mode-change", {
        detail: { enabled: true, permitsData: data },
      }));
    } else {
      document.dispatchEvent(new CustomEvent("supply-pressure-mode-change", {
        detail: { enabled: false, permitsData: null },
      }));
    }
  }

  supplyPressureToggle?.addEventListener("change", updateSupplyPressureOverlay);

  // Re-fire supply pressure when city changes (district allocation is city-scoped)
  document.getElementById("city-select")?.addEventListener("change", async () => {
    if (supplyPressureToggle?.checked) {
      await updateSupplyPressureOverlay();
    }
  });

  // ── Buyer timing score toggle → dispatch to Map.astro ───────────────────────
  const buyerScoreToggle = document.getElementById("buyer-score-toggle") as HTMLInputElement | null;

  function updateBuyerScoreOverlay(): void {
    const enabled = buyerScoreToggle?.checked ?? false;
    // Map.astro's buyer-score-mode-change handler enables choropleth districts itself;
    // no need to fire choropleth change event here (avoids a DEFAULT_FILL_COLOR flash)
    document.dispatchEvent(new CustomEvent("buyer-score-mode-change", {
      detail: { enabled },
    }));
  }

  buyerScoreToggle?.addEventListener("change", updateBuyerScoreOverlay);

  // ── Volatility overlay toggle → dispatch to Map.astro ──────────────────────
  const volatilityToggle = document.getElementById("volatility-toggle") as HTMLInputElement | null;

  function updateVolatilityOverlay(): void {
    const enabled = volatilityToggle?.checked ?? false;
    document.dispatchEvent(new CustomEvent("volatility-mode-change", {
      detail: { enabled },
    }));
  }

  volatilityToggle?.addEventListener("change", updateVolatilityOverlay);

  // ── MRT premium overlay toggle → dispatch to Map.astro ─────────────────────
  const mrtPremiumToggle = document.getElementById("mrt-premium-toggle") as HTMLInputElement | null;

  function updateMrtPremiumOverlay(): void {
    const enabled = mrtPremiumToggle?.checked ?? false;
    document.dispatchEvent(new CustomEvent("mrt-premium-mode-change", {
      detail: { enabled },
    }));
  }

  mrtPremiumToggle?.addEventListener("change", updateMrtPremiumOverlay);

  // ── Pre-sale spread overlay toggle → dispatch to Map.astro ─────────────────────
  const presaleSpreadToggle = document.getElementById("presale-spread-toggle") as HTMLInputElement | null;

  function updatePresaleSpreadOverlay(): void {
    const enabled = presaleSpreadToggle?.checked ?? false;
    document.dispatchEvent(new CustomEvent("presale-spread-mode-change", {
      detail: { enabled },
    }));
  }

  presaleSpreadToggle?.addEventListener("change", updatePresaleSpreadOverlay);

  // ── First-buyer affordability heat-map overlay (issue #133) ────────────────

  import { DOWN_PAYMENT_RATIO, INCOME_MULTIPLIER } from "../lib/affordabilityUtils.js";

  const fbOverlayToggle   = document.getElementById("affordability-overlay") as HTMLInputElement | null;
  const fbPanel           = document.getElementById("first-buyer-panel")     as HTMLDivElement | null;
  const fbMonthlyIncome   = document.getElementById("fb-monthly-income")     as HTMLInputElement | null;
  const fbDownPayment     = document.getElementById("fb-down-payment")       as HTMLInputElement | null;
  const fbResult          = document.getElementById("fb-result")             as HTMLDivElement | null;
  const fbMaxAffordable   = document.getElementById("fb-max-affordable")     as HTMLElement | null;
  const fbResetBtn        = document.getElementById("fb-reset-btn")          as HTMLButtonElement | null;

  // Show/hide panel when toggle changes
  fbOverlayToggle?.addEventListener("change", () => {
    if (fbPanel) fbPanel.style.display = fbOverlayToggle.checked ? "block" : "none";
    dispatchFirstBuyerOverlay();
  });

  function dispatchFirstBuyerOverlay(): void {
    const enabled = fbOverlayToggle?.checked ?? false;
    const incomeWan  = parseFloat(fbMonthlyIncome?.value ?? "");
    const dpWan      = parseFloat(fbDownPayment?.value   ?? "");
    const validInputs = enabled && Number.isFinite(incomeWan) && incomeWan > 0 &&
                        Number.isFinite(dpWan) && dpWan > 0;

    if (validInputs) {
      const monthlyIncomeNTD = incomeWan * 10_000;
      const downPaymentNTD   = dpWan    * 10_000;
      // Compute max-affordable using shared constants (consistent with map tiers)
      const maxByDP          = downPaymentNTD   / DOWN_PAYMENT_RATIO;
      const maxByIncome      = monthlyIncomeNTD * 12 * INCOME_MULTIPLIER;
      const maxAffordableWan = Math.min(maxByDP, maxByIncome) / 10_000;
      if (fbMaxAffordable) fbMaxAffordable.textContent = maxAffordableWan.toFixed(0);
      if (fbResult) fbResult.style.display = "block";
      document.dispatchEvent(new CustomEvent("first-buyer-overlay-change", {
        detail: { enabled: true, monthlyIncomeNTD, downPaymentNTD },
      }));
    } else {
      if (fbResult) fbResult.style.display = "none";
      document.dispatchEvent(new CustomEvent("first-buyer-overlay-change", {
        detail: { enabled: false },
      }));
    }
  }

  fbMonthlyIncome?.addEventListener("input", () => { if (fbOverlayToggle?.checked) dispatchFirstBuyerOverlay(); });
  fbDownPayment?.addEventListener("input",   () => { if (fbOverlayToggle?.checked) dispatchFirstBuyerOverlay(); });

  fbResetBtn?.addEventListener("click", () => {
    if (fbOverlayToggle) fbOverlayToggle.checked = false;
    if (fbPanel) fbPanel.style.display = "none";
    if (fbMonthlyIncome) fbMonthlyIncome.value = "";
    if (fbDownPayment)   fbDownPayment.value   = "";
    if (fbResult) fbResult.style.display = "none";
    document.dispatchEvent(new CustomEvent("first-buyer-overlay-change", { detail: { enabled: false } }));
  });

</script>

<script>
  // ── View mode toggle: map ↔ table ──

  const viewToggleBtn = document.getElementById("view-mode-toggle") as HTMLButtonElement | null;
  const mapViewContainer   = document.getElementById("map-view-container")   as HTMLElement | null;
  const tableViewContainer = document.getElementById("table-view-container") as HTMLElement | null;

  let isTableView = false;

  function switchToMapView(): void {
    isTableView = false;
    if (mapViewContainer)   mapViewContainer.style.display   = "";
    if (tableViewContainer) tableViewContainer.style.display = "none";
    if (viewToggleBtn) {
      viewToggleBtn.textContent = "📊 排行表";
      viewToggleBtn.setAttribute("aria-pressed", "false");
      viewToggleBtn.title = "切換至排行表";
    }
    // Resize map canvas after reveal — MapLibre doesn't auto-resize after display:none
    requestAnimationFrame(() => {
      document.dispatchEvent(new CustomEvent("map-view-restored"));
    });
  }

  function switchToTableView(): void {
    isTableView = true;
    if (mapViewContainer)   mapViewContainer.style.display   = "none";
    if (tableViewContainer) tableViewContainer.style.display = "";
    if (viewToggleBtn) {
      viewToggleBtn.textContent = "🗺 地圖";
      viewToggleBtn.setAttribute("aria-pressed", "true");
      viewToggleBtn.title = "切換至地圖";
    }
    // Notify DistrictTable to load data if not yet loaded
    document.dispatchEvent(new CustomEvent("table-view-activated"));
  }

  viewToggleBtn?.addEventListener("click", () => {
    if (isTableView) switchToMapView();
    else switchToTableView();
  });

  // ── Row click from DistrictTable: switch to map and focus district ──
  document.addEventListener("district-table-row-click", (e: Event) => {
    const { district, city } = (e as CustomEvent<{ district: string; city: string }>).detail;
    switchToMapView();
    // Give Map a tick to re-attach, then fire district-focus
    requestAnimationFrame(() => {
      document.dispatchEvent(
        new CustomEvent("district-focus", { detail: { district, city } })
      );
    });
  });
</script>

<script>
  // ── 首購族地區配對精靈 (issue #114) ──────────────────────────────────────────
  import {
    runWizard,
    polygonCentroid,
    COMMUTE_HUBS,
    type WizardParams,
    type WizardMatch,
    type DistrictInput,
  } from "../lib/wizardUtils.js";
  import {
    computeDistrictRows,
  } from "../lib/districtTableUtils.js";

  const WIZARD_DISMISSED_KEY = "rr-wizard-dismissed";
  const WIZARD_RESULTS_KEY   = "rr-wizard-results";
  const BASE_URL = import.meta.env.BASE_URL;

  const overlay      = document.getElementById("wizard-overlay")     as HTMLElement;
  const closeBtn     = document.getElementById("wizard-close-btn")   as HTMLButtonElement;
  const reopenBtn    = document.getElementById("wizard-reopen-btn")  as HTMLButtonElement;
  const runBtn       = document.getElementById("wizard-run-btn")     as HTMLButtonElement;
  const restartBtn   = document.getElementById("wizard-restart-btn") as HTMLButtonElement;
  const doneBtn      = document.getElementById("wizard-done-btn")    as HTMLButtonElement;
  const relaxHint    = document.getElementById("wizard-relax-hint")  as HTMLElement;
  const matchCards   = document.getElementById("wizard-match-cards") as HTMLElement;
  const resultsSub   = document.getElementById("wizard-results-subtitle") as HTMLElement;

  // ── navigation Step ─────────────────────────────────────────────────────────

  function showStep(n: number): void {
    for (let i = 1; i <= 3; i++) {
      const el = document.getElementById(`wizard-step-${i}`) as HTMLElement | null;
      if (el) el.hidden = i !== n;
    }
    const results = document.getElementById("wizard-results") as HTMLElement | null;
    if (results) results.hidden = true;

    // Update step dots
    document.querySelectorAll(".wizard-step-dot").forEach((dot) => {
      const step = Number((dot as HTMLElement).dataset.step);
      dot.classList.toggle("active", step === n);
      dot.classList.toggle("done",   step < n);
    });
  }

  function showResults(): void {
    for (let i = 1; i <= 3; i++) {
      const el = document.getElementById(`wizard-step-${i}`) as HTMLElement | null;
      if (el) el.hidden = true;
    }
    const results = document.getElementById("wizard-results") as HTMLElement | null;
    if (results) results.hidden = false;
    document.querySelectorAll(".wizard-step-dot").forEach((dot) => {
      dot.classList.add("done");
      dot.classList.remove("active");
    });
  }

  function openWizard(showSavedResults = false): void {
    overlay.hidden = false;
    overlay.focus();
    document.body.style.overflow = "hidden";
    if (showSavedResults && tryRestoreSavedResults()) {
      // Show saved results panel directly
    } else {
      showStep(1);
    }
  }

  function closeWizard(): void {
    overlay.hidden = true;
    document.body.style.overflow = "";
    localStorage.setItem(WIZARD_DISMISSED_KEY, "1");
  }

  // ── Data loading ───────────────────

  let districtInputCache: DistrictInput[] | null = null;

  async function loadDistrictInputs(): Promise<DistrictInput[]> {
    if (districtInputCache) return districtInputCache;

    // Load transaction data → district stats
    const txRes = await fetch(`${BASE_URL}data/sample-transactions.json`);
    if (!txRes.ok) throw new Error(`資料載入失敗 (${txRes.status})`);
    const txData = await txRes.json() as { features: any[] };
    const rows = computeDistrictRows(txData.features, 5); // lower threshold for wizard

    // Load all GeoJSON files → compute centroids
    const geojsonFiles = [
      "taipei-districts.geojson",
      "xinbei-districts.geojson",
      "taoyuan-districts.geojson",
      "taichung-districts.geojson",
      "tainan-districts.geojson",
      "kaohsiung-districts.geojson",
    ];

    const centroidMap = new Map<string, { lat: number; lng: number }>();
    await Promise.all(
      geojsonFiles.map(async (file) => {
        try {
          const res = await fetch(`${BASE_URL}data/${file}`);
          if (!res.ok) return; // skip missing files gracefully
          const gj = await res.json() as { features: { properties: { district: string; city: string }; geometry: any }[] };
          for (const feat of gj.features) {
            const { district, city } = feat.properties;
            const c = polygonCentroid(feat.geometry);
            if (c) centroidMap.set(`${city}::${district}`, c);
          }
        } catch { /* skip malformed files */ }
      })
    );

    // Merge rows + centroids → DistrictInput[]
    const inputs: DistrictInput[] = [];
    for (const row of rows) {
      const key = `${row.city}::${row.district}`;
      const centroid = centroidMap.get(key);
      if (!centroid) continue; // skip districts without geom data
      inputs.push({
        district: row.district,
        city: row.city,
        medianPriceWan: row.medianPriceWan,
        yoyPct: row.yoyPct,
        txCount12mo: row.txCount12mo,
        buyerTimingScore: row.buyerTimingScore,
        lat: centroid.lat,
        lng: centroid.lng,
      });
    }

    districtInputCache = inputs;
    return inputs;
  }

  // ── Read wizard form values ──────────────────────────────────────────────────

  function readParams(): WizardParams {
    const budget = (document.querySelector('input[name="budget"]:checked') as HTMLInputElement | null)?.value as WizardParams["budget"] ?? "800-1500";
    const downPayment = (document.querySelector('input[name="downPayment"]:checked') as HTMLInputElement | null)?.value as WizardParams["downPayment"] ?? "5-10";
    const hub = (document.getElementById("wizard-hub-select") as HTMLSelectElement | null)?.value ?? "taipei-main";
    const commuteMinsStr = (document.querySelector('input[name="commuteMins"]:checked') as HTMLInputElement | null)?.value ?? "30";
    const commuteMinsNum = Number(commuteMinsStr);
    // Guard: only accept valid CommuteMins values; default to 30 for invalid inputs
    const commuteMins: WizardParams["commuteMins"] = (commuteMinsNum === 30 || commuteMinsNum === 45 || commuteMinsNum === 60)
      ? commuteMinsNum
      : 30;
    const priority = (document.querySelector('input[name="priority"]:checked') as HTMLInputElement | null)?.value as WizardParams["priority"] ?? "timing-score";
    return { budget, downPayment, commuteHub: hub, commuteMins, priority };
  }

  // ── Render result cards ──────────────────────────────────────────────────────

  const RANKS = ["🥇", "🥈", "🥉"];

  function esc(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function scoreBadge(score: number | null): string {
    if (score === null) return "";
    const emoji = score >= 70 ? "🟢" : score >= 40 ? "🟡" : "🔴";
    return `<span class="wizard-card-badge">${emoji} 時機分 ${score}</span>`;
  }

  function renderCards(matches: WizardMatch[]): void {
    matchCards.innerHTML = matches.map((m, i) => `
      <div class="wizard-card">
        <span class="wizard-card-rank">${RANKS[i] ?? ""}</span>
        <p class="wizard-card-name">${esc(m.city)} ${esc(m.district)}</p>
        <div class="wizard-card-meta">
          ${typeof m.medianPriceWan === "number"
            ? `<span class="wizard-card-badge">💰 均價 ${m.medianPriceWan.toFixed(1)} 萬/坪</span>`
            : ""}
          ${scoreBadge(m.buyerTimingScore)}
          <span class="wizard-card-badge">🚉 距 ${esc(m.hubLabel)} ${m.distanceKm !== null ? m.distanceKm + " km" : "—"}</span>
        </div>
        <button class="wizard-card-goto"
          data-district="${esc(m.district)}"
          data-city="${esc(m.city)}"
          aria-label="查看 ${esc(m.city)} ${esc(m.district)} 地圖">
          🗺 查看地圖
        </button>
      </div>
    `).join("");

    // Wire "查看地圖" buttons
    matchCards.querySelectorAll<HTMLButtonElement>(".wizard-card-goto").forEach((btn) => {
      btn.addEventListener("click", () => {
        const district = btn.dataset.district!;
        const city     = btn.dataset.city!;
        closeWizard();
        // Switch to map view then fly to district
        const mapContainer   = document.getElementById("map-view-container");
        const tableContainer = document.getElementById("table-view-container");
        if (tableContainer?.style.display !== "none") {
          if (mapContainer)   mapContainer.style.display = "";
          if (tableContainer) tableContainer.style.display = "none";
          const vBtn = document.getElementById("view-mode-toggle") as HTMLButtonElement | null;
          if (vBtn) { vBtn.textContent = "📊 排行表"; vBtn.setAttribute("aria-pressed", "false"); }
          document.dispatchEvent(new CustomEvent("map-view-restored"));
        }
        requestAnimationFrame(() => {
          document.dispatchEvent(
            new CustomEvent("district-focus", { detail: { district, city } })
          );
        });
      });
    });
  }

  // ── Run matching ─────────────────────────────────────────────────────────────

  async function runMatching(): Promise<void> {
    runBtn.disabled = true;
    runBtn.textContent = "配對中…";
    try {
      const params  = readParams();
      const inputs  = await loadDistrictInputs();
      const { matches, needsRelax } = runWizard(params, inputs);

      // Persist results (including needsRelax for restored display)
      const hub = COMMUTE_HUBS.find((h) => h.id === params.commuteHub);
      localStorage.setItem(WIZARD_RESULTS_KEY, JSON.stringify({ matches, needsRelax, hub: hub?.label ?? params.commuteHub }));

      relaxHint.hidden = !needsRelax;
      if (matches.length === 0) {
        resultsSub.textContent = "目前條件下無符合行政區";
        matchCards.innerHTML   = "";
      } else {
        resultsSub.textContent = `找到 ${matches.length} 個最適合行政區`;
        renderCards(matches);
      }
      showResults();
    } catch (err) {
      const msg = err instanceof Error ? err.message : "配對時發生錯誤";
      resultsSub.textContent = `❌ ${msg}`;
      matchCards.innerHTML = "";
      relaxHint.hidden = true;
      showResults();
    } finally {
      runBtn.disabled = false;
      runBtn.textContent = "🔍 開始配對";
    }
  }

  // ── Event wiring ─────────

  closeBtn.addEventListener("click", closeWizard);
  reopenBtn.addEventListener("click", () => openWizard(true)); // show saved results if available
  runBtn.addEventListener("click", runMatching);
  doneBtn.addEventListener("click", closeWizard);
  restartBtn.addEventListener("click", () => { showStep(1); });

  // Next/Back buttons (delegated)
  overlay.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("wizard-next-btn")) {
      const next = Number(target.dataset.next);
      if (!isNaN(next)) showStep(next);
    } else if (target.classList.contains("wizard-back-btn")) {
      const back = Number(target.dataset.back);
      if (!isNaN(back)) showStep(back);
    }
  });

  // Keyboard: Escape closes wizard
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !overlay.hidden) closeWizard();
  });

  // Click outside panel closes wizard
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) closeWizard();
  });

  // ── Restore saved results ────────────────────────────────────────────────────

  function tryRestoreSavedResults(): boolean {
    const saved = localStorage.getItem(WIZARD_RESULTS_KEY);
    if (!saved) return false;
    try {
      const parsed = JSON.parse(saved) as { matches?: unknown; needsRelax?: unknown; hub?: unknown };
      const matches = parsed.matches;
      const hub = typeof parsed.hub === "string" ? parsed.hub : "";
      const needsRelax = Boolean(parsed.needsRelax);
      // Validate shape: must be an array (empty is allowed — shows 放寬條件 state)
      if (!Array.isArray(matches)) return false;
      // Each entry must have district/city strings and safe numeric fields
      const safeMatches = (matches as any[]).filter(
        (m) =>
          typeof m === "object" && m !== null &&
          typeof m.district === "string" && m.district.length > 0 &&
          typeof m.city === "string" && m.city.length > 0 &&
          typeof m.hubLabel === "string"
      );
      resultsSub.textContent = hub ? `上次配對結果（${hub}方向）` : "上次配對結果";
      relaxHint.hidden = !needsRelax;
      if (safeMatches.length > 0) {
        renderCards(safeMatches as WizardMatch[]);
      } else {
        matchCards.innerHTML = "";
      }
      showResults();
      return true;
    } catch { return false; }
  }

  // ── On first visit, show wizard; otherwise offer saved results ───────────────

  const dismissed = localStorage.getItem(WIZARD_DISMISSED_KEY);
  if (!dismissed) {
    // First visit — show wizard after map has a chance to initialise
    setTimeout(() => {
      // Re-check: user may have already dismissed before the timer fires
      if (!localStorage.getItem(WIZARD_DISMISSED_KEY)) openWizard();
    }, 800);
  }
  // Returning visitors: saved results load on demand when they click 重新配對
</script>

<script>
  // ── District Watchlist sidebar panel (issue #110) ────────────────────────────
  import {
    formatDelta,
    computeDeltaPct,
    shouldShowBanner,
    type WatchlistEntry,
  } from "../lib/watchlistUtils.js";
  import { computeMedianPrice12mo } from "../lib/districtTableUtils.js";

  const WL_KEY_IDX = "realestate-radar-watchlist";

  function idxGetAll(): WatchlistEntry[] {
    try {
      const raw = JSON.parse(localStorage.getItem(WL_KEY_IDX) ?? "[]");
      if (!Array.isArray(raw)) return [];
      return raw.filter(
        (e): e is WatchlistEntry =>
          e !== null &&
          typeof e === "object" &&
          typeof e.district === "string" && e.district.length > 0 &&
          typeof e.city === "string" &&
          typeof e.snapshotDate === "string" &&
          typeof e.snapshotPrice === "number"
      );
    } catch { return []; }
  }

  function idxSaveAll(entries: WatchlistEntry[]): void {
    try { localStorage.setItem(WL_KEY_IDX, JSON.stringify(entries)); } catch { /* storage unavailable */ }
  }

  // Current delta data (set once rawdata-loaded fires)
  let wlDeltaMap = new Map<string, { currentPrice: number; deltaPct: number; show: boolean }>();

  /**
   * Render the watchlist sidebar panel from current localStorage state and delta data.
   */
  function wlRenderPanel(): void {
    const panel    = document.getElementById("watchlist-panel") as HTMLElement | null;
    const list     = document.getElementById("watchlist-list")  as HTMLElement | null;
    const countEl  = document.getElementById("wl-count")        as HTMLSpanElement | null;
    if (!panel || !list) return;

    const entries = idxGetAll();
    if (countEl) countEl.textContent = String(entries.length);

    if (entries.length === 0) {
      // Keep panel visible if there's a stale notice to show, otherwise hide
      const notice = document.getElementById("watchlist-stale-notice") as HTMLElement | null;
      const hasNotice = notice && notice.style.display !== "none" && notice.textContent;
      list.innerHTML = "";
      panel.style.display = hasNotice ? "block" : "none";
      return;
    }

    panel.style.display = "block";
    list.innerHTML = "";

    for (const entry of entries) {
      const key = `${entry.city}::${entry.district}`;
      const delta = wlDeltaMap.get(key);

      // Sanitize potentially malformed localStorage values
      const districtStr = String(entry.district ?? "");
      const cityStr     = String(entry.city     ?? "");
      if (!districtStr) continue; // skip corrupt entries

      const item = document.createElement("div");
      item.className = "wl-item";

      // Top row: district name + unwatch button
      const topRow = document.createElement("div");
      topRow.className = "wl-item-top";
      topRow.innerHTML = `
        <div class="wl-district-name">
          <span class="wl-city-badge">${escHtmlWl(cityStr)}</span>${escHtmlWl(districtStr)}
        </div>
        <button class="wl-unwatch-btn" data-district="${escHtmlWl(districtStr)}" data-city="${escHtmlWl(cityStr)}">取消關注</button>
      `;
      topRow.querySelector(".wl-unwatch-btn")?.addEventListener("click", () => {
        const all = idxGetAll();
        idxSaveAll(all.filter((e) => !(String(e.city ?? "") === cityStr && String(e.district ?? "") === districtStr)));
        // Notify Map.astro's watchlist to stay in sync
        document.dispatchEvent(new CustomEvent("watchlist-changed-external", {
          detail: { city: cityStr, district: districtStr },
        }));
        wlRenderPanel();
      });
      item.appendChild(topRow);

      const snapshotPrice = typeof entry.snapshotPrice === "number" ? entry.snapshotPrice : NaN;

      // Delta banner — use pre-computed delta.show from Map.astro (avoids double shouldShowBanner call)
      if (delta && delta.currentPrice > 0 && delta.show) {
        const { text, arrow, cls } = formatDelta(delta.deltaPct);
        const bannerEl = document.createElement("div");
        bannerEl.innerHTML = `
          <span class="wl-delta-banner ${cls}">
            ${arrow} 自上次訪問，${escHtmlWl(districtStr)}均價 ${text}
          </span>
          <div class="wl-snapshot-note">快照：${escHtmlWl(entry.snapshotDate ?? "")} 基準 ${isNaN(snapshotPrice) ? "—" : snapshotPrice.toFixed(1)} 萬/坪</div>
        `;
        item.appendChild(bannerEl);
      } else if (!isNaN(snapshotPrice) && snapshotPrice > 0) {
        // No banner yet (same-day star or no current price) — show snapshot price only
        const noteEl = document.createElement("div");
        noteEl.className = "wl-snapshot-note";
        noteEl.textContent = `關注於 ${entry.snapshotDate ?? ""}，基準 ${snapshotPrice.toFixed(1)} 萬/坪`;
        item.appendChild(noteEl);
      }

      list.appendChild(item);
    }
  }

  function escHtmlWl(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"})[c]!);
  }

  // Listen for Map.astro firing watchlist-changed (star/unstar in popup)
  document.addEventListener("watchlist-changed", (e: Event) => {
    const { entries } = (e as CustomEvent<{ entries: WatchlistEntry[] }>).detail;
    // Re-build deltaMap for newly added entries when we have raw data
    if (rawFeaturesCache.length > 0) {
      const today = new Date().toISOString().slice(0, 10);
      for (const entry of entries) {
        const key = `${entry.city}::${entry.district}`;
        if (!wlDeltaMap.has(key)) {
          const currentPrice = computeMedianPrice12mo(rawFeaturesCache, entry.district, entry.city || undefined) ?? 0;
          const deltaPct = computeDeltaPct(entry.snapshotPrice, currentPrice);
          const show = entry.snapshotPrice > 0 && shouldShowBanner(entry.snapshotDate, today);
          wlDeltaMap.set(key, { currentPrice, deltaPct, show });
        }
      }
      // Remove entries that were unwatched (avoid split("::") on keys)
      for (const key of [...wlDeltaMap.keys()]) {
        if (!entries.some((e) => `${e.city}::${e.district}` === key)) {
          wlDeltaMap.delete(key);
        }
      }
    }
    wlRenderPanel();
  });

  // Listen for Map.astro's delta computation result (rawdata-loaded → stale-check → deltas-ready)
  document.addEventListener("watchlist-deltas-ready", (e: Event) => {
    const { deltas } = (e as CustomEvent<{
      deltas: Array<{ entry: WatchlistEntry; currentPrice: number; deltaPct: number; show: boolean }>;
    }>).detail;

    wlDeltaMap.clear();
    for (const d of deltas) {
      const key = `${d.entry.city}::${d.entry.district}`;
      wlDeltaMap.set(key, { currentPrice: d.currentPrice, deltaPct: d.deltaPct, show: d.show });
    }
    wlRenderPanel();
  });

  // Listen for stale entries being cleared
  document.addEventListener("watchlist-stale-cleared", (e: Event) => {
    const { cleared } = (e as CustomEvent<{ cleared: WatchlistEntry[] }>).detail;
    const notice = document.getElementById("watchlist-stale-notice") as HTMLElement | null;
    if (!notice || cleared.length === 0) return;
    const names = cleared.map((c) => `${c.city} ${c.district}`).join("、");
    notice.textContent = `ℹ️ 已自動移除超過 90 天的關注：${names}`;
    notice.style.display = "block";
  });

  // Cache for raw features (to compute deltas for newly starred districts)
  let rawFeaturesCache: any[] = [];
  document.addEventListener("rawdata-loaded", (e: Event) => {
    const { features } = (e as CustomEvent<{ features: any[] }>).detail;
    rawFeaturesCache = features;
  });

  // Initial render from localStorage on page load
  wlRenderPanel();
</script>

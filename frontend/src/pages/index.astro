    const insuffEl   = document.getElementById("volume-yoy-insufficient") as HTMLDivElement    | null;
    const canvas     = document.getElementById("volume-yoy-chart")        as HTMLCanvasElement | null;
    const deltaEl    = document.getElementById("volume-yoy-delta-labels") as HTMLDivElement    | null;
    if (!panel || !canvas) return;

    if (distLabel) distLabel.textContent = district ? ` — ${district}` : "";
    panel.style.display = "block";

    const priorYear = referenceYear - 1;

    // ── YTD summary badge (only quarters up to current month to avoid mid-year bias) ──
    const currentMonth = new Date().getMonth() + 1; // 1–12
    const ytd = computeYTDSummary(volumeYoY, currentMonth);
    if (badge) {
      if (ytd.ytdYoYPct !== null) {
        const arrow = ytd.ytdYoYPct >= 0 ? "↑" : "↓";
        const absStr = formatYoYPct(Math.abs(ytd.ytdYoYPct)).replace("+", "").replace("-", "");
        badge.textContent = `今年成交量 ${arrow} ${absStr} 同期`;
        badge.className = `volume-yoy-badge ${ytd.ytdYoYPct < 0 ? "badge-down" : "badge-up"}`;
        badge.style.display = "block";
      } else {
        badge.style.display = "none";
      }
    }

    // Check if all quarters have insufficient data for both years
    const hasAnyData = volumeYoY.some((v) => v.currentYear > 0 || v.priorYear > 0);
    if (!hasAnyData) {
      if (insuffEl) insuffEl.style.display = "block";
      canvas.style.display = "none";
      if (deltaEl) deltaEl.innerHTML = "";
      return;
    }
    if (insuffEl) insuffEl.style.display = "none";
    canvas.style.display = "block";

    await ensureChart();
    if (seq !== volumeYoYRenderSeq) return; // stale — newer district click already in progress

    // Destroy any previous chart instance
    const existingChart = (canvas as any)._volumeYoYChart;
    if (existingChart) { existingChart.destroy(); (canvas as any)._volumeYoYChart = null; }

    const BRAND_COLOR  = "rgba(37,99,235,0.8)";
    const PRIOR_COLOR  = "rgba(148,163,184,0.65)";
    const BRAND_BORDER = "rgba(37,99,235,1)";
    const PRIOR_BORDER = "rgba(148,163,184,1)";

    const isMobile = window.innerWidth <= 480;
    if (isMobile) {
      canvas.width  = 240;
      canvas.height = 140;
    } else {
      canvas.width  = 260;
      canvas.height = 160;
    }

    const chart = new Chart(canvas, {
      type: "bar",
      data: {
        labels: volumeYoY.map((v) => v.quarter),
        datasets: [
          {
            label: String(referenceYear),
            data: volumeYoY.map((v) => v.currentYear),
            backgroundColor: BRAND_COLOR,
            borderColor: BRAND_BORDER,
            borderWidth: 1,
            borderRadius: 3,
          },
          {
            label: String(priorYear),
            data: volumeYoY.map((v) => v.priorYear),
            backgroundColor: PRIOR_COLOR,
            borderColor: PRIOR_BORDER,
            borderWidth: 1,
            borderRadius: 3,
          },
        ],
      },
      options: {
        responsive: false,
        animation: { duration: 200 },
        plugins: {
          legend: {
            display: true,
            position: "top" as const,
            labels: { font: { size: 10 }, boxWidth: 10, padding: 8 },
          },
          tooltip: {
            callbacks: {
              label: (ctx: any) => {
                const val = ctx.parsed.y as number;
                const qData = volumeYoY[ctx.dataIndex];
                if (!qData) return `${ctx.dataset.label}: ${val} 件`;
                const isCurrentYear = ctx.datasetIndex === 0;
                const insuf = isCurrentYear ? qData.insufficientCurrent : qData.insufficientPrior;
                return `${ctx.dataset.label}: ${val} 件${insuf ? " ⚠資料不足" : ""}`;
              },
            },
          },
        },
        scales: {
          x: { ticks: { font: { size: 10 } } },
          y: {
            beginAtZero: true,
            ticks: { font: { size: 10 }, maxTicksLimit: 5, stepSize: 1 },
          },
        },
      },
    });
    (canvas as any)._volumeYoYChart = chart;

    // ── Per-quarter delta labels (HTML-escaped, no XSS) ──
    if (deltaEl) {
      type EscChar = "&" | "<" | ">" | '"' | "'";
      const escMap: Record<EscChar, string> = {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"};
      const escHtml = (s: string) => s.replace(/[&<>"']/g, (c) => escMap[c as EscChar]!);
      deltaEl.innerHTML = volumeYoY.map((v) => {
        const qLabel = escHtml(v.quarter);
        // Show "資料不足" for insufficient current-year quarter (< 4 transactions)
        if (v.insufficientCurrent) {
          return `<span class="delta-na" title="${qLabel}: 資料不足">${qLabel}: 資料不足</span>`;
        }
        if (v.yoyPct === null) {
          return `<span class="delta-na" title="${qLabel}: 無去年資料">${qLabel}: —</span>`;
        }
        const sign    = v.yoyPct >= 0 ? "+" : "-";
        const abs     = Math.abs(v.yoyPct);
        const absStr  = Number.isInteger(abs) ? String(abs) : abs.toFixed(1);
        const pctStr  = escHtml(`${sign}${absStr}%`);
        const cls     = v.yoyPct < 0 ? "delta-down" : "delta-up";
        // Append * indicator when prior-year data is also insufficient
        const insuffSuffix = v.insufficientPrior ? " *" : "";
        return `<span class="${cls}" title="${qLabel}: ${pctStr}${v.insufficientPrior ? " (去年資料不足)" : ""}">${qLabel}: ${pctStr}${insuffSuffix}</span>`;
      }).join("");
    }
  });


                aria-label="購屋總價（萬元）" />
              <span id="lpc-price-hint" class="lpc-price-hint"></span>
            </div>
          </div>
          <div class="calc-input-row lpc-slider-row">
            <label for="lpc-down">自備款比例</label>
            <div class="lpc-slider-wrapper">
              <input type="range" id="lpc-down" min="10" max="40" step="10" value="20"
                aria-label="自備款比例" />
              <span id="lpc-down-display" class="lpc-down-display">20%</span>
            </div>
          </div>
        </div>

        <!-- Program toggle checkboxes -->
        <div id="lpc-toggles" class="lpc-toggles">
          <span class="lpc-toggle-label">排除：</span>
          <label class="lpc-toggle-chip">
            <input type="checkbox" id="lpc-hide-civil" />
            非公教人員（隱藏公教優惠）
          </label>
        </div>

        <!-- Results table -->
        <div id="lpc-result" class="lpc-result" style="display:none">
          <div class="lpc-table-scroll">
            <table class="lpc-table" aria-label="貸款方案比較表">
              <thead>
                <tr>
                  <th>方案</th>
                  <th>利率</th>
                  <th>每月還款</th>
                  <th>總利息</th>
                  <th>備註</th>
                </tr>
              </thead>
              <tbody id="lpc-tbody"></tbody>
            </table>
          </div>
          <p class="lpc-footnote">以 30 年等額攤還計算。利率為參考值，實際以各行庫核定為準。</p>
        </div>
        <p id="lpc-placeholder" class="lpc-placeholder">請輸入總價以查看各方案比較</p>
      </div>

      <div id="stats-panel" class="stats-panel">
        <h3>統計資訊</h3>
        {showBuyersMarket && <p class="buyers-market-context">📉 {dataYear}年行情下行中 — 首購族議價空間擴大</p>}
        <div id="stats-content">
          <p class="placeholder">選擇條件後按搜尋</p>
        </div>
        <div id="yoy-panel" class="yoy-panel" style="display:none"></div>
      </div>

      <div id="trend-panel" class="trend-panel" style="display:none">
        <h3 id="trend-title">價格走勢</h3>
        <!-- ── Box-plot / Line toggle (issue #124) ── -->
        <div id="price-chart-toggle" class="price-chart-toggle" role="group" aria-label="圖表類型">
          <button type="button" id="btn-boxplot" class="chart-toggle-btn" data-chart="boxplot">箱型圖</button>
          <button type="button" id="btn-linechart" class="chart-toggle-btn active" data-chart="line">折線圖</button>
        </div>
        <!-- Line chart panel (issue #131: monthly trend with MA3, YoY, toggle) -->
        <div id="line-chart-panel">
          <!-- 每坪/總價 toggle (issue #131) -->
          <div id="price-mode-toggle" class="price-mode-toggle" role="group" aria-label="價格模式">
            <button type="button" id="btn-per-ping" class="price-mode-btn active" data-mode="perPing">每坪單價</button>
            <button type="button" id="btn-total" class="price-mode-btn" data-mode="total">總價</button>
          </div>
          <canvas id="trend-chart" width="260" height="160" aria-label="每月中位數單價折線趨勢圖"></canvas>
          <div id="trend-insufficient" class="trend-insufficient" style="display:none">資料不足（需 ≥6 個月歷史交易）</div>
          <p id="trend-note" class="trend-note"></p>
          <p id="trend-yoy" class="trend-yoy" style="display:none"></p>
        </div>
        <!-- Box-plot chart (issue #124) -->
        <div id="boxplot-panel" class="boxplot-inner-panel" style="display:none">
          <canvas id="boxplot-canvas" width="260" height="180" aria-label="歷史成交價位箱型圖"></canvas>
          <div id="boxplot-insufficient" class="boxplot-insufficient" style="display:none">資料不足（需 ≥2 年歷史交易）</div>
          <p id="boxplot-percentile-label" class="boxplot-percentile-label" style="display:none"></p>
        </div>
      </div>

      <!-- ── Building-age depreciation curve ── -->
      <div id="age-curve-panel" class="age-curve-panel" style="display:none">
        <h3>🏗 屋齡折舊曲線<span id="age-curve-district-label" class="age-curve-district-label"></span></h3>
        <p class="age-curve-note">中位數單價 (萬/坪) by 屋齡</p>
        <div id="age-curve-insufficient" class="age-curve-insufficient" style="display:none">資料不足（需 ≥3 屋齡區間，每區間 ≥5 筆）</div>
        <canvas id="age-curve-chart" width="260" height="160"></canvas>
      </div>

      <!-- ── Seasonal deal-flow calendar ── -->
      <div id="seasonal-panel" class="seasonal-panel" style="display:none">
        <h3>📅 買方季曆<span id="seasonal-district-label" class="seasonal-district-label"></span></h3>
        <p class="seasonal-note">月均成交量（歷年平均）</p>
        <div id="seasonal-insufficient" class="seasonal-insufficient" style="display:none">資料不足（需 ≥24 個月歷史）</div>
        <canvas id="seasonal-chart" width="260" height="140"></canvas>
        <div id="seasonal-summary" class="seasonal-summary" style="display:none"></div>
      </div>

      <!-- ── Monthly heatmap (issue #112) ── -->
      <div id="heatmap-panel" class="heatmap-panel" style="display:none">
        <div class="heatmap-header">
          <h3>🗓 月份成交量熱力圖</h3>
          <div class="heatmap-scope-toggle" role="group" aria-label="選擇範圍">
            <button id="heatmap-btn-district" class="heatmap-scope-btn active" data-scope="district">本區</button>
            <button id="heatmap-btn-global"   class="heatmap-scope-btn"        data-scope="global">全臺灣</button>
          </div>
        </div>
        <p class="heatmap-note">成交筆數 × 月份，顏色深淺 = 相對熱度。🔵 = 買方優勢月（量 &lt; 年高峰 70%）</p>
        <div id="heatmap-insufficient" class="heatmap-insufficient" style="display:none">資料不足（需 ≥12 個月歷史）</div>
        <canvas id="heatmap-canvas" class="heatmap-canvas" aria-label="月份成交量熱力圖"></canvas>
        <div id="heatmap-tooltip" class="heatmap-tooltip" style="display:none"></div>
        <div id="heatmap-buyer-summary" class="heatmap-buyer-summary" style="display:none"></div>
      </div>

      <div id="histogram-panel" class="histogram-panel" style="display:none">
        <h3>單價分佈 (萬/坪)<span id="histogram-district-label" class="histogram-district-label"></span></h3>
        <p class="histogram-note">近 12 個月成交</p>
        <div id="histogram-insufficient" class="histogram-insufficient" style="display:none">資料不足（需 ≥10 筆成交）</div>
        <div id="histogram-svg-container"></div>
        <div id="histogram-target-row" class="histogram-target-row">
          <label for="histogram-target-price">目標單價</label>
          <input type="number" id="histogram-target-price" class="histogram-target-input" placeholder="萬/坪" min="0" step="0.1" />
          <span class="histogram-target-unit">萬/坪</span>
        </div>
        <p id="histogram-percentile-label" class="histogram-percentile-label"></p>
      </div>

      <div id="transaction-list-panel" class="transaction-list-panel" style="display:none">
        <div class="transaction-list-header">
          <h3>交易紀錄</h3>
          <div class="transaction-list-sort">
            <label>排序：</label>
            <select id="sort-by">
              <option value="date-desc">日期 (新→舊)</option>
              <option value="date-asc">日期 (舊→新)</option>
              <option value="unitPrice-desc">單價 (高→低)</option>
              <option value="unitPrice-asc">單價 (低→高)</option>
              <option value="totalPrice-desc">總價 (高→低)</option>
              <option value="totalPrice-asc">總價 (低→高)</option>

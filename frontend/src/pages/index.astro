      <!-- ── Completion Wave Panel ── -->
      <div id="completion-wave-panel" class="completion-wave-panel">
        <div class="completion-wave-header">
          <h3>📦 建造完工供給波浪</h3>
          <span class="completion-wave-badge projected-badge">2026–2028 預測</span>
        </div>
        <p class="completion-wave-desc">
          各縣市季度使用執照核發數（建築完工）。2026–2028 為依建照推估之預測值。
        </p>
        <div class="completion-city-select-row">
          <label for="completion-city-select">縣市</label>
          <select id="completion-city-select">
            <option value="all">全部六都</option>
            <option value="台北市">台北市</option>
            <option value="新北市">新北市</option>
            <option value="桃園市">桃園市</option>
            <option value="台中市">台中市</option>
            <option value="台南市">台南市</option>
            <option value="高雄市">高雄市</option>
          </select>
        </div>
        <div class="completion-chart-wrap">
          <canvas id="completion-wave-chart" width="260" height="200" aria-label="完工供給波浪圖"></canvas>
        </div>
        <p class="completion-wave-note" id="completion-wave-note">
          資料來源：內政部不動產資訊平台 E3030（示範資料）
        </p>
      </div>
    </aside>

    <div class="map-container" id="map-view-container">
      <div id="ss-alert-banner" class="ss-alert-banner" style="display:none"></div>
      <Map />
    </div>
    <div class="table-view-container" id="table-view-container" style="display:none">
      <DistrictTable />
    </div>
  </main>
  <button id="view-mode-toggle" class="view-mode-toggle" aria-pressed="false" title="切換至排行表">
    📊 排行表
  </button>
  <button id="filter-toggle-btn" class="filter-toggle-btn" aria-label="開啟篩選">☰ 篩選</button>
  <footer class="site-footer">
    <p>本工具無仲介費用衝突，提供市場真實成交資訊。資料來源：<a href="https://lvr.land.moi.gov.tw/" target="_blank" rel="noopener noreferrer">內政部實價登錄</a>。</p>
  </footer>

  <!-- ── 首購族地區配對精靈 Wizard Modal ── -->
  <div id="wizard-overlay" class="wizard-overlay" role="dialog" aria-modal="true" aria-labelledby="wizard-title" tabindex="-1" hidden>
    <div class="wizard-panel">
      <button id="wizard-close-btn" class="wizard-close-btn" aria-label="關閉精靈">✕</button>

      <!-- Step indicators -->
      <div class="wizard-steps" aria-label="步驟進度">
        <span class="wizard-step-dot active" data-step="1" aria-label="步驟一：預算">1</span>
        <span class="wizard-step-line"></span>
        <span class="wizard-step-dot" data-step="2" aria-label="步驟二：通勤">2</span>
        <span class="wizard-step-line"></span>
        <span class="wizard-step-dot" data-step="3" aria-label="步驟三：優先考量">3</span>
      </div>

      <!-- Step 1: Budget -->
      <div id="wizard-step-1" class="wizard-step" aria-label="步驟一：預算">
        <h2 id="wizard-title" class="wizard-step-title">🏠 首購族地區配對精靈</h2>
        <p class="wizard-step-subtitle">步驟 1 / 3 — 預算</p>
        <p class="wizard-step-desc">您的總購屋預算是？</p>
        <div class="wizard-radio-group" role="radiogroup" aria-label="總購屋預算">
          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="under-800" checked />
            <span class="wizard-radio-text">💰 800萬以下</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="800-1500" />
            <span class="wizard-radio-text">💰 800萬 ~ 1,500萬</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="1500-2500" />
            <span class="wizard-radio-text">💰 1,500萬 ~ 2,500萬</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="budget" value="over-2500" />
            <span class="wizard-radio-text">💰 2,500萬以上</span>
          </label>
        </div>
        <p class="wizard-step-desc" style="margin-top:16px">頭期款準備程度？</p>
        <div class="wizard-radio-group" role="radiogroup" aria-label="頭期款準備程度">
          <label class="wizard-radio-label">
            <input type="radio" name="downPayment" value="under-5" />
            <span class="wizard-radio-text">存款不足 5%</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="downPayment" value="5-10" checked />
            <span class="wizard-radio-text">5% ~ 10%</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="downPayment" value="10-20" />
            <span class="wizard-radio-text">10% ~ 20%</span>
          </label>
        </div>
        <div class="wizard-nav">
          <span></span>
          <button class="wizard-next-btn" data-next="2">下一步 →</button>
        </div>
      </div>

      <!-- Step 2: Commute -->
      <div id="wizard-step-2" class="wizard-step" hidden aria-label="步驟二：通勤">
        <h2 class="wizard-step-title">🚇 通勤設定</h2>
        <p class="wizard-step-subtitle">步驟 2 / 3 — 通勤</p>
        <p class="wizard-step-desc">主要通勤目的地？</p>
        <select id="wizard-hub-select" class="wizard-select" aria-label="主要通勤目的地">
          <option value="taipei-main">台北車站</option>
          <option value="xinyi">信義區</option>
          <option value="banqiao">板橋</option>
          <option value="taichung-main">台中火車站</option>
          <option value="kaohsiung-mrt">高雄捷運</option>
        </select>
        <p class="wizard-step-desc" style="margin-top:16px">可接受通勤時間？</p>
        <div class="wizard-radio-group" role="radiogroup" aria-label="可接受通勤時間">
          <label class="wizard-radio-label">
            <input type="radio" name="commuteMins" value="30" checked />
            <span class="wizard-radio-text">⏱ 30 分鐘以內</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="commuteMins" value="45" />
            <span class="wizard-radio-text">⏱ 45 分鐘以內</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="commuteMins" value="60" />
            <span class="wizard-radio-text">⏱ 60 分鐘以內</span>
          </label>
        </div>
        <div class="wizard-nav">
          <button class="wizard-back-btn" data-back="1">← 上一步</button>
          <button class="wizard-next-btn" data-next="3">下一步 →</button>
        </div>
      </div>

      <!-- Step 3: Priority -->
      <div id="wizard-step-3" class="wizard-step" hidden aria-label="步驟三：優先考量">
        <h2 class="wizard-step-title">🎯 優先考量</h2>
        <p class="wizard-step-subtitle">步驟 3 / 3 — 優先考量</p>
        <p class="wizard-step-desc">您最在意哪個條件？（選一項）</p>
        <div class="wizard-radio-group" role="radiogroup" aria-label="優先考量">
          <label class="wizard-radio-label">
            <input type="radio" name="priority" value="total-lowest" checked />
            <span class="wizard-radio-text">💲 總價最低</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="priority" value="ping-best" />
            <span class="wizard-radio-text">📐 坪效最佳（最低單價）</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="priority" value="newest" />
            <span class="wizard-radio-text">🏗 屋齡最新（成交最活躍）</span>
          </label>
          <label class="wizard-radio-label">
            <input type="radio" name="priority" value="timing-score" />
            <span class="wizard-radio-text">🎯 買方時機分最高</span>
          </label>
        </div>
        <div class="wizard-nav">
          <button class="wizard-back-btn" data-back="2">← 上一步</button>
          <button id="wizard-run-btn" class="wizard-run-btn">🔍 開始配對</button>
        </div>
      </div>

      <!-- Results -->
      <div id="wizard-results" class="wizard-step" hidden aria-label="配對結果">
        <h2 class="wizard-step-title">🏘 配對結果</h2>
        <p id="wizard-results-subtitle" class="wizard-step-subtitle"></p>
        <div id="wizard-relax-hint" class="wizard-relax-hint" hidden>
          😔 符合條件的行政區不足 3 個，建議放寬預算或通勤時間。
        </div>
        <div id="wizard-match-cards" class="wizard-match-cards"></div>
        <div class="wizard-nav" style="margin-top:20px">
          <button id="wizard-restart-btn" class="wizard-back-btn">🔄 重新配對</button>
          <button id="wizard-done-btn" class="wizard-next-btn">完成 ✓</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // ---- District data per city ----
  const DISTRICTS_BY_CITY: Record<string, string[]> = {
    "台北市": ["中正區","大同區","中山區","松山區","大安區","萬華區","信義區","士林區","北投區","內湖區","南港區","文山區"],
    "新北市": ["板橋區","三重區","中和區","永和區","新莊區","新店區","土城區","蘆洲區","樹林區","汐止區","鶯歌區","三峽區","淡水區","林口區","五股區","泰山區","瑞芳區","八里區","深坑區","三芝區","萬里區","金山區","貢寮區","石門區","平溪區","雙溪區","石碇區","坪林區","烏來區"],
    "桃園市": ["桃園區","中壢區","大溪區","楊梅區","蘆竹區","大園區","龜山區","八德區","龍潭區","平鎮區","新屋區","觀音區","復興區"],
    "台中市": ["中區","東區","南區","西區","北區","北屯區","西屯區","南屯區","太平區","大里區","霧峰區","烏日區","豐原區","后里區","石岡區","東勢區","和平區","新社區","潭子區","大雅區","神岡區","大肚區","沙鹿區","龍井區","梧棲區","清水區","大甲區","外埔區","大安區"],
    "台南市": ["中西區","東區","南區","北區","安平區","安南區","永康區","歸仁區","新化區","左鎮區","玉井區","楠西區","南化區","仁德區","關廟區","龍崎區","官田區","麻豆區","佳里區","西港區","七股區","將軍區","學甲區","北門區","新營區","後壁區","白河區","東山區","六甲區","下營區","柳營區","鹽水區","善化區","大內區","山上區","新市區","安定區"],
    "高雄市": ["楠梓區","左營區","鼓山區","三民區","鹽埕區","前金區","新興區","苓雅區","前鎮區","旗津區","小港區","鳳山區","林園區","大寮區","大樹區","大社區","仁武區","鳥松區","岡山區","橋頭區","燕巢區","田寮區","阿蓮區","路竹區","湖內區","茄萣區","永安區","彌陀區","梓官區","旗山區","美濃區","六龜區","甲仙區","杉林區","內門區","茂林區","桃源區","那瑪夏區"],
  };

  // ---- Dynamic district dropdown ----
  function updateDistrictOptions(city: string): void {
    const districtSelect = document.getElementById("district-select") as HTMLSelectElement;
    const currentValue = districtSelect.value;
    districtSelect.innerHTML = '<option value="">全部</option>';
    const districts = city ? DISTRICTS_BY_CITY[city] : [];
    for (const d of districts) {
      const opt = document.createElement("option");
      opt.value = d;
      opt.textContent = d;
      districtSelect.appendChild(opt);
    }
    // Restore selection if still valid
    if (districts.includes(currentValue)) {
      districtSelect.value = currentValue;
    }
  }

  document.getElementById("city-select")?.addEventListener("change", (e) => {
    updateDistrictOptions((e.target as HTMLSelectElement).value);
  });

  // ---- Address search ----
  const addressInput = document.getElementById("address-search") as HTMLInputElement;
  const addressClearBtn = document.getElementById("address-clear-btn") as HTMLButtonElement;

  addressInput?.addEventListener("input", () => {
    addressClearBtn.style.display = addressInput.value ? "block" : "none";
  });

  addressClearBtn?.addEventListener("click", () => {
    addressInput.value = "";
    addressClearBtn.style.display = "none";
    document.getElementById("search-btn")?.click();
  });

  // Enter key triggers search
  addressInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      document.getElementById("search-btn")?.click();
    }
  });

  // ---- URL hash state (GitHub Pages compatible, client-side only) ----
  // Encodes all active filter state into the URL hash fragment so users can
  // copy, bookmark, and share any filtered view without a server.

  function getHashParams(): Record<string, string> {
    const params: Record<string, string> = {};
    const city          = (document.getElementById("city-select")              as HTMLSelectElement)?.value;
    const district      = (document.getElementById("district-select")          as HTMLSelectElement)?.value;
    const minPrice      = (document.getElementById("price-min")                as HTMLInputElement)?.value;
    const maxPrice      = (document.getElementById("price-max")                as HTMLInputElement)?.value;
    const totalPriceMin = (document.getElementById("total-price-min")          as HTMLInputElement)?.value;
    const totalPriceMax = (document.getElementById("total-price-max")          as HTMLInputElement)?.value;
    const areaMin       = (document.getElementById("area-min")                 as HTMLInputElement)?.value;
    const areaMax       = (document.getElementById("area-max")                 as HTMLInputElement)?.value;
    const buildingType  = (document.getElementById("building-type")            as HTMLSelectElement)?.value;
    const address       = (document.getElementById("address-search")           as HTMLInputElement)?.value;
    const dateFrom      = (document.getElementById("date-from")                as HTMLInputElement)?.value;
    const dateTo        = (document.getElementById("date-to")                  as HTMLInputElement)?.value;
    const mrtWalkMin    = (document.getElementById("mrt-walk-min")             as HTMLSelectElement)?.value;
    const buildAgeRange = (document.getElementById("build-age-range")          as HTMLSelectElement)?.value;
    const post921       = (document.getElementById("post921-toggle")           as HTMLInputElement)?.checked;
    // Overlay / choropleth layer states
    const choropleth    = (document.getElementById("choropleth-toggle")        as HTMLInputElement)?.checked ?? true;
    const buyerScore    = (document.getElementById("buyer-score-toggle")       as HTMLInputElement)?.checked;
    const volatility    = (document.getElementById("volatility-toggle")        as HTMLInputElement)?.checked;
    const mrtPremium    = (document.getElementById("mrt-premium-toggle")       as HTMLInputElement)?.checked;
    const presaleSpread = (document.getElementById("presale-spread-toggle")    as HTMLInputElement)?.checked;
    const completion    = (document.getElementById("completion-overlay-toggle") as HTMLInputElement)?.checked;

    if (city)          params.city = city;
    if (district)      params.district = district;
    if (minPrice)      params.minPrice = minPrice;
    if (maxPrice)      params.maxPrice = maxPrice;
    if (totalPriceMin) params.totalPriceMin = totalPriceMin;
    if (totalPriceMax) params.totalPriceMax = totalPriceMax;
    if (areaMin)       params.areaMin = areaMin;
    if (areaMax)       params.areaMax = areaMax;
    if (buildingType)  params.buildingType = buildingType;
    if (address)       params.address = address;
    if (dateFrom)      params.dateFrom = dateFrom;
    if (dateTo)        params.dateTo = dateTo;
    if (mrtWalkMin)    params.mrtWalkMin = mrtWalkMin;
    if (buildAgeRange) params.buildAgeRange = buildAgeRange;
    if (post921)       params.post921 = "1";
    // choropleth is on by default; only encode when turned off
    if (!choropleth)   params.choropleth = "0";
    if (buyerScore)    params.buyerScore = "1";
    if (volatility)    params.volatility = "1";
    if (mrtPremium)    params.mrtPremium = "1";
    if (presaleSpread) params.presaleSpread = "1";
    if (completion)    params.completion = "1";
    return params;
  }

  /** Update URL hash in-place without adding a history entry (used for real-time updates). */
  function updateHash(): void {
    const qs = new URLSearchParams(getHashParams()).toString();
    history.replaceState(null, "", qs ? `${location.pathname}#${qs}` : location.pathname);
  }

  /**
   * Restore filter state from URL hash fragment.
   * Returns true only if the hash contains at least one recognized filter key
   * (prevents unrelated anchors like #foo from suppressing the legacy fallback).
   * Invalid or partial values are silently ignored (graceful degradation).
   */
  function loadFromHash(): boolean {
    const raw = location.hash.startsWith("#") ? location.hash.slice(1) : "";
    if (!raw) return false;
    try {
      const sp = new URLSearchParams(raw);
      // Guard: at least one recognized key must be present
      const KNOWN_KEYS = ["city","district","minPrice","maxPrice","totalPriceMin","totalPriceMax",
        "areaMin","areaMax","buildingType","address","dateFrom","dateTo","mrtWalkMin",
        "buildAgeRange","post921","choropleth","buyerScore","volatility","mrtPremium","presaleSpread","completion"];
      if (!KNOWN_KEYS.some(k => sp.has(k))) return false;

      const set = (id: string, key: string) => {
        const el = document.getElementById(id) as HTMLSelectElement | HTMLInputElement | null;
        const v = sp.get(key);
        if (el && v !== null && v !== "") el.value = v;
      };
      const city = sp.get("city");
      if (city) {
        const cityEl = document.getElementById("city-select") as HTMLSelectElement | null;
        if (cityEl) { cityEl.value = city; updateDistrictOptions(city); }
      }
      set("district-select", "district");
      set("price-min",       "minPrice");
      set("price-max",       "maxPrice");
      set("total-price-min", "totalPriceMin");
      set("total-price-max", "totalPriceMax");
      set("area-min",        "areaMin");
      set("area-max",        "areaMax");
      set("building-type",   "buildingType");
      set("build-age-range", "buildAgeRange");
      set("date-from",       "dateFrom");
      set("date-to",         "dateTo");
      set("address-search",  "address");
      set("mrt-walk-min",    "mrtWalkMin");
      const post921Val = sp.get("post921");
      const post921El = document.getElementById("post921-toggle") as HTMLInputElement | null;
      if (post921El && post921Val !== null) post921El.checked = post921Val === "1";
      // NOTE: Overlay checkboxes (choropleth, buyerScore, volatility, completion) are
      // intentionally NOT set here. applyOverlayStateFromHash() owns overlay state
      // exclusively, comparing current checkbox state (= current map state) against
      // the hash to compute correct ON→OFF and OFF→ON transitions.
      if (sp.get("address")) addressClearBtn.style.display = "block";
      return true;
    } catch {
      // Graceful degradation: malformed hash silently ignored, default state loaded
      return false;
    }
  }

  /**
   * Apply overlay toggle state from a parsed hash snapshot.
   * Handles both ON→OFF and OFF→ON transitions by comparing the desired state
   * against the current checkbox state before dispatching change events.
   */
  function applyOverlayStateFromHash(snapshotRaw: string): void {
    try {
      const sp = new URLSearchParams(snapshotRaw);
      // Choropleth: default ON; encoded only when OFF
      const wantChoropleth = sp.has("choropleth") ? sp.get("choropleth") !== "0" : true;
      const choroplethEl = document.getElementById("choropleth-toggle") as HTMLInputElement | null;
      if (choroplethEl && choroplethEl.checked !== wantChoropleth) {
        choroplethEl.checked = wantChoropleth;
        choroplethEl.dispatchEvent(new Event("change"));
      }
      // Other overlays: default OFF; encoded only when ON
      const overlays: [string, string][] = [
        ["buyer-score-toggle",       "buyerScore"],
        ["volatility-toggle",        "volatility"],
        ["mrt-premium-toggle",       "mrtPremium"],
        ["presale-spread-toggle",    "presaleSpread"],
        ["completion-overlay-toggle","completion"],
      ];
      for (const [elId, key] of overlays) {
        const want = sp.get(key) === "1";
        const el = document.getElementById(elId) as HTMLInputElement | null;
        if (el && el.checked !== want) {
          el.checked = want;
          el.dispatchEvent(new Event("change"));
        }
      }
    } catch { /* ignore */ }
  }

  /** Legacy: restore from query string for old bookmarks before hash-based approach. */
  function loadFromUrl(): void {
    const sp = new URLSearchParams(location.search);
    if (!sp.toString()) return;
    const set = (id: string, key: string) => {
      const el = document.getElementById(id) as HTMLSelectElement | HTMLInputElement | null;
      const v = sp.get(key);
      if (el && v) el.value = v;
    };
    const city = sp.get("city");
    if (city) {
      const cityEl = document.getElementById("city-select") as HTMLSelectElement | null;
      if (cityEl) { cityEl.value = city; updateDistrictOptions(city); }
    }
    set("district-select", "district");
    set("price-min",       "minPrice");
    set("price-max",       "maxPrice");
    set("total-price-min", "totalPriceMin");
    set("total-price-max", "totalPriceMax");
    set("area-min",        "areaMin");
    set("area-max",        "areaMax");
    set("building-type",   "buildingType");
    set("date-from",       "dateFrom");
    set("date-to",         "dateTo");
    set("address-search",  "address");
    set("mrt-walk-min",    "mrtWalkMin");
    set("build-age-range", "buildAgeRange");
    const post921Val = sp.get("post921");
    if (post921Val === "1") {
      const post921El = document.getElementById("post921-toggle") as HTMLInputElement | null;
      if (post921El) post921El.checked = true;
    }
    if (sp.get("address")) addressClearBtn.style.display = "block";
  }

  // Search button: push hash to history (so back button navigates between searches).
  // Guard against duplicate history entries: compare relative path+hash to avoid
  // the relative-vs-absolute mismatch of location.href (which is always absolute).
  document.getElementById("search-btn")?.addEventListener("click", () => {
    const qs = new URLSearchParams(getHashParams()).toString();
    const target = qs ? `${location.pathname}#${qs}` : location.pathname;
    const current = location.pathname + location.hash;
    if (target !== current) history.pushState(null, "", target);
  });

  // Reset button
  document.getElementById("reset-btn")?.addEventListener("click", () => {
    (document.getElementById("city-select")     as HTMLSelectElement).value = "";
    (document.getElementById("district-select")  as HTMLSelectElement).value = "";
    (document.getElementById("price-min")        as HTMLInputElement).value  = "";
    (document.getElementById("price-max")        as HTMLInputElement).value  = "";
    (document.getElementById("total-price-min") as HTMLInputElement).value  = "";
    (document.getElementById("total-price-max") as HTMLInputElement).value  = "";
    (document.getElementById("area-min") as HTMLInputElement).value = "";
    (document.getElementById("area-max") as HTMLInputElement).value = "";
    (document.getElementById("building-type")    as HTMLSelectElement).value = "";
    (document.getElementById("date-from") as HTMLInputElement).value = "";
    (document.getElementById("date-to")   as HTMLInputElement).value = "";
    (document.getElementById("address-search") as HTMLInputElement).value = "";
    addressClearBtn.style.display = "none";
    (document.getElementById("mrt-walk-min") as HTMLSelectElement).value = "";
    (document.getElementById("build-age-range") as HTMLSelectElement).value = "";
    (document.getElementById("post921-toggle") as HTMLInputElement).checked = false;
    // Hide MRT layer toggle row on reset and restore checkbox default state
    const mrtToggleRow = document.getElementById("mrt-layer-toggle-row");
    if (mrtToggleRow) mrtToggleRow.style.display = "none";
    const mrtLayerToggle = document.getElementById("mrt-layer-toggle") as HTMLInputElement | null;
    if (mrtLayerToggle) mrtLayerToggle.checked = true;
    document.dispatchEvent(new CustomEvent("mrt-filter-reset"));
    // Reset district options
    updateDistrictOptions("");
    // Reset preset active state
    document.querySelectorAll(".preset-btn").forEach(b => b.classList.remove("active"));
    document.querySelector('.preset-btn[data-months="0"]')?.classList.add("active");
    // Clear URL hash (search button click below will also push clean state)
    history.replaceState(null, "", location.pathname);
    document.getElementById("search-btn")?.click();
  });

  // Date preset buttons
  document.querySelectorAll(".preset-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      // Mark active
      document.querySelectorAll(".preset-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      const months = Number((btn as HTMLButtonElement).dataset.months ?? "0");
      const dateFromEl = document.getElementById("date-from") as HTMLInputElement;
      const dateToEl   = document.getElementById("date-to")   as HTMLInputElement;

      if (months === 0) {
        // "全部" — clear both date inputs
        dateFromEl.value = "";
        dateToEl.value   = "";
      } else {
        // Compute dateFrom = today minus N months
        const to   = new Date();
        const from = new Date();
        from.setMonth(from.getMonth() - months);
        const fmt = (d: Date) => d.toISOString().slice(0, 10);
        dateFromEl.value = fmt(from);
        dateToEl.value   = fmt(to);
      }
      // Trigger search (also updates hash via search-btn click listener)
      updateHash(); // Capture date values immediately for "複製連結" before Search fires
      document.getElementById("search-btn")?.click();
    });
  });

  // Clear preset active state when date inputs are manually changed
  ["date-from", "date-to"].forEach((id) => {
    document.getElementById(id)?.addEventListener("change", () => {
      document.querySelectorAll(".preset-btn").forEach(b => b.classList.remove("active"));
      // Mark "全部" active if both are empty
      const df = (document.getElementById("date-from") as HTMLInputElement)?.value;
      const dt = (document.getElementById("date-to")   as HTMLInputElement)?.value;
      if (!df && !dt) {
        document.querySelector('.preset-btn[data-months="0"]')?.classList.add("active");
      }
    });
  });

  // ---- Mobile sidebar toggle ----
  const sidebar  = document.querySelector(".sidebar")         as HTMLElement | null;
  const backdrop = document.getElementById("sidebar-backdrop") as HTMLElement | null;

  function openSidebar()  {
    sidebar?.classList.add("open");
    backdrop?.classList.add("open");
    document.body.style.overflow = "hidden";
  }
  function closeSidebar() {
    sidebar?.classList.remove("open");
    backdrop?.classList.remove("open");
    document.body.style.overflow = "";
  }

  document.getElementById("filter-toggle-btn")?.addEventListener("click", openSidebar);
  document.getElementById("sidebar-close-btn")?.addEventListener("click", closeSidebar);
  backdrop?.addEventListener("click", closeSidebar);

  // ---- On load: restore from URL hash (preferred) or query string (legacy) ----
  const _hashRestored = loadFromHash();
  if (!_hashRestored) loadFromUrl(); // Legacy query-string fallback for old bookmarks
  if (_hashRestored || location.search) {
    setTimeout(() => document.getElementById("search-btn")?.click(), 800);
  }

  // Apply overlay toggle state once map layers are confirmed ready.
  // Snapshot the raw hash NOW so the deferred handler sees the original page-load
  // URL, not a later edit by real-time updateHash() calls.
  // Use a one-shot event + timeout fallback to guard against:
  //   (a) map init failure — event never fires
  //   (b) event fires before listener attaches (unlikely but possible on very fast maps)
  if (_hashRestored) {
    const _initialHashRaw = location.hash.startsWith("#") ? location.hash.slice(1) : "";
    let _overlayApplied = false;
    const _applyOverlayOnce = () => {
      if (_overlayApplied) return;
      _overlayApplied = true;
      applyOverlayStateFromHash(_initialHashRaw);
    };
    document.addEventListener("map-layers-ready", _applyOverlayOnce, { once: true });
    // Fallback: after 3s, attempt overlay restore regardless of map-layers-ready.
    // If layers aren't registered yet, the change-event handlers will bail gracefully.
    setTimeout(_applyOverlayOnce, 3000);
  }

  /**
   * Reset all filter form fields to their default (empty) state.
   * Used before applying a popstate hash so stale filter values don't stick.
   * Intentionally does NOT touch overlay checkboxes — applyOverlayStateFromHash()
   * owns overlay state and needs the pre-popstate checkbox values to compute
   * correct ON→OFF and OFF→ON map-layer transitions.
   */
  function _resetFormFields(): void {
    const clearInputs = ["city-select","district-select","price-min","price-max",
      "total-price-min","total-price-max","area-min","area-max","building-type",
      "build-age-range","date-from","date-to","address-search","mrt-walk-min"];
    for (const id of clearInputs) {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = "";
    }
    const post921El = document.getElementById("post921-toggle") as HTMLInputElement | null;
    if (post921El) post921El.checked = false;
    if (addressClearBtn) addressClearBtn.style.display = "none";
    updateDistrictOptions("");
  }

  // ---- Back/forward navigation: rehydrate filters + re-run search ----
  window.addEventListener("popstate", () => {
    // Reset data filters so absent-from-hash keys clear their controls.
    _resetFormFields();
    const restored = loadFromHash();
    if (!restored) loadFromUrl();
    document.getElementById("search-btn")?.click();
    // Always apply overlay state (even for empty-hash URLs so active overlays
    // are correctly turned OFF when navigating back to a non-overlay state).
    const _popRaw = location.hash.startsWith("#") ? location.hash.slice(1) : "";
    applyOverlayStateFromHash(_popRaw);
  });

  // ---- Real-time hash updates as filters change ----
  // Selects: update hash immediately on change
  for (const _id of ["city-select", "district-select", "building-type", "build-age-range", "mrt-walk-min"]) {
    document.getElementById(_id)?.addEventListener("change", updateHash);
  }
  // Text / number inputs: debounced to avoid flooding replaceState on every keystroke
  let _hashDebounceTimer: ReturnType<typeof setTimeout> | null = null;
  const _debouncedHashUpdate = () => {
    if (_hashDebounceTimer !== null) clearTimeout(_hashDebounceTimer);
    _hashDebounceTimer = setTimeout(updateHash, 400);
  };
  for (const _id of ["price-min", "price-max", "total-price-min", "total-price-max", "area-min", "area-max", "address-search"]) {
    document.getElementById(_id)?.addEventListener("input", _debouncedHashUpdate);
    document.getElementById(_id)?.addEventListener("change", _debouncedHashUpdate);
  }
  // Date inputs: update hash on change (change fires on blur / picker select)
  for (const _id of ["date-from", "date-to"]) {
    document.getElementById(_id)?.addEventListener("change", updateHash);
  }
  // Checkboxes: update hash immediately
  for (const _id of ["post921-toggle", "choropleth-toggle", "buyer-score-toggle", "volatility-toggle", "mrt-premium-toggle", "completion-overlay-toggle"]) {
    document.getElementById(_id)?.addEventListener("change", updateHash);
  }

  // ============================================================
  // ---- Budget Calculator -------------------------------------
  // ============================================================

  const budgetTotalInput = document.getElementById("budget-total") as HTMLInputElement;
  const budgetPingInput = document.getElementById("budget-ping") as HTMLInputElement;
  const budgetResultDiv = document.getElementById("budget-result") as HTMLDivElement;
  const maxUnitPriceSpan = document.getElementById("max-unit-price") as HTMLSpanElement;
  const affordableDistrictsP = document.getElementById("affordable-districts") as HTMLParagraphElement;

  function calculateBudget(): void {
    const total = parseFloat(budgetTotalInput.value);
    const ping = parseFloat(budgetPingInput.value);
    
    if (!total || !ping || ping <= 0) {
      budgetResultDiv.style.display = "none";
      document.dispatchEvent(new CustomEvent("budget-threshold-changed", { detail: { thresholdWan: undefined } }));
      return;
    }

    const maxUnitPrice = total / ping;
    maxUnitPriceSpan.textContent = maxUnitPrice.toFixed(1);
    budgetResultDiv.style.display = "block";

    // Show affordable districts hint (no actual filtering yet, just a note)
    const citySelect = document.getElementById("city-select") as HTMLSelectElement;
    if (citySelect.value) {
      affordableDistrictsP.textContent = `提示：在篩選中選擇 ${citySelect.value}，使用「單價上限 ${maxUnitPrice.toFixed(1)} 萬/坪」來搜尋符合預算的房源。`;
    } else {
      affordableDistrictsP.textContent = "提示：先選擇縣市，再使用「單價」篩選來查看符合預算的區域。";
    }

    // Notify histogram renderer to show affordability threshold line
    document.dispatchEvent(new CustomEvent("budget-threshold-changed", { detail: { thresholdWan: maxUnitPrice } }));
  }

  budgetTotalInput?.addEventListener("input", calculateBudget);
  budgetPingInput?.addEventListener("input", calculateBudget);

  // ---- Affordability Map Toggle ----
  const affordabilityToggle = document.getElementById("affordability-toggle") as HTMLInputElement;
  
  function updateAffordabilityMode(): void {
    const total = parseFloat(budgetTotalInput.value);
    const ping = parseFloat(budgetPingInput.value);
    const enabled = affordabilityToggle?.checked ?? false;
    
    if (enabled && total > 0 && ping > 0) {
      // Convert total budget from 萬 to TWD (×10000), then calc max unit price
      const maxUnitPricePerPing = (total * 10000) / ping;
      document.dispatchEvent(new CustomEvent("affordability-mode-change", {
        detail: { enabled: true, maxUnitPricePerPing, totalBudget: total, desiredPing: ping },
      }));
    } else {
      document.dispatchEvent(new CustomEvent("affordability-mode-change", {
        detail: { enabled: false },
      }));
    }
  }
  
  affordabilityToggle?.addEventListener("change", updateAffordabilityMode);
  budgetTotalInput?.addEventListener("input", () => {
    if (affordabilityToggle?.checked) updateAffordabilityMode();
  });
  budgetPingInput?.addEventListener("input", () => {
    if (affordabilityToggle?.checked) updateAffordabilityMode();
  });

  // ============================================================
  // ---- Mortgage Calculator -----------------------------------
  // ============================================================

  const mortgageTotalInput = document.getElementById("mortgage-total") as HTMLInputElement;
  const mortgageDownInput = document.getElementById("mortgage-down") as HTMLInputElement;
  const mortgageYearsSelect = document.getElementById("mortgage-years") as HTMLSelectElement;
  const mortgageRateInput = document.getElementById("mortgage-rate") as HTMLInputElement;
  const mortgageResultDiv = document.getElementById("mortgage-result") as HTMLDivElement;
  const loanAmountSpan = document.getElementById("loan-amount") as HTMLSpanElement;
  const monthlyPaymentSpan = document.getElementById("monthly-payment") as HTMLSpanElement;
  const totalPaymentSpan = document.getElementById("total-payment") as HTMLSpanElement;

  function calculateMortgage(): void {
    const totalPrice = parseFloat(mortgageTotalInput.value); // 萬
    const downPercent = parseFloat(mortgageDownInput.value);
    const years = parseInt(mortgageYearsSelect.value);
    const ratePercent = parseFloat(mortgageRateInput.value);

    if (!totalPrice || !downPercent || !years || !ratePercent) {
      mortgageResultDiv.style.display = "none";
      return;
    }

    // Calculate loan amount (萬)
    const loanAmount = totalPrice * (1 - downPercent / 100);
    loanAmountSpan.textContent = loanAmount.toFixed(0);

    // Monthly interest rate (decimal)
    const monthlyRate = ratePercent / 100 / 12;
    const numPayments = years * 12;

    // Monthly payment formula: P * [r(1+r)^n] / [(1+r)^n - 1]
    const monthlyPayment = (loanAmount * 10000) * 
      (monthlyRate * Math.pow(1 + monthlyRate, numPayments)) / 
      (Math.pow(1 + monthlyRate, numPayments) - 1);

    monthlyPaymentSpan.textContent = monthlyPayment.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ",");

    // Total payment over loan period
    const totalPayment = (monthlyPayment * numPayments) / 10000;
    totalPaymentSpan.textContent = totalPayment.toFixed(0);

    mortgageResultDiv.style.display = "block";
  }

  mortgageTotalInput?.addEventListener("input", calculateMortgage);
  mortgageDownInput?.addEventListener("input", calculateMortgage);
  mortgageYearsSelect?.addEventListener("change", calculateMortgage);
  mortgageRateInput?.addEventListener("input", calculateMortgage);

  // ============================================================
  // ---- 青安利率到期影響試算 (Rate Sensitivity Panel) -----------
  // ============================================================

  const QINGAN_RATE = 1.775; // fixed 青安 rate %
  // Use August 1 00:00 as deadline boundary so the CTA is visible for all of July 31
  // Use explicit UTC offset for Taiwan (UTC+8): CTA hides after 2026-07-31 23:59 TST
  const DEADLINE_DATE = new Date("2026-08-01T00:00:00+08:00");

  const qinganToggle = document.getElementById("qingan-compare-toggle") as HTMLButtonElement;
  const qinganPanel = document.getElementById("qingan-compare-panel") as HTMLDivElement;
  const qinganBody = document.getElementById("qingan-compare-body") as HTMLDivElement;
  const qinganHint = document.getElementById("qingan-compare-hint") as HTMLParagraphElement;
  const qinganPostRateInput = document.getElementById("qingan-post-rate") as HTMLInputElement;

  function computeMonthlyPayment(loanWan: number, ratePercent: number, years: number): number {
    if (ratePercent <= 0 || loanWan <= 0 || years <= 0) return 0;
    const r = ratePercent / 100 / 12;
    const n = years * 12;
    return loanWan * 10000 * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
  }

  function formatTWD(amount: number): string {
    return Math.round(amount).toLocaleString("zh-TW") + " 元";
  }

  function formatWan(amount: number): string {
    return Math.abs(amount / 10000).toFixed(0) + " 萬";
  }

  function updateQinganDeadlineCta(): void {
    const ctaEl = document.getElementById("qingan-deadline-cta") as HTMLDivElement | null;
    if (!ctaEl) return;
    const now = new Date();
    // Hide CTA after the deadline
    ctaEl.style.display = now > DEADLINE_DATE ? "none" : "block";
  }

  function calculateQinganCompare(): void {
    if (!qinganBody || !qinganHint) return;
    // Skip computation when panel is hidden to avoid unnecessary DOM updates
    if (qinganPanel?.style.display === "none") return;

    const totalPrice = parseFloat(mortgageTotalInput?.value ?? "");
    const downPercent = parseFloat(mortgageDownInput?.value ?? "");
    const years = parseInt(mortgageYearsSelect?.value ?? "30", 10);
    // Guard: parseFloat returns NaN for blank/invalid input; fall back to default 2.5%.
    // Use ?? "" so null element path is also handled (postRate <= 0 guard below catches NaN).
    const postRate = parseFloat(qinganPostRateInput?.value ?? "") || 2.5;

    const qcPostRateDisplay = document.getElementById("qc-post-rate-display") as HTMLTableCellElement;
    if (qcPostRateDisplay) qcPostRateDisplay.textContent = `${postRate}%`;

    // Require a positive total price and valid years; down payment of 0 and post rate of 0 are
    // technically valid inputs but 0 post-rate causes divide-by-zero, so guard with > 0.
    if (!Number.isFinite(totalPrice) || totalPrice <= 0 ||
        !Number.isFinite(downPercent) || downPercent < 0 ||
        !Number.isFinite(years) || years <= 0 ||
        !Number.isFinite(postRate) || postRate <= 0) {
      qinganBody.style.display = "none";
      qinganHint.style.display = "block";
      return;
    }

    const loanWan = totalPrice * (1 - downPercent / 100);
    if (loanWan <= 0) {
      qinganBody.style.display = "none";
      qinganHint.style.display = "block";
      return;
    }

    // 青安 rate calculations (always use 1.775%, ignore rate input for comparison)
    const monthlyQingan = computeMonthlyPayment(loanWan, QINGAN_RATE, years);
    const totalInterestQingan = monthlyQingan * years * 12 - loanWan * 10000;

    // Post-phase-out rate calculations
    const monthlyPost = computeMonthlyPayment(loanWan, postRate, years);
    const totalInterestPost = monthlyPost * years * 12 - loanWan * 10000;

    // Fill in table
    const qcMonthlyQingan = document.getElementById("qc-monthly-qingan") as HTMLTableCellElement;
    const qcMonthlyPost = document.getElementById("qc-monthly-post") as HTMLTableCellElement;
    const qcInterestLabel = document.getElementById("qc-interest-label") as HTMLTableCellElement;
    const qcInterestQingan = document.getElementById("qc-interest-qingan") as HTMLTableCellElement;
    const qcInterestPost = document.getElementById("qc-interest-post") as HTMLTableCellElement;
    const qcDiff = document.getElementById("qc-diff") as HTMLTableCellElement;
    const diffRow = document.getElementById("qingan-diff-row") as HTMLTableRowElement;

    if (qcMonthlyQingan) qcMonthlyQingan.textContent = formatTWD(monthlyQingan);
    if (qcMonthlyPost) qcMonthlyPost.textContent = formatTWD(monthlyPost);
    if (qcInterestLabel) qcInterestLabel.textContent = `${years}年總利息`;
    if (qcInterestQingan) qcInterestQingan.textContent = formatWan(totalInterestQingan);
    if (qcInterestPost) qcInterestPost.textContent = formatWan(totalInterestPost);

    const monthlyDiff = monthlyPost - monthlyQingan;
    const totalInterestDiff = totalInterestPost - totalInterestQingan;
    // Round first, then take abs — avoids "+0 元/月" for tiny nonzero diffs
    const roundedDiff = Math.round(monthlyDiff);
    const absDiff = Math.abs(roundedDiff);

    if (qcDiff) {
      if (roundedDiff > 0) {
        qcDiff.textContent = `+${absDiff.toLocaleString("zh-TW")} 元/月（總利息多 ${formatWan(totalInterestDiff)}）`;
      } else if (roundedDiff < 0) {
        qcDiff.textContent = `−${absDiff.toLocaleString("zh-TW")} 元/月（總利息省 ${formatWan(totalInterestDiff)}）`;
      } else {
        qcDiff.textContent = "相同";
      }
    }

    // Highlight diff row: amber when post rate is slightly higher, red for large increase (≥5000/mo)
    if (diffRow) {
      diffRow.classList.remove("qingan-diff-amber", "qingan-diff-red");
      if (roundedDiff > 0) {
        diffRow.classList.add(roundedDiff >= 5000 ? "qingan-diff-red" : "qingan-diff-amber");
      }
    }

    qinganBody.style.display = "block";
    qinganHint.style.display = "none";
    updateQinganDeadlineCta();
  }

  qinganToggle?.addEventListener("click", () => {
    if (!qinganPanel) return;
    const isOpen = qinganPanel.style.display !== "none";
    qinganPanel.style.display = isOpen ? "none" : "block";
    qinganToggle.setAttribute("aria-expanded", String(!isOpen));
    qinganPanel.setAttribute("aria-hidden", String(isOpen));
    if (!isOpen) calculateQinganCompare();
  });

  // Recalculate comparison whenever mortgage inputs change
  mortgageTotalInput?.addEventListener("input", calculateQinganCompare);
  mortgageDownInput?.addEventListener("input", calculateQinganCompare);
  mortgageYearsSelect?.addEventListener("change", calculateQinganCompare);
  qinganPostRateInput?.addEventListener("input", calculateQinganCompare);
  // Triggered by banner CTA auto-open
  qinganPanel?.addEventListener("qingan-open", calculateQinganCompare);

  // ============================================================
  // ---- Down-Payment Timeline Calculator (issue #111) --------
  // ============================================================

  /** NT$ ↔ 萬 conversion helper (1 萬 = NT$10,000) */
  const wanToNTD = (w: number) => w * 10_000;

  const dptSavingsInput  = document.getElementById("dpt-savings")  as HTMLInputElement;
  const dptMonthlyInput  = document.getElementById("dpt-monthly")  as HTMLInputElement;
  const dptPriceInput    = document.getElementById("dpt-price")    as HTMLInputElement;
  const dptIncomeInput   = document.getElementById("dpt-income")   as HTMLInputElement;
  const dptPriceHint     = document.getElementById("dpt-price-hint")    as HTMLSpanElement;
  const dptResult        = document.getElementById("dpt-result")   as HTMLDivElement;
  const dptTiersEl       = document.getElementById("dpt-tiers")    as HTMLDivElement;
  const dptAffordEl      = document.getElementById("dpt-affordability") as HTMLDivElement;
  const dptPlaceholder   = document.getElementById("dpt-placeholder")  as HTMLParagraphElement;

  /** Last district name for the hint label */
  let dptAutoDistrictLabel: string = "";

  /**
   * Amortization monthly payment (matches computeMonthlyMortgagePayment in lib).
   * Inlined here to keep the panel self-contained without a dynamic import.
   */
  function dptMonthlyPayment(loanWan: number, ratePercent: number, years: number): number {
    if (loanWan <= 0 || years <= 0 || ratePercent < 0) return 0;
    const P = loanWan * 10_000;
    if (ratePercent === 0) return P / (years * 12);
    const r = ratePercent / 100 / 12;
    const n = years * 12;
    return P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
  }

  function dptFmtMonths(months: number): string {
    if (months === 0) return "已達標 ✓";
    if (!isFinite(months)) return "無法達成";
    if (months <= 24) return `${months} 個月`;
    return `約 ${(months / 12).toFixed(1)} 年`;
  }

  function dptMonthsToColor(months: number): "green" | "amber" | "red" {
    if (!isFinite(months) || months > 48) return "red";
    if (months > 24) return "amber";
    return "green";
  }

  function dptMonthsToGoal(savingsNTD: number, monthlyNTD: number, targetNTD: number): number {
    if (targetNTD <= 0) return 0;
    if (savingsNTD >= targetNTD) return 0;
    if (monthlyNTD <= 0) return Infinity;
    return Math.ceil((targetNTD - savingsNTD) / monthlyNTD);
  }

  function renderDptTier(
    pct: 5 | 10 | 20,
    savingsNTD: number,
    monthlyNTD: number,
    totalPriceWan: number,
    boostedMonthlyNTD: number
  ): string {
    const required = totalPriceWan * 10_000 * (pct / 100);
    const months = dptMonthsToGoal(savingsNTD, monthlyNTD, required);
    const boostedMonths = dptMonthsToGoal(savingsNTD, boostedMonthlyNTD, required);
    const color = dptMonthsToColor(months);
    const savedAlready = savingsNTD >= required;
    const progressPct = savedAlready
      ? 100
      : required > 0
        ? Math.min(99, Math.round((savingsNTD / required) * 100))
        : 0;

    const colorClass = `dpt-tier-${color}`;
    const requiredWan = Math.round(required / 10_000);
    const monthsLabel = dptFmtMonths(months);
    const sensLabel = isFinite(boostedMonths) && boostedMonths < months
      ? `（+5千/月可縮短至 ${dptFmtMonths(boostedMonths)}）`
      : "";

    return `
      <div class="dpt-tier ${colorClass}">
        <div class="dpt-tier-header">
          <span class="dpt-tier-pct">${pct}% 頭期款</span>
          <span class="dpt-tier-required">需 ${requiredWan.toLocaleString("zh-TW")} 萬</span>
        </div>
        <div class="dpt-tier-bar-wrap">
          <div class="dpt-tier-bar-track">
            <div class="dpt-tier-bar-fill dpt-fill-${color}" style="width:${progressPct}%"></div>
          </div>
        </div>
        <div class="dpt-tier-footer">
          <span class="dpt-tier-months">${monthsLabel}</span>
          ${sensLabel ? `<span class="dpt-tier-sens">${sensLabel}</span>` : ""}
        </div>
      </div>`;
  }

  function calculateDpt(): void {
    const savingsWan  = parseFloat(dptSavingsInput?.value ?? "");
    const monthlyWan  = parseFloat(dptMonthlyInput?.value ?? "");
    const priceWan    = parseFloat(dptPriceInput?.value ?? "");
    const incomeWan   = parseFloat(dptIncomeInput?.value ?? "");

    const hasInputs = Number.isFinite(savingsWan) && Number.isFinite(monthlyWan) && Number.isFinite(priceWan);

    if (!hasInputs || priceWan <= 0) {
      dptResult.style.display = "none";
      dptPlaceholder.style.display = "block";
      return;
    }

    const savingsNTD  = wanToNTD(savingsWan);
    const monthlyNTD  = wanToNTD(monthlyWan);
    const boostedNTD  = monthlyNTD + 5_000;
    const incomeNTD   = Number.isFinite(incomeWan) && incomeWan > 0 ? wanToNTD(incomeWan) : 0;

    // Render three tiers
    dptTiersEl.innerHTML =
      renderDptTier(5,  savingsNTD, monthlyNTD, priceWan, boostedNTD) +
      renderDptTier(10, savingsNTD, monthlyNTD, priceWan, boostedNTD) +
      renderDptTier(20, savingsNTD, monthlyNTD, priceWan, boostedNTD);

    // Affordability cliff check (based on 20% down, 2.5% rate, 30yr)
    if (incomeNTD > 0) {
      const loanWan    = priceWan * 0.8;
      const monthly    = dptMonthlyPayment(loanWan, 2.5, 30);
      const ratio      = monthly / incomeNTD;
      const overCliff  = ratio > 0.33;
      const formattedMonthly = Math.round(monthly).toLocaleString("zh-TW");
      const ratioPct   = Math.round(ratio * 100);
      const cliffClass = overCliff ? "dpt-cliff-warn" : "dpt-cliff-ok";
      const cliffIcon  = overCliff ? "⚠️" : "✅";
      dptAffordEl.innerHTML = `
        <div class="${cliffClass}">
          ${cliffIcon} 房貸占收入比：<strong>${ratioPct}%</strong>
          — 預估月付 ${formattedMonthly} 元（20%頭期、2.5%利率、30年）
          ${overCliff ? '<br><span class="dpt-cliff-note">超過建議上限 33%，財務壓力偏高</span>' : ""}
        </div>`;
      dptAffordEl.style.display = "block";
    } else {
      dptAffordEl.innerHTML = "";
      dptAffordEl.style.display = "none";
    }

    dptResult.style.display = "block";
    dptPlaceholder.style.display = "none";
  }

  dptSavingsInput?.addEventListener("input", calculateDpt);
  dptMonthlyInput?.addEventListener("input", calculateDpt);
  dptPriceInput?.addEventListener("input", calculateDpt);
  dptIncomeInput?.addEventListener("input", calculateDpt);

  // Auto-fill total price from district median when user selects a district on the map.
  // Listens to the same stats-histogram event used by the price histogram panel.
  // NOTE: pricesWan carries UNIT prices in 萬/坪 (元/坪 ÷ 10,000) — see Map.astro
  //       dispatch: `pricesWan: last12mPricesWan` where items are `unitPrice / 10000`.
  //       Median × 30坪 → suggested total price in 萬.
  let dptLastAutoDistrictKey: string = "";
  document.addEventListener("stats-histogram", (e: Event) => {
    const { pricesWan: rawPrices, district, city } = (e as CustomEvent<{ pricesWan?: number[]; district?: string; city?: string }>).detail;
    if (!rawPrices || rawPrices.length === 0) return;
    const finite = rawPrices.filter((p) => Number.isFinite(p) && p > 0);
    if (finite.length === 0) return;

    // Compute median unit price in 萬/坪
    const sorted = [...finite].sort((a, b) => a - b);
    const mid = Math.floor(sorted.length / 2);
    const medianUnitWan = sorted.length % 2 === 0
      ? (sorted[mid - 1]! + sorted[mid]!) / 2
      : sorted[mid]!;

    const newKey = `${city ?? ""}|${district ?? ""}`;
    dptAutoDistrictLabel = district ?? "";

    // Auto-fill suggested price when the field is empty; update hint on every district change
    const suggested = Math.round(medianUnitWan * 30);
    if (!dptPriceInput.value && suggested > 0) {
      dptPriceInput.value = String(suggested);
      calculateDpt();
    }
    dptLastAutoDistrictKey = newKey;

    // Update hint regardless
    if (dptPriceHint) {
      const label = dptAutoDistrictLabel ? `${dptAutoDistrictLabel} 中位單價 ${medianUnitWan.toFixed(1)} 萬/坪 × 30坪` : `中位單價 ${medianUnitWan.toFixed(1)} 萬/坪 × 30坪`;
      dptPriceHint.textContent = `≈ ${label}`;
    }
  });

  // ============================================================
  // ---- Acquisition Cost Calculator (issue #121) --------------
  // ============================================================

  const {
    computeAcquisitionCostSummary: computeAcqSummary,
    computeTotalUpfrontNTD: computeUpfront,
    formatNTD: fmtNTD,
    formatPct: fmtPct,
  } = await import("../lib/acquisitionCostUtils.js");

  const acqPriceInput   = document.getElementById("acq-price")   as HTMLInputElement;
  const acqPingInput    = document.getElementById("acq-ping")    as HTMLInputElement;
  const acqAgeInput     = document.getElementById("acq-age")     as HTMLInputElement;
  const acqDpInput      = document.getElementById("acq-dp")      as HTMLInputElement;
  const acqAgentChk     = document.getElementById("acq-agent")   as HTMLInputElement;
  const acqPriceHint    = document.getElementById("acq-price-hint") as HTMLSpanElement;
  const acqResult       = document.getElementById("acq-result")  as HTMLDivElement;
  const acqBodyEl       = document.getElementById("acq-breakdown-body") as HTMLTableSectionElement;
  const acqSummaryEl    = document.getElementById("acq-summary") as HTMLDivElement;
  const acqPlaceholder  = document.getElementById("acq-placeholder") as HTMLParagraphElement;

  function calculateAcq(): void {
    const priceWan = parseFloat(acqPriceInput?.value ?? "");
    const ping     = parseFloat(acqPingInput?.value  ?? "");
    const age      = parseFloat(acqAgeInput?.value   ?? "");
    const dpPct    = parseFloat(acqDpInput?.value    ?? "20");
    const includeAgent = acqAgentChk?.checked ?? true;

    if (!Number.isFinite(priceWan) || priceWan <= 0) {
      acqResult.style.display = "none";
      acqPlaceholder.style.display = "block";
      return;
    }

    const priceNTD   = priceWan * 10_000;
    // If ping is missing treat as 0 — renovation shows "請輸入坪數"
    const safePing   = Number.isFinite(ping) && ping > 0 ? ping : 0;
    // Age defaults to 0 (new building rate) when not provided — valid assumption
    const safeAge    = Number.isFinite(age)  && age  >= 0 ? age  : 0;
    const safeDpPct  = Number.isFinite(dpPct) && dpPct >= 0 && dpPct <= 100 ? dpPct : 20;
    const missingPing = !Number.isFinite(ping) || ping <= 0;
    // Blank age defaults to 0 (new building, 3,000/坪) — flag for info note
    const ageIsBlank  = acqAgeInput.value.trim() === "";

    const result = computeAcqSummary(priceNTD, safePing, safeAge, includeAgent);

    // Render breakdown rows
    acqBodyEl.innerHTML = result.items.map((item) => {
      const isZero    = item.amountNTD === 0;
      const showNote  = item.key === "renovation" && missingPing;
      // Only apply zero style for genuinely zero amounts (not for the missing-ping text note)
      const labelCls  = item.isOptional ? "acq-item-label acq-item-optional" : "acq-item-label";
      const amountCls = isZero && !showNote ? "acq-item-amount acq-item-zero" : "acq-item-amount";
      const amountTxt = showNote ? "請輸入坪數" : (isZero ? "—" : fmtNTD(item.amountNTD));
      return `<tr>
        <td class="${labelCls}">${item.label}</td>
        <td class="acq-item-rate">${item.rateDescription}</td>
        <td class="${amountCls}">${amountTxt}</td>
      </tr>`;
    }).join("");

    // Note when ping missing or age blank (default to new-building rate)
    const notes: string[] = [];
    if (missingPing) notes.push("請輸入坪數以計算裝修費");
    if (ageIsBlank)  notes.push("未輸入屋齡，以新成屋（3,000/坪）估算裝修費");
    const missingNote = notes.length
      ? `<p style="font-size:0.72rem;color:#b45309;margin:0 0 6px">ℹ ${notes.join("；")}</p>`
      : "";

    // Use Math.round for down payment to match computeTotalUpfrontNTD
    const dpNTD        = Math.round(priceNTD * safeDpPct / 100);
    const totalHidden  = result.totalHiddenCostsNTD;
    const hiddenPct    = result.hiddenCostsPct;
    const totalUpfront = computeUpfront(priceNTD, safeDpPct, totalHidden);

    acqSummaryEl.innerHTML = missingNote + `
      <div class="acq-summary-total-hidden">
        隱藏費用合計：${fmtNTD(totalHidden)}（${fmtPct(hiddenPct)} of 總價）
      </div>
      <div class="acq-summary-upfront">
        頭期款所需現金 = 頭期款 ${safeDpPct}%（${fmtNTD(dpNTD)}）＋ 隱藏費用（${fmtNTD(totalHidden)}）<br>
        <strong>合計：${fmtNTD(totalUpfront)}</strong>
      </div>
    `;

    acqPlaceholder.style.display = "none";
    acqResult.style.display = "block";
  }

  acqPriceInput?.addEventListener("input", calculateAcq);
  acqPingInput?.addEventListener("input", calculateAcq);
  acqAgeInput?.addEventListener("input", calculateAcq);
  acqDpInput?.addEventListener("input", calculateAcq);
  acqAgentChk?.addEventListener("change", calculateAcq);

  // Pre-fill from district click via stats-histogram event
  document.addEventListener("stats-histogram", (e: Event) => {
    const { pricesWan: rawPrices, district, medianBuildingAgeYears } =
      (e as CustomEvent<{ pricesWan?: number[]; district?: string; city?: string; medianBuildingAgeYears?: number | null }>).detail;
    if (!rawPrices || rawPrices.length === 0) return;
    const finite = rawPrices.filter((p) => Number.isFinite(p) && p > 0);
    if (finite.length === 0) return;

    const sorted = [...finite].sort((a, b) => a - b);
    const mid = Math.floor(sorted.length / 2);
    const medianUnitWan = sorted.length % 2 === 0
      ? (sorted[mid - 1]! + sorted[mid]!) / 2
      : sorted[mid]!;

    // When a specific district is provided (polygon click), always overwrite auto-fill fields
    // so repeated district clicks stay in sync. For non-district events (search results), use
    // one-shot fill (don't overwrite what the user has typed manually).
    const isDistrictClick = !!district;

    // Use current or default ping for suggested price
    const pingVal = parseFloat(acqPingInput?.value ?? "");
    const sizePing = Number.isFinite(pingVal) && pingVal > 0 ? pingVal : 30;
    const suggested = Math.round(medianUnitWan * sizePing);

    if ((isDistrictClick || !acqPriceInput.value) && suggested > 0) {
      acqPriceInput.value = String(suggested);
      // Update hint whenever price was (re-)auto-filled
      if (acqPriceHint) {
        const label = district
          ? `${district} 中位單價 ${medianUnitWan.toFixed(1)} 萬/坪 × ${sizePing}坪`
          : `中位單價 ${medianUnitWan.toFixed(1)} 萬/坪 × ${sizePing}坪`;
        acqPriceHint.textContent = `≈ ${label}`;
      }
    }

    // Pre-fill ping if empty
    if (!acqPingInput.value) {
      acqPingInput.value = String(sizePing);
    }

    // Pre-fill building age if available; always overwrite on district click
    if (typeof medianBuildingAgeYears === "number" && Number.isFinite(medianBuildingAgeYears)) {
      if (isDistrictClick || !acqAgeInput.value) {
        acqAgeInput.value = String(Math.round(medianBuildingAgeYears));
      }
    }

    calculateAcq();
  });

  // ============================================================
  // ---- Loan Program Comparator (issue #125) ------------------
  // ============================================================

  {
    // Inline the pure computation so there is no dynamic import needed (Astro define:vars limitation).
    // IMPORTANT: When updating rates/deadlines, update BOTH this inline copy AND loanProgramUtils.ts.
    // Display names here include emoji/suffixes for UI; keep IDs and rates in sync with loanProgramUtils.ts.

    interface _LoanProgram {
      id: string;
      name: string;
      ratePercent: number;
      termYears: number;
      eligibilityNote: string;
      deadlineDate: string | null;
      rateTBD: boolean;
    }

    const LPC_PROGRAMS: _LoanProgram[] = [
      { id: "qingan",       name: "🔴 青安貸款",     ratePercent: 1.775, termYears: 30, eligibilityNote: "首購族（資格審查）",    deadlineDate: "2026-07-31", rateTBD: false },
      { id: "general",      name: "一般房貸",          ratePercent: 2.35,  termYears: 30, eligibilityNote: "市場均值，各行庫不同",  deadlineDate: null,         rateTBD: false },
      { id: "civil-servant",name: "公教優惠貸款",      ratePercent: 1.36,  termYears: 30, eligibilityNote: "公務員 / 教師限定",    deadlineDate: null,         rateTBD: false },
      { id: "qingan2",      name: "新青安2.0（待定）", ratePercent: 0,     termYears: 30, eligibilityNote: "政策宣告中，細節待定",  deadlineDate: null,         rateTBD: true  },
    ];

    // Derive deadline from the qingan entry so updating deadlineDate in one place is enough
    const qinganEntry = LPC_PROGRAMS.find((p) => p.id === "qingan");
    const LPC_DEADLINE = qinganEntry?.deadlineDate
      ? new Date(`${qinganEntry.deadlineDate}T23:59:59+08:00`)
      : null;

    function lpcMonthly(principalNTD: number, ratePercent: number, termYears: number): number {
      if (!Number.isFinite(principalNTD) || principalNTD <= 0) return 0;
      if (!Number.isFinite(termYears) || termYears <= 0) return 0;
      if (!Number.isFinite(ratePercent) || ratePercent < 0) return 0;
      const n = termYears * 12;
      if (ratePercent === 0) return principalNTD / n;
      const r = ratePercent / 100 / 12;
      return principalNTD * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    }

    function lpcFmt(n: number): string {
      if (!Number.isFinite(n)) return "— 元";
      return Math.round(n).toLocaleString("zh-TW") + " 元";
    }
    function lpcFmtWan(n: number): string {
      if (!Number.isFinite(n)) return "— 萬";
      return (n / 10_000).toFixed(1) + " 萬";
    }

    /** Returns days remaining until program deadline; null if no deadline or already past. */
    function lpcDaysRemaining(deadlineDate: string | null): number | null {
      if (!deadlineDate) return null;
      // Require strict YYYY-MM-DD format
      if (!/^\d{4}-\d{2}-\d{2}$/.test(deadlineDate)) return null;
      // Round-trip check: reject impossible dates JS would normalize (e.g. 2026-02-30 → 2026-03-02)
      const parts = deadlineDate.split("-").map(Number);
      const [y, m, d] = parts as [number, number, number];
      const check = new Date(Date.UTC(y, m - 1, d));
      if (check.getUTCFullYear() !== y || check.getUTCMonth() + 1 !== m || check.getUTCDate() !== d) {
        return null;
      }
      const deadline = new Date(`${deadlineDate}T23:59:59+08:00`);
      if (isNaN(deadline.getTime())) return null;
      const diffMs = deadline.getTime() - Date.now();
      if (diffMs <= 0) return null;
      return Math.ceil(diffMs / (1000 * 60 * 60 * 24));
    }

    const lpcTotalInput     = document.getElementById("lpc-total")          as HTMLInputElement;
    const lpcPriceHint      = document.getElementById("lpc-price-hint")     as HTMLSpanElement;
    const lpcDownSlider     = document.getElementById("lpc-down")            as HTMLInputElement;
    const lpcDownDisplay    = document.getElementById("lpc-down-display")    as HTMLSpanElement;
    const lpcHideCivil      = document.getElementById("lpc-hide-civil")      as HTMLInputElement;
    const lpcResult         = document.getElementById("lpc-result")          as HTMLDivElement;
    const lpcTbody          = document.getElementById("lpc-tbody")           as HTMLTableSectionElement;
    const lpcPlaceholder    = document.getElementById("lpc-placeholder")     as HTMLParagraphElement;
    const lpcDeadlineBanner = document.getElementById("lpc-deadline-banner") as HTMLDivElement;
    const lpcDaysSpan       = document.getElementById("lpc-days-remaining")  as HTMLSpanElement;

    function lpcUpdateDeadlineBanner(): void {
      if (!LPC_DEADLINE || isNaN(LPC_DEADLINE.getTime()) || Date.now() >= LPC_DEADLINE.getTime()) {
        lpcDeadlineBanner.style.display = "none";
        return;
      }
      const diffMs = LPC_DEADLINE.getTime() - Date.now();
      const days = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
      lpcDaysSpan.textContent = String(days);
      lpcDeadlineBanner.style.display = "flex";
    }

    function lpcRender(): void {
      const priceWan = parseFloat(lpcTotalInput?.value ?? "");
      const downPct = parseInt(lpcDownSlider?.value ?? "20", 10);
      lpcDownDisplay.textContent = `${downPct}%`;

      if (!Number.isFinite(priceWan) || priceWan <= 0) {
        lpcResult.style.display = "none";
        lpcPlaceholder.style.display = "block";
        return;
      }

      const hideCivil = lpcHideCivil?.checked ?? false;
      const principalNTD = priceWan * 10_000 * ((100 - downPct) / 100);

      const rows = LPC_PROGRAMS
        .filter((p) => !(hideCivil && p.id === "civil-servant"))
        .map((p) => {
          const daysLeft = lpcDaysRemaining(p.deadlineDate);
          const isExpired = p.deadlineDate !== null && daysLeft === null;
          const monthly = p.rateTBD ? 0 : lpcMonthly(principalNTD, p.ratePercent, p.termYears);
          const totalPaid = monthly * p.termYears * 12;
          const totalInterest = Math.max(0, totalPaid - principalNTD);
          return { p, monthly, totalInterest, daysLeft, isExpired };
        });

      // Find cheapest non-TBD, non-expired program (first tie only, matching computeLoanComparison)
      const eligible = rows.filter((r) => !r.p.rateTBD && r.monthly > 0 && !r.isExpired);
      const minMonthly = eligible.length > 0 ? Math.min(...eligible.map((r) => r.monthly)) : -1;
      const cheapestId = eligible.find((r) => Math.abs(r.monthly - minMonthly) < 0.01)?.p.id ?? null;

      lpcTbody.innerHTML = "";
      for (const { p, monthly, totalInterest, daysLeft, isExpired } of rows) {
        const isCheapest = cheapestId !== null && p.id === cheapestId;
        const tr = document.createElement("tr");
        if (isCheapest) tr.classList.add("lpc-row-cheapest");
        if (isExpired) tr.classList.add("lpc-row-expired");

        const rateCell = p.rateTBD
          ? `<td class="lpc-rate">TBC</td>`
          : `<td class="lpc-rate">${p.ratePercent}%</td>`;

        const monthlyCell = p.rateTBD
          ? `<td class="lpc-monthly lpc-tbd">待定</td>`
          : `<td class="lpc-monthly">${lpcFmt(monthly)}${isCheapest ? ' <span class="lpc-badge">最優</span>' : ""}</td>`;

        const interestCell = p.rateTBD
          ? `<td class="lpc-interest lpc-tbd">—</td>`
          : `<td class="lpc-interest">${lpcFmtWan(totalInterest)}</td>`;

        let noteContent: string;
        if (isExpired) {
          noteContent = `<td class="lpc-note lpc-deadline">⚠️ 已截止 ${p.deadlineDate}</td>`;
        } else if (daysLeft !== null) {
          noteContent = `<td class="lpc-note lpc-deadline">⚠️ 截止 ${p.deadlineDate}（剩 ${daysLeft} 天）</td>`;
        } else {
          noteContent = `<td class="lpc-note">${p.eligibilityNote}</td>`;
        }

        tr.innerHTML = `<td class="lpc-name">${p.name}</td>${rateCell}${monthlyCell}${interestCell}${noteContent}`;
        lpcTbody.appendChild(tr);
      }

      lpcResult.style.display = "block";
      lpcPlaceholder.style.display = "none";
      lpcUpdateDeadlineBanner();
    }

    lpcTotalInput?.addEventListener("input", lpcRender);
    lpcDownSlider?.addEventListener("input", lpcRender);
    lpcHideCivil?.addEventListener("change", lpcRender);

    // Auto-fill from district click (same stats-histogram event used by acq calculator)
    document.addEventListener("stats-histogram", (e: Event) => {
      const { pricesWan: rawPrices, district } =
        (e as CustomEvent<{ pricesWan?: number[]; district?: string; city?: string }>).detail;
      if (!rawPrices || rawPrices.length === 0) return;
      const finite = rawPrices.filter((p: number) => Number.isFinite(p) && p > 0);
      if (finite.length === 0) return;
      const sorted = [...finite].sort((a: number, b: number) => a - b);
      const mid = Math.floor(sorted.length / 2);
      const medianUnitWan = sorted.length % 2 === 0
        ? (sorted[mid - 1]! + sorted[mid]!) / 2
        : sorted[mid]!;
      const sizePing = 30;
      const suggested = Math.round(medianUnitWan * sizePing);
      if (suggested > 0 && (!!district || !lpcTotalInput.value)) {
        lpcTotalInput.value = String(suggested);
        if (lpcPriceHint) {
          const label = district
            ? `${district} 中位單價 ${medianUnitWan.toFixed(1)} 萬/坪 × ${sizePing}坪`
            : `中位 ${medianUnitWan.toFixed(1)} 萬/坪 × ${sizePing}坪`;
          lpcPriceHint.textContent = `≈ ${label}`;
        }
        lpcRender();
      }
    });

    // Initial deadline banner check on load
    lpcUpdateDeadlineBanner();
    // Refresh banner + re-render table every hour to handle midnight/deadline crossing
    // (ensures expired programs lose their 最優 badge without requiring page reload)
    setInterval(() => {
      lpcUpdateDeadlineBanner();
      if (lpcResult.style.display !== "none") lpcRender();
    }, 60 * 60 * 1000);
  }

  // ============================================================
  // ---- Saved Search Feature ----------------------------------
  // ============================================================

  const SS_KEY = "realestate-radar-saved-searches";
  const LISTINGS_URL = `${import.meta.env.BASE_URL}data/sample-transactions.json`;

  interface SavedSearch {
    id: string;
    name: string;
    city?: string;
    district?: string;
    maxUnitPrice?: number;   // 萬/坪 (unit price)
    maxTotalPrice?: number;  // 萬 TWD (total price)
    buildingType?: string;
    created_at: string;
  }

  function ssGetAll(): SavedSearch[] {
    try { return JSON.parse(localStorage.getItem(SS_KEY) ?? "[]"); } catch { return []; }
  }

  function ssSaveAll(list: SavedSearch[]): void {
    localStorage.setItem(SS_KEY, JSON.stringify(list));
  }

  function ssDelete(id: string): void {
    ssSaveAll(ssGetAll().filter(s => s.id !== id));
    ssRender();
  }

  function ssApply(search: SavedSearch): void {
    // Reset all filters first
    (document.getElementById("city-select") as HTMLSelectElement).value = "";
    (document.getElementById("district-select") as HTMLSelectElement).value = "";
    (document.getElementById("price-min") as HTMLInputElement).value = "";
    (document.getElementById("price-max") as HTMLInputElement).value = "";
    (document.getElementById("total-price-min") as HTMLInputElement).value = "";
    (document.getElementById("total-price-max") as HTMLInputElement).value = "";
    (document.getElementById("area-min") as HTMLInputElement).value = "";
    (document.getElementById("area-max") as HTMLInputElement).value = "";
    (document.getElementById("building-type") as HTMLSelectElement).value = "";
    updateDistrictOptions("");

    if (search.city) {
      (document.getElementById("city-select") as HTMLSelectElement).value = search.city;
      updateDistrictOptions(search.city);
    }
    if (search.district) {
      (document.getElementById("district-select") as HTMLSelectElement).value = search.district;
    }
    if (search.maxUnitPrice) {
      (document.getElementById("price-max") as HTMLInputElement).value = String(search.maxUnitPrice);
    }
    if (search.maxTotalPrice) {
      (document.getElementById("total-price-max") as HTMLInputElement).value = String(search.maxTotalPrice);
    }
    if (search.buildingType) {
      (document.getElementById("building-type") as HTMLSelectElement).value = search.buildingType;
    }
    document.getElementById("search-btn")?.click();
    closeSidebar();
  }

  function ssRender(): void {
    const list = ssGetAll();
    const panel = document.getElementById("my-searches-panel") as HTMLDivElement | null;
    const listEl = document.getElementById("my-searches-list") as HTMLDivElement | null;
    const countEl = document.getElementById("ss-count") as HTMLSpanElement | null;
    if (!panel || !listEl) return;

    if (countEl) countEl.textContent = String(list.length);
    panel.style.display = list.length > 0 ? "block" : "none";

    listEl.innerHTML = "";
    for (const s of list) {
      const tags: string[] = [];
      if (s.city) tags.push(s.city);
      if (s.district) tags.push(s.district);
      if (s.maxTotalPrice) tags.push(`總價≤${s.maxTotalPrice}萬`);
      if (s.maxUnitPrice) tags.push(`單價≤${s.maxUnitPrice}萬/坪`);
      if (s.buildingType) tags.push(s.buildingType);

      const item = document.createElement("div");
      item.className = "ss-item";
      item.innerHTML = `
        <div class="ss-item-info">
          <div class="ss-item-name">${s.name}</div>
          <div class="ss-item-tags">${tags.map(t => `<span class="ss-tag">${t}</span>`).join("")}</div>
        </div>
        <div class="ss-item-actions">
          <button class="ss-apply-btn" title="套用此搜尋">套用</button>
          <button class="ss-del-btn" title="刪除">✕</button>
        </div>
      `;
      item.querySelector(".ss-apply-btn")?.addEventListener("click", () => ssApply(s));
      item.querySelector(".ss-del-btn")?.addEventListener("click", () => ssDelete(s.id));
      listEl.appendChild(item);
    }
  }

  // Save current filter state as a new saved search
  document.getElementById("save-search-btn")?.addEventListener("click", () => {
    const city         = (document.getElementById("city-select")      as HTMLSelectElement).value;
    const district     = (document.getElementById("district-select")   as HTMLSelectElement).value;
    const maxUnitPriceStr  = (document.getElementById("price-max")        as HTMLInputElement).value;
    const maxTotalPriceStr = (document.getElementById("total-price-max")  as HTMLInputElement).value;
    const buildingType = (document.getElementById("building-type")    as HTMLSelectElement).value;

    const parts: string[] = [];
    if (city) parts.push(city);
    if (district) parts.push(district);
    if (maxTotalPriceStr) parts.push(`≤${maxTotalPriceStr}萬`);
    if (buildingType) parts.push(buildingType);
    const suggestedName = parts.join(" ") || "我的搜尋";

    const name = prompt("為此搜尋條件命名：", suggestedName);
    if (name === null) return;

    const search: SavedSearch = {
      id: `ss-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
      name: name.trim() || suggestedName,
      ...(city && { city }),
      ...(district && { district }),
      ...(maxUnitPriceStr  && { maxUnitPrice:  Number(maxUnitPriceStr) }),
      ...(maxTotalPriceStr && { maxTotalPrice: Number(maxTotalPriceStr) }),
      ...(buildingType && { buildingType }),
      created_at: new Date().toISOString(),
    };

    ssSaveAll([...ssGetAll(), search]);
    ssRender();
  });

  // Share search button: copy current URL to clipboard
  const SHARE_BTN_LABEL = "📋 複製連結";
  document.getElementById("share-search-btn")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    // Guard against re-entry during success (2s) or error (3s) feedback windows
    if (btn.disabled) return;

    btn.disabled = true;
    const url = window.location.href;

    let copied = false;
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(url);
        copied = true;
      } catch {
        // fall through to execCommand
      }
    }
    if (!copied) {
      // execCommand fallback for older browsers
      const ta = document.createElement("textarea");
      ta.value = url;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      try { copied = document.execCommand("copy"); } catch { /* ignore */ }
      document.body.removeChild(ta);
    }

    btn.disabled = true;
    if (copied) {
      btn.textContent = "✓ 連結已複製";
      btn.classList.add("copied");
      setTimeout(() => {
        btn.textContent = SHARE_BTN_LABEL;
        btn.classList.remove("copied");
        btn.disabled = false;
      }, 2000);
    } else {
      // Both methods failed (e.g. non-HTTPS context) — surface URL for manual copy
      btn.disabled = false;
      prompt("請複製以下網址分享此搜尋：", url);
    }
  });

  // On page load: check how many listings match each saved search and show banner
  async function checkSavedSearchMatches(): Promise<void> {
    const searches = ssGetAll();
    if (searches.length === 0) return;

    let geojson: any;
    try {
      const res = await fetch(LISTINGS_URL);
      geojson = await res.json();
    } catch {
      return;
    }

    const features: any[] = geojson.features ?? [];
    const alerts: string[] = [];

    for (const s of searches) {
      const matches = features.filter((f: any) => {
        const p = f.properties;
        if (s.city         && p.city         !== s.city)                    return false;
        if (s.district     && p.district     !== s.district)                 return false;
        if (s.maxTotalPrice && p.totalPrice  > s.maxTotalPrice * 10000)     return false;
        if (s.maxUnitPrice  && p.unitPrice   > s.maxUnitPrice  * 10000)     return false;
        if (s.buildingType  && p.buildingType !== s.buildingType)            return false;
        return true;
      });
      if (matches.length > 0) {
        alerts.push(`<strong>${matches.length}</strong> 筆符合「${s.name}」`);
      }
    }

    const banner = document.getElementById("ss-alert-banner");
    if (!banner || alerts.length === 0) return;

    banner.innerHTML = `
      <div class="ss-alert-content">
        <span class="ss-alert-icon">🏠</span>
        <span>${alerts.join("；")}</span>
        <button class="ss-alert-close" aria-label="關閉">✕</button>
      </div>
    `;
    banner.style.display = "block";
    banner.querySelector(".ss-alert-close")?.addEventListener("click", () => {
      banner.style.display = "none";
    });
  }

  ssRender();
  checkSavedSearchMatches();
</script>


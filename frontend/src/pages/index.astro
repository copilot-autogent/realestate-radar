  // ── Price chart toggle: 箱型圖 | 折線圖 (issue #124) ──────────────────────
  (function setupPriceChartToggle() {
    const btnBox       = document.getElementById("btn-boxplot")       as HTMLButtonElement | null;
    const btnLine      = document.getElementById("btn-linechart")     as HTMLButtonElement | null;
    const linePanel    = document.getElementById("line-chart-panel")  as HTMLElement | null;
    const boxplotPanel = document.getElementById("boxplot-panel")     as HTMLElement | null;

    function showLine() {

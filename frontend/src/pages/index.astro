    color: #475569;
  }
  .smart-alt-price {
    font-weight: 600;
    color: #1e293b;
  }
  .smart-alt-mrt-badge {
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 0.72rem;
  }
  .smart-alt-mrt-walking { background: #dcfce7; color: #15803d; }
  .smart-alt-mrt-nearby  { background: #fef9c3; color: #854d0e; }
  .smart-alt-mrt-driving { background: #ffedd5; color: #9a3412; }
  .smart-alt-mrt-remote  { background: #fee2e2; color: #991b1b; }
  .smart-alt-mrt-none    { background: #f1f5f9; color: #64748b; }
  .smart-alt-focus-btn {
    font-size: 0.72rem;
    padding: 2px 8px;
    background: #2563eb;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s;
    margin-left: auto;
  }
  .smart-alt-focus-btn:hover {
    background: #1d4ed8;
  }

  /* ── Similar Districts panel (issue #141) ── */
  .similar-districts-panel {
    margin-top: 14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 14px;
  }
  .similar-districts-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #1e293b;
    margin: 0 0 8px;
  }
  .similar-districts-label {
    font-weight: 400;
    color: #64748b;
    margin-left: 6px;
    font-size: 0.82rem;
  }
  .similar-districts-insufficient {
    font-size: 0.8rem;
    color: #94a3b8;
    font-style: italic;
    padding: 6px 0;
  }
  .similar-districts-list {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .similar-district-item {
    border: 1px solid #f1f5f9;
    border-radius: 6px;
    padding: 8px 10px;
    background: #f8fafc;
  }
  .similar-district-item:hover {
    background: #f0f4ff;
    border-color: #c7d2fe;
  }
  .similar-district-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .similar-district-name {
    font-weight: 600;
    font-size: 0.85rem;
    color: #1e293b;
  }
  .similar-district-city {
    font-size: 0.75rem;
    color: #64748b;
    margin-left: 4px;
  }
  .similar-district-discount {
    font-size: 0.78rem;
    font-weight: 700;
    color: #16a34a;
    background: #dcfce7;
    border-radius: 4px;
    padding: 2px 6px;
  }
  .similar-district-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 0.75rem;
    color: #475569;
  }
  .similar-district-price {
    font-weight: 600;
    color: #1e293b;
  }
  .similar-district-score {
    background: #eff6ff;
    border-radius: 4px;
    padding: 1px 5px;
    color: #2563eb;
  }
  .similar-district-focus-btn {
    font-size: 0.72rem;
    padding: 2px 8px;
    background: #2563eb;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .similar-district-focus-btn:hover {
    background: #1d4ed8;
  }
  .similar-districts-city-toggle {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    color: #64748b;
    cursor: pointer;
    user-select: none;
  }
  .similar-districts-city-toggle input {
    margin: 0;
    cursor: pointer;
  }

  /* ── Transit panel (issue #144) ── */
  .transit-panel {
    margin-top: 14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 14px;
  }
  .transit-panel-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #334155;
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .transit-panel-label {
    font-size: 0.72rem;
    font-weight: 400;
    color: #64748b;
    margin-left: 4px;
  }
  .transit-panel-body {
    font-size: 0.82rem;
    color: #334155;
  }
  .transit-tier-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .transit-tier-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    gap: 4px;
  }
  .transit-tier-walking { color: #14532d; background: #dcfce7; border: 1px solid #86efac; }
  .transit-tier-nearby  { color: #713f12; background: #fef9c3; border: 1px solid #fde047; }
  .transit-tier-driving { color: #7c2d12; background: #fff7ed; border: 1px solid #fdba74; }
  .transit-tier-remote  { color: #7f1d1d; background: #fef2f2; border: 1px solid #fca5a5; }
  .transit-detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 3px 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: 0.79rem;
  }
  .transit-detail-row:last-child { border-bottom: none; }
  .transit-detail-label { color: #64748b; }
  .transit-detail-value { color: #1e293b; font-weight: 600; }
  .transit-no-mrt {
    color: #64748b;
    font-size: 0.8rem;
    font-style: italic;
    padding: 4px 0;
  }

  /* ── Completion wave panel ── */
  .completion-wave-panel {
    margin-top: 14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 14px;
  }
  .completion-wave-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .completion-wave-header h3 {
    font-size: 0.78rem;
    font-weight: 700;
    color: #334155;
    margin: 0;
  }
  .completion-wave-badge {
    font-size: 0.65rem;
    font-weight: 600;
    border-radius: 4px;
    padding: 2px 6px;
  }
  .projected-badge {
    background: #fef9c3;
    color: #854d0e;
    border: 1px solid #fde68a;
  }
  .completion-wave-desc {
    font-size: 0.72rem;
    color: #64748b;
    margin: 0 0 8px;
    line-height: 1.4;
  }
  .completion-city-select-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .completion-city-select-row label {
    font-size: 0.72rem;
    color: #475569;
    font-weight: 600;
    white-space: nowrap;
  }
  .completion-city-select-row select {
    font-size: 0.72rem;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 3px 6px;
    color: #334155;
    background: #f8fafc;
    flex: 1;
  }
  .completion-chart-wrap {
    position: relative;
    width: 100%;
    height: 200px;
  }
  .completion-chart-wrap canvas {
    width: 100% !important;
    height: 100% !important;
  }
  .completion-wave-note {
    font-size: 0.65rem;
    color: #94a3b8;
    margin: 6px 0 0;
    text-align: right;
  }

  /* ---- Buyer's-market messaging (issue #54) ---- */
  .buyers-market-tagline {
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f766e;
    margin: 2px 0 4px;
    letter-spacing: 0.01em;
  }
  .buyers-market-context {
    font-size: 0.75rem;
    color: #0f766e;
    margin: 0 0 8px;
    padding: 4px 8px;
    background: #f0fdfa;
    border-left: 3px solid #0d9488;
    border-radius: 4px;
  }

  /* ── Quarterly price sparkline panel (issue #159) ── */
  .quarterly-sparkline-panel {
    margin: 8px 0;
    padding: 10px 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
  }
  .quarterly-sparkline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    flex-wrap: wrap;
    gap: 4px;
  }
  .quarterly-sparkline-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: #475569;
    margin: 0;
  }
  .quarterly-yoy-badge {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 12px;
    letter-spacing: 0.01em;
  }
  .quarterly-yoy-badge.badge-green {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #86efac;
  }
  .quarterly-yoy-badge.badge-red {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid #fca5a5;
  }
  .quarterly-yoy-badge.badge-grey {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #cbd5e1;
  }
  .quarterly-sparkline-insufficient {
    font-size: 0.72rem;
    color: #94a3b8;
    text-align: center;
    padding: 8px 0;
  }
  #quarterly-sparkline-chart {
    display: block;
    max-width: 100%;
  }
  .quarterly-sparkline-note {
    font-size: 0.68rem;
    color: #94a3b8;
    margin: 4px 0 0;
    text-align: right;
  }
  .site-footer {
    padding: 12px 16px;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
    line-height: 1.5;
  }
  .site-footer a {
    color: #0d9488;
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }

  /* ── View mode toggle (map ↔ table) ── */
  .view-mode-toggle {
    position: fixed;
    bottom: 28px;
    right: 16px;
    z-index: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    background: #1e293b;
    color: #fff;
    border: none;
    border-radius: 24px;
    padding: 10px 18px;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(30,41,59,0.35);
    transition: background 0.15s;
  }
  .view-mode-toggle:hover { background: #0f172a; }
  .view-mode-toggle[aria-pressed="true"] { background: #2563eb; }
  .view-mode-toggle[aria-pressed="true"]:hover { background: #1d4ed8; }

  /* ── Table view container ── */
  .table-view-container {
    flex: 1;
    overflow: hidden;
    min-height: 0;
  }

  /* ── Scorecard container (hero view, #170) ── */
  .scorecard-container {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }

  /* ── Priority-Weights Panel (#172) ── */
  .pw-panel {
    flex-shrink: 0;
    background: #f8fafc;
    border-bottom: 2px solid #e2e8f0;
  }
  .pw-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px 8px;
    cursor: pointer;
  }
  .pw-panel-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e293b;
  }
  .pw-toggle-btn {
    background: none;
    border: none;
    font-size: 0.78rem;
    color: #64748b;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    transition: background 0.12s;
  }
  .pw-toggle-btn:hover { background: #e2e8f0; }
  .pw-panel-body {
    padding: 0 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pw-panel-body.pw-collapsed { display: none; }

  .pw-controls-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .pw-control-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 180px;
  }
  .pw-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #475569;
  }
  .pw-budget-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pw-budget-slider {
    flex: 1;
    accent-color: #2563eb;
    cursor: pointer;
  }
  .pw-budget-num-wrap {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .pw-budget-number {
    width: 72px;
    padding: 4px 6px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.82rem;
    text-align: right;
    background: #fff;
  }
  .pw-budget-unit {
    font-size: 0.78rem;
    color: #64748b;
  }
  .pw-select {
    padding: 5px 8px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.82rem;
    background: #fff;
    cursor: pointer;
    color: #1e293b;
  }

  .pw-weights-section {
    border-top: 1px solid #e2e8f0;
    padding-top: 8px;
  }
  .pw-weights-hint {
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 6px;
  }
  .pw-weights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 6px 16px;
  }
  .pw-weight-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pw-weight-label {
    font-size: 0.78rem;
    color: #475569;
    width: 72px;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .pw-weight-slider {
    flex: 1;
    accent-color: #7c3aed;
    cursor: pointer;
    min-width: 60px;
  }
  .pw-weight-val {
    font-size: 0.78rem;
    font-weight: 700;
    color: #7c3aed;
    width: 18px;
    text-align: right;
    flex-shrink: 0;
  }
  .pw-weights-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 6px;
  }
  .pw-reset-btn {
    padding: 4px 12px;
    background: #fff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.75rem;
    color: #64748b;
    cursor: pointer;
    transition: background 0.12s;
  }
  .pw-reset-btn:hover { background: #f1f5f9; }

  /* ── "Why" breakdown for each scorecard row ── */
  .sc-composite-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.78rem;
    font-weight: 700;
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    white-space: nowrap;
  }
  .sc-why-breakdown {
    width: 100%;
    margin-top: 4px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
  }
  .sc-why-dim {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .sc-why-dim-label {
    font-size: 0.68rem;
    color: #64748b;
    text-align: center;
    white-space: nowrap;
  }
  .sc-why-bar-wrap {
    width: 100%;
    height: 5px;
    background: #e2e8f0;
    border-radius: 3px;
    overflow: hidden;
  }
  .sc-why-bar {
    height: 100%;
    border-radius: 3px;
    transition: width 0.3s ease;
  }
  .sc-why-bar.dim-high { background: #22c55e; }
  .sc-why-bar.dim-mid  { background: #f59e0b; }
  .sc-why-bar.dim-low  { background: #ef4444; }
  .sc-why-bar.dim-na   { background: #cbd5e1; width: 3px !important; }
  .sc-why-dim-val {
    font-size: 0.68rem;
    font-weight: 600;
    color: #475569;
  }


  .scorecard-wizard-cta {
    background: linear-gradient(135deg, #1a6b45 0%, #0d9488 100%);
    color: #fff;
    padding: 16px 24px;
    flex-shrink: 0;
  }
  .swc-body {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 900px;
  }
  .swc-icon { font-size: 2rem; flex-shrink: 0; }
  .swc-text { flex: 1; }
  .swc-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .swc-subtitle {
    font-size: 0.82rem;
    opacity: 0.88;
  }
  .scorecard-open-wizard-btn {
    padding: 10px 20px;
    background: #fff;
    color: #1a6b45;
    border: none;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }
  .scorecard-open-wizard-btn:hover { opacity: 0.88; }

  /* Results header bar (after wizard run) */
  .scorecard-results-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 24px;
    background: #f0fdf4;
    border-bottom: 1px solid #bbf7d0;
    flex-shrink: 0;
    gap: 12px;
    flex-wrap: wrap;
  }
  .srb-desc {
    font-size: 0.85rem;
    color: #166534;
    font-weight: 600;
  }
  .scorecard-redo-btn {
    padding: 6px 14px;
    background: #fff;
    color: #1a6b45;
    border: 1.5px solid #1a6b45;
    border-radius: 16px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .scorecard-redo-btn:hover { background: #f0fdf4; }

  /* Ranked district list */
  .scorecard-district-list {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px;
  }
  .scorecard-loading-state {
    text-align: center;
    padding: 40px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Section label (e.g. "配對結果" vs "其他行政區") */
  .scorecard-section-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #64748b;
    padding: 8px 4px 4px;
    margin-top: 8px;
  }
  .scorecard-section-label:first-child { margin-top: 0; }

  /* District row card */
  .scorecard-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: box-shadow 0.15s, border-color 0.15s;
    flex-wrap: wrap;
  }
  .scorecard-row:hover {
    box-shadow: 0 2px 10px rgba(37,99,235,0.12);
    border-color: #93c5fd;
  }
  .scorecard-row.is-match {
    border-color: #4caf82;
    background: #f0fdf7;
  }
  .scorecard-row.is-match:hover {
    border-color: #1a6b45;
    box-shadow: 0 2px 10px rgba(26,107,69,0.16);
  }

  .sc-rank {
    font-size: 1.1rem;
    min-width: 32px;
    text-align: center;
    flex-shrink: 0;
  }
  .sc-name {
    flex: 1;
    min-width: 100px;
  }
  .sc-city {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 1px;
  }
  .sc-district {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }
  .sc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    flex: 2;
    min-width: 180px;
  }
  .sc-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 10px;
    background: #f1f5f9;
    color: #475569;
    white-space: nowrap;
  }
  .sc-badge.timing-high  { background: #f0fdf4; color: #15803d; }
  .sc-badge.timing-mid   { background: #fefce8; color: #92400e; }
  .sc-badge.timing-low   { background: #fff1f2; color: #be123c; }
  /* Facilities score badge tiers (#171) */
  .sc-badge.sc-badge-fac-excellent { background: #f0fdf4; color: #15803d; }
  .sc-badge.sc-badge-fac-good      { background: #fefce8; color: #854d0e; }
  .sc-badge.sc-badge-fac-fair      { background: #fff7ed; color: #9a3412; }
  .sc-badge.sc-badge-fac-poor      { background: #fef2f2; color: #991b1b; }
  /* Commute score badge (#171) */
  .sc-badge.sc-badge-commute { background: #eff6ff; color: #1d4ed8; }
  .sc-summary {
    font-size: 0.73rem;
    color: #64748b;
    flex-basis: 100%;
    padding-left: 42px;
    line-height: 1.4;
    margin-top: 2px;
  }
  .sc-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .sc-map-btn {
    padding: 6px 12px;

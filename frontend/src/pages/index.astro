---
import Layout from "../layouts/Layout.astro";
import Map from "../components/Map.astro";
import DistrictTable from "../components/DistrictTable.astro";
import { DATA_AS_OF } from "../generated/metadata.ts";

/** Sentinel value written by generate-metadata when no real data is available (dev/lint mode). */
const PLACEHOLDER_DATE = "1970-01-01";
const isPlaceholder = DATA_AS_OF === PLACEHOLDER_DATE;

/** Convert "YYYY-MM-DD" to "YYYY 年 QN（YYYY-MM-DD）". Returns input as-is on malformed dates. */
function formatDataAsOf(isoDate: string): string {
  const parts = isoDate.split("-").map(Number);
  const [year, month] = parts;
  if (!year || !month || isNaN(month) || month < 1 || month > 12) return isoDate;
  const quarter = Math.ceil(month / 3);
  return `${year} 年 Q${quarter}（${isoDate}）`;
}

const dataAsOfLabel = formatDataAsOf(DATA_AS_OF);

/**
 * True if DATA_AS_OF is more than 180 days before today (date-string comparison, UTC-safe).
 * Suppressed when DATA_AS_OF is the dev-mode placeholder (1970-01-01).
 * Note: isStale is computed at build time (SSG). The banner reflects the state when the
 * site was last deployed, not when each user loads the page.
 */
const isStale = !isPlaceholder && (() => {
  const cutoff = new Date();
  cutoff.setUTCDate(cutoff.getUTCDate() - 180);
  const cutoffStr = cutoff.toISOString().slice(0, 10);
  return DATA_AS_OF < cutoffStr;
})();

/** Year derived from DATA_AS_OF for buyer's-market copy. Null in dev/placeholder or on malformed date. */
const dataYear = (() => {
  if (isPlaceholder) return null;
  if (!/^\d{4}-\d{2}-\d{2}/.test(DATA_AS_OF)) return null;
  const y = Number(DATA_AS_OF.slice(0, 4));
  return isNaN(y) || y === 0 ? null : y;
})();

/** Show buyer's-market trend copy only when data is fresh and a valid year is known. */
const showBuyersMarket = !isStale && dataYear !== null;
---

<Layout title="實價登錄雷達 — Real Price Radar">
  {isStale && (
    <div class="stale-banner" role="alert">
      ⚠️ 資料已超過 6 個月。最新交易資訊請至<a href="https://lvr.land.moi.gov.tw/" target="_blank" rel="noopener">內政部實價登錄</a>查詢。
    </div>
  )}
  <header class="header">
    <h1>🏠 實價登錄雷達</h1>
    <p class="subtitle">台灣不動產實價資訊平台</p>
    {showBuyersMarket && <p class="buyers-market-tagline">📉 行情下行，掌握議價優勢</p>}
    <span class="data-freshness-badge" title={`資料來源最新交易日期：${DATA_AS_OF}`}>
      資料更新至 {dataAsOfLabel}
    </span>
  </header>

  <main class="main">
    <div id="sidebar-backdrop" class="sidebar-backdrop"></div>
    <aside class="sidebar">
      <button id="sidebar-close-btn" class="sidebar-close-btn" aria-label="關閉篩選">✕</button>

      <div class="filter-group">
        <label for="address-search">地址搜尋</label>
        <div class="search-input-wrapper">
          <input type="text" id="address-search" placeholder="輸入路名、地址關鍵字…" autocomplete="off" />
          <button id="address-clear-btn" class="input-clear-btn" aria-label="清除" style="display:none">✕</button>
        </div>
      </div>

      <div class="filter-group">
        <label for="city-select">縣市</label>
        <select id="city-select">
          <option value="">全部</option>
          <option value="台北市">台北市</option>
          <option value="新北市">新北市</option>
          <option value="桃園市">桃園市</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="district-select">鄉鎮市區</label>
        <select id="district-select">
          <option value="">全部</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="price-min">單價 (萬/坪)</label>
        <div class="range-inputs">
          <input type="number" id="price-min" placeholder="最低" aria-label="最低單價 (萬/坪)" />
          <span>~</span>
          <input type="number" id="price-max" placeholder="最高" aria-label="最高單價 (萬/坪)" />
        </div>
      </div>

      <div class="filter-group">
        <label for="total-price-min">總價 (萬)</label>
        <div class="range-inputs">
          <input type="number" id="total-price-min" placeholder="最低" min="0" aria-label="最低總價 (萬)" />
          <span>~</span>
          <input type="number" id="total-price-max" placeholder="最高" min="0" aria-label="最高總價 (萬)" />
        </div>
      </div>

      <div class="filter-group">
        <label for="area-min">坪數 (坪)</label>
        <div class="range-inputs">
          <input type="number" id="area-min" placeholder="最低" min="0" step="0.1" aria-label="最低坪數 (坪)" />
          <span>~</span>
          <input type="number" id="area-max" placeholder="最高" min="0" step="0.1" aria-label="最高坪數 (坪)" />
        </div>
      </div>

      <div class="filter-group">
        <label for="building-type">建物型態</label>
        <select id="building-type">
          <option value="">全部</option>
          <option value="住宅大樓">住宅大樓</option>
          <option value="華廈">華廈</option>
          <option value="公寓">公寓</option>
          <option value="透天厝">透天厝</option>
          <option value="套房">套房</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="build-age-range">屋齡範圍</label>
        <select id="build-age-range">
          <option value="">全部</option>
          <option value="0-5">0–5年（新屋）</option>
          <option value="5-20">5–20年</option>
          <option value="20-40">20–40年</option>
          <option value="40+">40年以上</option>
        </select>
      </div>

      <!-- 921後興建 toggle -->
      <div class="toggle-row">
        <input type="checkbox" id="post921-toggle" />
        <label for="post921-toggle">🏗️ 921後興建（2000年後完工）</label>
      </div>

      <div class="filter-group">
        <label>交易期間</label>
        <div class="date-presets">
          <button class="preset-btn active" data-months="0">全部</button>
          <button class="preset-btn" data-months="6">近半年</button>
          <button class="preset-btn" data-months="12">近1年</button>
          <button class="preset-btn" data-months="24">近2年</button>
        </div>
        <div class="range-inputs" style="margin-top:8px">
          <input type="date" id="date-from" aria-label="開始日期" />
          <span>~</span>
          <input type="date" id="date-to" aria-label="結束日期" />
        </div>
      </div>

      <div class="filter-group">
        <label for="mrt-walk-min">距捷運站步行</label>
        <select id="mrt-walk-min">
          <option value="">任意距離</option>
          <option value="5">5分鐘內 (~400m)</option>
          <option value="10">10分鐘內 (~800m)</option>
          <option value="15">15分鐘內 (~1200m)</option>
        </select>
      </div>


      <!-- Overlay toggle controls — kept in DOM for JS access; visually surfaced in IA sections below -->
      <div class="toggle-row ia-hidden-toggle" id="choropleth-toggle-row">
        <input type="checkbox" id="choropleth-toggle" checked />
        <label for="choropleth-toggle">顯示行政區熱力圖</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="completion-overlay-toggle-row">
        <input type="checkbox" id="completion-overlay-toggle" />
        <label for="completion-overlay-toggle">📦 完工供給強度</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="supply-pressure-toggle-row">
        <input type="checkbox" id="supply-pressure-toggle" />
        <label for="supply-pressure-toggle">⚠️ 供給壓力</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="buyer-score-toggle-row">
        <input type="checkbox" id="buyer-score-toggle" />
        <label for="buyer-score-toggle">🎯 顯示買方時機分</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="volatility-toggle-row">
        <input type="checkbox" id="volatility-toggle" />
        <label for="volatility-toggle">📊 顯示價格波動度</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="mrt-premium-toggle-row">
        <input type="checkbox" id="mrt-premium-toggle" />
        <label for="mrt-premium-toggle">🚇 捷運溢價熱力圖</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="mrt-tier-toggle-row">
        <input type="checkbox" id="mrt-tier-toggle" />
        <label for="mrt-tier-toggle">🚇 捷運距離評分地圖</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="presale-spread-toggle-row">
        <input type="checkbox" id="presale-spread-toggle" />
        <label for="presale-spread-toggle">🏗 預售溢價熱力圖</label>
      </div>
      <div class="toggle-row ia-hidden-toggle" id="affordability-overlay-row">
        <input type="checkbox" id="affordability-overlay" />
        <label for="affordability-overlay">🏠 首購族負擔能力地圖</label>
      </div>

      <!-- MRT stations layer toggle (shown when MRT filter active) -->
      <div class="toggle-row" id="mrt-layer-toggle-row" style="display:none">
        <input type="checkbox" id="mrt-layer-toggle" checked />
        <label for="mrt-layer-toggle">🚇 顯示捷運站圖示</label>
      </div>

      <!-- 首購族配對精靈 — persistent top-of-sidebar CTA -->
      <button id="wizard-reopen-btn" class="wizard-reopen-btn sidebar-wizard-cta">🧭 首購族配對精靈</button>

      <button id="search-btn" class="search-btn">搜尋</button>
      <button id="reset-btn" class="reset-btn">清除篩選</button>
      <button id="save-search-btn" class="save-search-btn">⭐ 儲存此搜尋</button>
      <button id="share-search-btn" type="button" class="share-search-btn">📋 複製連結</button>

      <div id="my-searches-panel" class="my-searches-panel" style="display:none">
        <div class="my-searches-header">⭐ 我的搜尋 (<span id="ss-count">0</span>)</div>
        <div id="my-searches-list" class="my-searches-list"></div>
      </div>

      <!-- District watchlist panel (issue #110) -->
      <div id="watchlist-panel" class="watchlist-panel" style="display:none">
        <div class="watchlist-header">
          ⭐ 關注行政區 (<span id="wl-count">0</span>/<span>3</span>)
        </div>
        <div id="watchlist-stale-notice" class="watchlist-stale-notice" style="display:none"></div>
        <div id="watchlist-list" class="watchlist-list"></div>
        <p class="watchlist-hint">點擊地圖行政區，按「⭐ 關注此行政區」可追蹤均價變動（最多 3 個）。</p>
      </div>

      <!-- IA Section 1: affordability (expanded) -->
      <div class="ia-section" id="ia-section-1">
        <button class="ia-section-header" aria-expanded="true" aria-controls="ia-section-1-body" id="ia-section-1-btn">
          <span class="ia-section-title">① 我能負擔嗎？</span>
          <span class="ia-section-chevron" aria-hidden="true">▲</span>
        </button>
        <div class="ia-section-body" id="ia-section-1-body">

          <!-- Budget Calculator -->
          <div id="budget-calculator" class="budget-calculator">
            <h3>💰 預算計算器</h3>
            <div class="calc-inputs">
              <div class="calc-input-row">
                <label for="budget-total">總預算 (萬)</label>
                <input type="number" id="budget-total" placeholder="例如: 1000" min="0" step="50" />
              </div>
              <div class="calc-input-row">
                <label for="budget-ping">坪數需求 (坪)</label>
                <input type="number" id="budget-ping" placeholder="例如: 30" min="0" step="1" />
              </div>
            </div>
            <div id="budget-result" class="budget-result" style="display:none">
              <p>您的單價上限：<strong id="max-unit-price">0</strong> 萬/坪</p>
              <p id="affordable-districts" class="affordable-districts"></p>
            </div>
            <div class="toggle-row" id="affordability-toggle-row" style="margin-top:10px">
              <input type="checkbox" id="affordability-toggle" />
              <label for="affordability-toggle">🗺️ 顯示可負擔性地圖</label>
            </div>
          </div>

          <!-- First-buyer affordability heat-map panel (issue #133) -->
          <div id="first-buyer-panel" class="first-buyer-panel" style="display:none">
            <h3>🏠 首購族負擔能力地圖</h3>
            <div class="calc-inputs">
              <div class="calc-input-row">
                <label for="fb-monthly-income">月收入 (萬)</label>
                <input type="number" id="fb-monthly-income" placeholder="例如: 8" min="0" step="0.5"
                  aria-label="月收入（萬元）" />
              </div>
              <div class="calc-input-row">
                <label for="fb-down-payment">頭期款 (萬)</label>
                <input type="number" id="fb-down-payment" placeholder="例如: 300" min="0" step="10"
                  aria-label="頭期款（萬元）" />
              </div>
            </div>
            <div id="fb-result" class="fb-result" style="display:none">
              <p>最高可負擔總價：<strong id="fb-max-affordable">0</strong> 萬</p>
              <div class="fb-legend">
                <span class="fb-tier-dot" style="background:#22c55e"></span>可負擔 (≥90%)
                <span class="fb-tier-dot" style="background:#eab308;margin-left:8px"></span>勉強可負擔 (60–90%)
              </div>
            </div>
            <button id="fb-reset-btn" class="fb-reset-btn" aria-label="清除負擔能力地圖">重設</button>
          </div>


          <!-- Affordability overlay toggle (contextual) -->
          <div class="ia-toggle-row">
            <div class="toggle-row" style="margin-top:4px">
              <input type="checkbox" id="affordability-overlay-s1"
                onchange="document.getElementById('affordability-overlay').checked=this.checked;document.getElementById('affordability-overlay').dispatchEvent(new Event('change'))" />
              <label for="affordability-overlay-s1">🏠 顯示首購族負擔能力地圖</label>
            </div>
          </div>

        </div><!-- /ia-section-1-body -->
      </div><!-- /ia-section-1 -->

      <!-- ═══════════════════════════════════════════════════════════
      <!-- IA Section 2: timing (expanded by default — issue #156: banner visible on load) -->
      <div class="ia-section" id="ia-section-2">
        <button class="ia-section-header" aria-expanded="true" aria-controls="ia-section-2-body" id="ia-section-2-btn">
          <span class="ia-section-title">② 現在是好時機嗎？</span>
          <span class="ia-section-chevron" aria-hidden="true">▲</span>
        </button>
        <div class="ia-section-body" id="ia-section-2-body">

          <!-- National timing summary banner (issue #156: visible before district selection) -->
          <div id="national-timing-banner" class="national-timing-banner" aria-label="全台灣時機摘要" aria-live="polite">
            <div class="national-timing-banner-header">
              <span id="national-timing-banner-title" class="national-timing-banner-title">📊 全台灣目前行情</span>
              <span id="national-timing-verdict-badge" class="national-timing-verdict-badge national-timing-verdict-loading">載入中…</span>
            </div>
            <div id="national-timing-summary-text" class="national-timing-summary-text"></div>
            <div id="national-timing-metrics" class="national-timing-metrics"></div>
          </div>

          <!-- Prominent buyer timing card (issue #153: surfaced from hidden checkbox) -->
          <div id="buyer-timing-card" class="buyer-timing-card" aria-label="買方時機分析">
            <div class="buyer-timing-card-header">
              <span class="buyer-timing-card-title">🎯 買方時機分</span>
              <span id="buyer-timing-badge" class="buyer-timing-badge buyer-timing-badge-empty">—</span>
            </div>
            <div id="buyer-timing-rationale" class="buyer-timing-rationale">選擇行政區以查看時機分析</div>
            <div class="toggle-row" style="margin-top:8px;margin-bottom:0">
              <input type="checkbox" id="buyer-score-toggle-s2"
                onchange="document.getElementById('buyer-score-toggle').checked=this.checked;document.getElementById('buyer-score-toggle').dispatchEvent(new Event('change'))" />
              <label for="buyer-score-toggle-s2">🗺️ 顯示地圖覆蓋層</label>
            </div>
          </div>

          <!-- Supply overlays -->
          <div class="ia-overlay-group">
            <p class="ia-overlay-label">供給壓力地圖</p>
            <div class="toggle-row">
              <input type="checkbox" id="supply-pressure-toggle-s2"
                onchange="document.getElementById('supply-pressure-toggle').checked=this.checked;document.getElementById('supply-pressure-toggle').dispatchEvent(new Event('change'))" />
              <label for="supply-pressure-toggle-s2">⚠️ 供給壓力</label>
            </div>
            <div class="toggle-row">
              <input type="checkbox" id="completion-overlay-toggle-s2"
                onchange="document.getElementById('completion-overlay-toggle').checked=this.checked;document.getElementById('completion-overlay-toggle').dispatchEvent(new Event('change'))" />
              <label for="completion-overlay-toggle-s2">📦 完工供給強度</label>
            </div>
          </div>

          <!-- Volume YoY Panel -->
          <div id="volume-yoy-panel" class="volume-yoy-panel" style="display:none">
            <div class="volume-yoy-header">
              <h3>📊 成交量年同比<span id="volume-yoy-district-label" class="volume-yoy-district-label"></span></h3>
              <div id="volume-yoy-badge" class="volume-yoy-badge" style="display:none"></div>
            </div>
            <p class="volume-yoy-desc">各季度成交量（本年 vs 去年）</p>
            <div id="volume-yoy-insufficient" class="volume-yoy-insufficient" style="display:none">資料不足</div>
            <div class="volume-yoy-chart-wrap">
              <canvas id="volume-yoy-chart" width="260" height="160" aria-label="季度成交量年同比條形圖"></canvas>
            </div>
            <div id="volume-yoy-delta-labels" class="volume-yoy-delta-labels"></div>
          </div>

          <!-- Seasonal panel -->
          <div id="seasonal-panel" class="seasonal-panel" style="display:none" aria-label="季節性成交規律面板">
            <h3>📅 季節性成交規律<span id="seasonal-district-label" class="seasonal-district-label"></span></h3>
            <!-- Buy-timing badge -->
            <div id="seasonal-tier-badge" class="seasonal-tier-badge" style="display:none" role="status" aria-live="polite"></div>
            <!-- Insufficient data guard -->
            <div id="seasonal-insufficient" class="seasonal-insufficient" style="display:none">資料不足（需 ≥3 年且 ≥12 個月歷史資料）</div>
            <!-- Monthly volume radar chart -->
            <p class="seasonal-note" id="seasonal-volume-label">月均成交量（歷年平均）</p>
            <canvas id="seasonal-chart" width="260" height="200" aria-label="月均成交量雷達圖" role="img"></canvas>
            <!-- Price seasonality index bar chart -->
            <p class="seasonal-note seasonal-price-label" id="seasonal-price-label">月中位價季節指數（100 = 年均）</p>
            <canvas id="seasonal-price-chart" width="260" height="120" aria-label="月中位價季節指數條形圖" role="img"></canvas>
            <div id="seasonal-summary" class="seasonal-summary" style="display:none"></div>
          </div>

          <!-- Monthly heatmap (issue #112) -->
          <div id="heatmap-panel" class="heatmap-panel" style="display:none">
            <div class="heatmap-header">
              <h3>🗓 月份成交量熱力圖</h3>
              <div class="heatmap-scope-toggle" role="group" aria-label="選擇範圍">
                <button id="heatmap-btn-district" class="heatmap-scope-btn active" data-scope="district">本區</button>
                <button id="heatmap-btn-global"   class="heatmap-scope-btn"        data-scope="global">全臺灣</button>
              </div>
            </div>
            <p class="heatmap-note">成交筆數 × 月份，顏色深淺 = 相對熱度。🔵 = 買方優勢月（量 &lt; 年高峰 70%）</p>
            <div id="heatmap-insufficient" class="heatmap-insufficient" style="display:none">資料不足（需 ≥12 個月歷史）</div>
            <canvas id="heatmap-canvas" class="heatmap-canvas" aria-label="月份成交量"></canvas>
            <div id="heatmap-tooltip" class="heatmap-tooltip" style="display:none"></div>
            <div id="heatmap-buyer-summary" class="heatmap-buyer-summary" style="display:none"></div>
          </div>

          <!-- Completion Wave Panel -->
          <div id="completion-wave-panel" class="completion-wave-panel">
            <div class="completion-wave-header">
              <h3>📦 建造完工供給波浪</h3>
              <span class="completion-wave-badge projected-badge">2026–2028 預測</span>
            </div>
            <p class="completion-wave-desc">
              各縣市季度使用執照核發數（建築完工）。2026–2028 為依建照推估之預測值。
            </p>
            <div class="completion-city-select-row">
              <label for="completion-city-select">縣市</label>
              <select id="completion-city-select">
                <option value="台北市">台北市</option>
                <option value="新北市">新北市</option>
                <option value="桃園市">桃園市</option>
              </select>
            </div>
            <div class="completion-chart-wrap">
              <canvas id="completion-wave-chart" width="260" height="200" aria-label="完工供給波浪圖"></canvas>
            </div>
            <p class="completion-wave-note" id="completion-wave-note">
              資料來源：內政部不動產資訊平台 E3030（示範資料）
            </p>
          </div>

        </div><!-- /ia-section-2-body -->
      </div><!-- /ia-section-2 -->

      <!-- IA Section 3: price fairness (collapsed) -->
      <div class="ia-section" id="ia-section-3">
        <button class="ia-section-header" aria-expanded="false" aria-controls="ia-section-3-body" id="ia-section-3-btn">
          <span class="ia-section-title">③ 這個價格合理嗎？</span>

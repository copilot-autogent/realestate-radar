  // ---- Price Histogram (vanilla SVG — no external dep) ----
  let currentPricesWan: number[] = [];
  let currentThresholdWan: number | undefined;
  let currentDistrictLabel: string = "";
  let currentDistrictKey: string = ""; // "city|district" for collision-safe equality check
  let histogramTargetPriceWan: number | undefined;

  function renderPriceHistogram(): void {
    const panel = document.getElementById("histogram-panel") as HTMLDivElement;
    const container = document.getElementById("histogram-svg-container") as HTMLDivElement;
    const insufficientEl = document.getElementById("histogram-insufficient") as HTMLDivElement;
    const percentileLabel = document.getElementById("histogram-percentile-label") as HTMLParagraphElement;
    const districtLabelEl = document.getElementById("histogram-district-label") as HTMLSpanElement;
    if (!panel || !container) return;

    // Filter to finite positive values only; guard against NaN propagation
    const prices = currentPricesWan.filter(p => Number.isFinite(p) && p > 0);
    if (!prices.length) {
      panel.style.display = "none";
      return;
    }
    panel.style.display = "block";

    // Update district label
    if (districtLabelEl) {
      districtLabelEl.textContent = currentDistrictLabel ? `— ${currentDistrictLabel}` : "";
    }

    // ≥10-tx data gate
    const MIN_TX = 10;
    if (prices.length < MIN_TX) {
      if (insufficientEl) insufficientEl.style.display = "block";
      container.innerHTML = "";
      if (percentileLabel) percentileLabel.textContent = "";
      return;
    }
    if (insufficientEl) insufficientEl.style.display = "none";

    const BIN = 5; // fixed 5万/坪 bin width
    // Clip to 2nd–98th percentile to prevent outliers from generating huge SVGs
    const s98 = [...prices].sort((a, b) => a - b);
    const p2  = s98[Math.max(0, Math.floor(s98.length * 0.02))];
    const p98 = s98[Math.min(s98.length - 1, Math.floor(s98.length * 0.98))];
    const lo0 = Math.floor(p2 / BIN) * BIN;
    // Ensure at least one bin even when all prices are the same exact BIN-multiple
    const hiEff = Math.max(Math.ceil(p98 / BIN) * BIN, lo0 + BIN);
    // Cap at 50 bins; recompute effective hi so threshold guard stays in-bounds
    const nBins = Math.min(50, Math.max(1, (hiEff - lo0) / BIN));
    const hi0 = lo0 + nBins * BIN;

    const bins = Array.from({ length: nBins }, (_, i) => ({
      lo: lo0 + i * BIN,
      hi: lo0 + (i + 1) * BIN,
      count: 0,
    }));
    for (const p of prices) {
      // Drop values outside the effective range (outliers excluded by percentile clip)
      if (p < lo0 || p > hi0) continue;
      const idx = Math.min(nBins - 1, Math.max(0, Math.floor((p - lo0) / BIN)));
      bins[idx].count++;
    }

    const maxCount = bins.reduce((a, b) => a > b.count ? a : b.count, 1);
    const W = 260, LPAD = 52, RPAD = 28, BAR_W = W - LPAD - RPAD;
    const ROW_H = 16, GAP = 2, TOP = 4;
    const H = TOP + nBins * (ROW_H + GAP);
    const thr = currentThresholdWan;
    const targetWan = histogramTargetPriceWan;

    const rows = bins.map(({ lo, hi, count }, i) => {
      const y = TOP + i * (ROW_H + GAP);
      const bw = Math.round((count / maxCount) * BAR_W);
      // Colour priority: target price overrides budget threshold colouring
      let fill: string;
      if (targetWan !== undefined) {
        fill = hi <= targetWan ? "#22c55e" : lo < targetWan ? "#f59e0b" : "#94a3b8";
      } else if (thr !== undefined) {
        fill = hi <= thr ? "#22c55e" : lo < thr ? "#f59e0b" : "#94a3b8";
      } else {
        fill = "#3b82f6";
      }
      const countLabel = count > 0
        ? `<text x="${LPAD + Math.max(bw, 2) + 3}" y="${ROW_H - 4}" font-size="9" fill="#475569">${count}</text>`
        : "";
      return `<g transform="translate(0,${y})"><text x="${LPAD - 4}" y="${ROW_H - 4}" text-anchor="end" font-size="9" fill="#64748b">${lo}–${hi}</text><rect x="${LPAD}" y="1" width="${Math.max(bw, count > 0 ? 2 : 0)}" height="${ROW_H - 2}" rx="2" fill="${fill}" opacity="0.85"><title>${count} 筆 (${lo}–${hi}萬/坪)</title></rect>${countLabel}</g>`;
    }).join("");

    let thrEl = "";
    // Show threshold line whenever it's within the displayed price range (inclusive)
    if (thr !== undefined && thr >= lo0 && thr <= hi0) {
      const ly = TOP + ((thr - lo0) / BIN) * (ROW_H + GAP);
      thrEl = `<line x1="${LPAD}" y1="${ly}" x2="${LPAD + BAR_W}" y2="${ly}" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4 3"/><text x="${LPAD + BAR_W - 2}" y="${ly - 2}" font-size="8" fill="#ef4444" text-anchor="end">預算 ${thr.toFixed(0)}萬</text>`;
    }

    // Target price marker line (blue dashed)
    let targetEl = "";
    if (targetWan !== undefined && targetWan >= lo0 && targetWan <= hi0) {
      const ly = TOP + ((targetWan - lo0) / BIN) * (ROW_H + GAP);
      targetEl = `<line x1="${LPAD}" y1="${ly}" x2="${LPAD + BAR_W}" y2="${ly}" stroke="#1d4ed8" stroke-width="1.5" stroke-dasharray="4 3"/><text x="${LPAD + BAR_W - 2}" y="${ly - 2}" font-size="8" fill="#1d4ed8" text-anchor="end">${targetWan.toFixed(0)}萬</text>`;
    }

    container.innerHTML = `<svg width="100%" viewBox="0 0 ${W} ${H}" style="display:block;overflow:visible">${rows}${thrEl}${targetEl}</svg>`;

    // Percentile label for target price
    if (percentileLabel) {
      if (targetWan !== undefined && Number.isFinite(targetWan) && targetWan > 0) {
        const sorted = [...prices].sort((a, b) => a - b);
        const below = sorted.filter(p => p < targetWan).length;      // strictly below
        const atOrBelow = sorted.filter(p => p <= targetWan).length; // at or below
        const above = sorted.length - atOrBelow;                      // strictly above
        if (atOrBelow === 0) {
          percentileLabel.textContent = `您的目標價比所有成交價都低`;
        } else if (above === 0) {
          percentileLabel.textContent = `您的目標價比所有成交價都高`;
        } else if (below >= sorted.length / 2) {
          // More than half the prices are below → target is above median
          // "比 N% 的成交價高": N = % strictly below
          const pct = Math.round((below / sorted.length) * 100);
          percentileLabel.textContent = `比 ${pct}% 的成交價高`;
        } else {
          // Less than half the prices are below → target is below median
          // "比 N% 的成交價低": N = % strictly above
          const pct = Math.round((above / sorted.length) * 100);
          percentileLabel.textContent = `比 ${pct}% 的成交價低`;
        }
      } else {
        percentileLabel.textContent = "";
      }
    }
  }


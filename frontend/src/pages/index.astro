    if (Chart) return;
    // @ts-ignore — CDN ESM import, no type declarations needed
    const mod = await import("https://cdn.jsdelivr.net/npm/chart.js@4.4.0/auto/+esm");
    Chart = mod.default;
  }

  // ── Monthly price-per-ping trend chart (issue #131) ───────────────────────
  // Stores latest trend data so the 每坪/總價 toggle can re-render without a new event.
  let _lastPriceTrend: any = null;
  let _priceTrendMode: "perPing" | "total" = "perPing";
  let _priceTrendSeq = 0; // stale-render guard

  async function renderPriceTrendChart(): Promise<void> {
    const seq = ++_priceTrendSeq;
    const trend = _lastPriceTrend;
    const mode = _priceTrendMode; // capture before any await
    if (!trend) return;

    await ensureChart();
    if (seq !== _priceTrendSeq) return; // superseded by a later call

    const canvas      = document.getElementById("trend-chart")      as HTMLCanvasElement | null;
    const insuffEl    = document.getElementById("trend-insufficient") as HTMLElement | null;
    const noteEl      = document.getElementById("trend-note")         as HTMLElement | null;
    const yoyEl       = document.getElementById("trend-yoy")          as HTMLElement | null;

    if (!canvas) return;

    const { points, ma3, ma3Total, yoyPercentage, yoyTotalPercentage, sufficient } = trend;

    if (!sufficient || points.length < 6) {
      canvas.style.display = "none";
      if (insuffEl) insuffEl.style.display = "block";
      if (noteEl)   noteEl.textContent = "";
      if (yoyEl) { yoyEl.style.display = "none"; yoyEl.textContent = ""; }
      if (trendChartInstance) { trendChartInstance.destroy(); trendChartInstance = null; }
      return;
    }

    if (insuffEl) insuffEl.style.display = "none";
    canvas.style.display = "block";

    const isPerPing = mode === "perPing";
    const labels: string[] = points.map((pt: any) => pt.month);

    // Primary series: medianPerPing in 萬/坪 or medianTotalWan in 萬 (null → skip)
    const primaryData: (number | null)[] = points.map((pt: any) => {
      if (isPerPing) return Math.round(pt.medianPerPing / 10000);
      return pt.medianTotalWan !== null ? Math.round(pt.medianTotalWan) : null;
    });

    // MA3 series — use pre-computed ma3/ma3Total from priceTrendUtils (no duplicated logic)
    const ma3Data: (number | null)[] = isPerPing
      ? ma3.map((v: number | null) => (v === null ? null : Math.round(v / 10000)))
      : (ma3Total as (number | null)[]).map((v: number | null) =>
          v === null ? null : Math.round(v)
        );

    const unit = isPerPing ? "萬/坪" : "萬";
    // Active YoY: use the mode-matching field so the annotation is always consistent
    const activeYoY: number | null = isPerPing ? yoyPercentage : yoyTotalPercentage;

    if (trendChartInstance) {
      trendChartInstance.destroy();
      trendChartInstance = null;
    }

    // On mobile, make chart scrollable by using a wider virtual width
    const isMobile = window.innerWidth <= 480;
    if (isMobile) {
      canvas.style.width  = `${Math.max(260, labels.length * 22)}px`;
      canvas.width        = Math.max(260, labels.length * 22);
      canvas.style.height = "140px";
      canvas.height       = 140;
    } else {
      canvas.style.width  = "260px";
      canvas.width        = 260;
      canvas.style.height = "160px";
      canvas.height       = 160;
    }

    // Highlight last non-null point
    const lastNonNullIdx = primaryData.reduceRight((acc: number, v, i) => (acc === -1 && v !== null ? i : acc), -1);
    const pointRadius = primaryData.map((_: any, i: number) => (i === lastNonNullIdx ? 6 : 3));
    const pointBgColor = primaryData.map((_: any, i: number) => (i === lastNonNullIdx ? "#ef4444" : "#2563eb"));

    trendChartInstance = new Chart(canvas, {
      type: "line",
      data: {
        labels,
        datasets: [
          {
            label: `中位數${isPerPing ? "單價" : "總價"} (${unit})`,
            data: primaryData,
            borderColor: "#2563eb",
            backgroundColor: "rgba(37,99,235,0.08)",
            tension: 0.3,
            pointRadius,
            pointBackgroundColor: pointBgColor,
            fill: true,
            order: 1,
            spanGaps: false,
          },
          {
            label: `MA3 (${unit})`,
            data: ma3Data,
            borderColor: "#f59e0b",
            borderWidth: 2,
            borderDash: [4, 4],
            pointRadius: 0,
            fill: false,
            tension: 0.3,
            order: 0,
            spanGaps: false,
          },
        ],
      },
      options: {
        responsive: false,
        plugins: {
          legend: {
            display: true,
            position: "top" as const,
            labels: { font: { size: 10 }, boxWidth: 20, padding: 6 },
          },
          tooltip: {
            callbacks: {
              label: (ctx: any) => {
                if (ctx.parsed.y === null || ctx.parsed.y === undefined) return "";
                return `${ctx.dataset.label}: ${ctx.parsed.y} ${unit}`;
              },
            },
          },
        },
        scales: {
          y: {
            beginAtZero: false,
            ticks: {
              callback: (v: any) => `${v}萬`,
              font: { size: 10 },
            },
          },
          x: {
            ticks: { font: { size: 10 }, maxRotation: 45 },
          },
        },
      },
    });

    if (noteEl) {
      noteEl.textContent = `月均${isPerPing ? "單價" : "總價"}走勢（共 ${points.length} 個月，含 MA3）`;
    }

    // YoY annotation — always reflects the currently-displayed mode
    if (yoyEl && activeYoY !== null) {
      const sign = activeYoY > 0 ? "+" : "";
      yoyEl.textContent = `同期比 ${sign}${activeYoY.toFixed(1)}%`;
      yoyEl.className = `trend-yoy ${activeYoY > 1 ? "positive" : activeYoY < -1 ? "negative" : "neutral"}`;
      yoyEl.style.display = "block";
    } else if (yoyEl) {
      yoyEl.style.display = "none";
    }
  }

  document.addEventListener("district-volume-yoy", async (e: Event) => {
    const seq = ++volumeYoYRenderSeq;
    const { district, referenceYear, volumeYoY } = (e as CustomEvent).detail as {
      district: string;
      referenceYear: number;
      volumeYoY: Array<{
        quarter: string;
        currentYear: number;
        priorYear: number;
        yoyPct: number | null;
        insufficientCurrent: boolean;
        insufficientPrior: boolean;
      }>;
    };

    const panel      = document.getElementById("volume-yoy-panel")       as HTMLDivElement    | null;
    const distLabel  = document.getElementById("volume-yoy-district-label") as HTMLSpanElement | null;
    const badge      = document.getElementById("volume-yoy-badge")        as HTMLDivElement    | null;
    const insuffEl   = document.getElementById("volume-yoy-insufficient") as HTMLDivElement    | null;
    const canvas     = document.getElementById("volume-yoy-chart")        as HTMLCanvasElement | null;
    const deltaEl    = document.getElementById("volume-yoy-delta-labels") as HTMLDivElement    | null;
    if (!panel || !canvas) return;

    if (distLabel) distLabel.textContent = district ? ` — ${district}` : "";
    panel.style.display = "block";

    const priorYear = referenceYear - 1;

    // ── YTD summary badge (only quarters up to current month to avoid mid-year bias) ──
    const currentMonth = new Date().getMonth() + 1; // 1–12
    const ytd = computeYTDSummary(volumeYoY, currentMonth);
    if (badge) {
      if (ytd.ytdYoYPct !== null) {
        const arrow = ytd.ytdYoYPct >= 0 ? "↑" : "↓";
        const absStr = formatYoYPct(Math.abs(ytd.ytdYoYPct)).replace("+", "").replace("-", "");
        badge.textContent = `今年成交量 ${arrow} ${absStr} 同期`;
        badge.className = `volume-yoy-badge ${ytd.ytdYoYPct < 0 ? "badge-down" : "badge-up"}`;
        badge.style.display = "block";
      } else {
        badge.style.display = "none";
      }
    }

    // Check if all quarters have insufficient data for both years
    const hasAnyData = volumeYoY.some((v) => v.currentYear > 0 || v.priorYear > 0);
    if (!hasAnyData) {
      if (insuffEl) insuffEl.style.display = "block";
      canvas.style.display = "none";
      if (deltaEl) deltaEl.innerHTML = "";
      return;
    }
    if (insuffEl) insuffEl.style.display = "none";
    canvas.style.display = "block";

    await ensureChart();
    if (seq !== volumeYoYRenderSeq) return; // stale — newer district click already in progress

    // Destroy any previous chart instance
    const existingChart = (canvas as any)._volumeYoYChart;
    if (existingChart) { existingChart.destroy(); (canvas as any)._volumeYoYChart = null; }

    const BRAND_COLOR  = "rgba(37,99,235,0.8)";
    const PRIOR_COLOR  = "rgba(148,163,184,0.65)";
    const BRAND_BORDER = "rgba(37,99,235,1)";
    const PRIOR_BORDER = "rgba(148,163,184,1)";

    const isMobile = window.innerWidth <= 480;
    if (isMobile) {
      canvas.width  = 240;
      canvas.height = 140;
    } else {
      canvas.width  = 260;
      canvas.height = 160;
    }

    const chart = new Chart(canvas, {
      type: "bar",
      data: {
        labels: volumeYoY.map((v) => v.quarter),
        datasets: [
          {
            label: String(referenceYear),
            data: volumeYoY.map((v) => v.currentYear),
            backgroundColor: BRAND_COLOR,
            borderColor: BRAND_BORDER,
            borderWidth: 1,
            borderRadius: 3,
          },
          {
            label: String(priorYear),
            data: volumeYoY.map((v) => v.priorYear),
            backgroundColor: PRIOR_COLOR,
            borderColor: PRIOR_BORDER,
            borderWidth: 1,
            borderRadius: 3,
          },
        ],
      },
      options: {
        responsive: false,
        animation: { duration: 200 },
        plugins: {
          legend: {
            display: true,
            position: "top" as const,
            labels: { font: { size: 10 }, boxWidth: 10, padding: 8 },
          },
          tooltip: {
            callbacks: {
              label: (ctx: any) => {
                const val = ctx.parsed.y as number;
                const qData = volumeYoY[ctx.dataIndex];
                if (!qData) return `${ctx.dataset.label}: ${val} 件`;
                const isCurrentYear = ctx.datasetIndex === 0;
                const insuf = isCurrentYear ? qData.insufficientCurrent : qData.insufficientPrior;
                return `${ctx.dataset.label}: ${val} 件${insuf ? " ⚠資料不足" : ""}`;
              },
            },
          },
        },
        scales: {
          x: { ticks: { font: { size: 10 } } },
          y: {
            beginAtZero: true,
            ticks: { font: { size: 10 }, maxTicksLimit: 5, stepSize: 1 },
          },
        },
      },
    });
    (canvas as any)._volumeYoYChart = chart;

    // ── Per-quarter delta labels (HTML-escaped, no XSS) ──
    if (deltaEl) {
      type EscChar = "&" | "<" | ">" | '"' | "'";
      const escMap: Record<EscChar, string> = {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"};
      const escHtml = (s: string) => s.replace(/[&<>"']/g, (c) => escMap[c as EscChar]!);
      deltaEl.innerHTML = volumeYoY.map((v) => {
        const qLabel = escHtml(v.quarter);
        // Show "資料不足" for insufficient current-year quarter (< 4 transactions)
        if (v.insufficientCurrent) {
          return `<span class="delta-na" title="${qLabel}: 資料不足">${qLabel}: 資料不足</span>`;
        }
        if (v.yoyPct === null) {
          return `<span class="delta-na" title="${qLabel}: 無去年資料">${qLabel}: —</span>`;
        }
        const sign    = v.yoyPct >= 0 ? "+" : "-";
        const abs     = Math.abs(v.yoyPct);
        const absStr  = Number.isInteger(abs) ? String(abs) : abs.toFixed(1);
        const pctStr  = escHtml(`${sign}${absStr}%`);
        const cls     = v.yoyPct < 0 ? "delta-down" : "delta-up";
        // Append * indicator when prior-year data is also insufficient
        const insuffSuffix = v.insufficientPrior ? " *" : "";
        return `<span class="${cls}" title="${qLabel}: ${pctStr}${v.insufficientPrior ? " (去年資料不足)" : ""}">${qLabel}: ${pctStr}${insuffSuffix}</span>`;
      }).join("");
    }
  });

  document.addEventListener("district-price-trend", async (e: Event) => {
    const { priceTrend } = (e as CustomEvent).detail as { priceTrend: any };
    _lastPriceTrend = priceTrend;

    const panel = document.getElementById("trend-panel") as HTMLDivElement | null;
    const title = document.getElementById("trend-title") as HTMLHeadingElement | null;
    if (panel) panel.style.display = "block";
    if (title) title.textContent = `${priceTrend.district} — 每月價格走勢`;

    await renderPriceTrendChart();

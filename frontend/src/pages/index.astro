        <select id="wizard-hub-select" class="wizard-select" aria-label="主要通勤目的地">
          <optgroup label="🏙 台北市">
            <option value="taipei-main">台北車站</option>
            <option value="xinyi">信義區</option>
            <option value="zhongshan">中山站</option>

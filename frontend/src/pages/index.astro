      district: string;
      city: string;
      allProfiles: any[];
      mrtTierMap?: Record<string, { tier: string; noMrt: boolean }>;
    };
    renderSmartAlternatives(seq, raw.district, raw.city, raw.allProfiles ?? [], raw.mrtTierMap ?? {})
